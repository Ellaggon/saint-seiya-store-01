RESEND_API_KEY=
SITE_URL=
PUBLIC_SITE_URL=

# Supabase project API.
# Server-side code can use SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY.
# Browser code must use PUBLIC_* aliases; do not expose SUPABASE_SECRET_KEY.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy/fallback names. Keep empty unless a deployment still depends on them.
SUPABASE_ANON_KEY=
PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Prisma Client runtime connection.
# Supabase transaction pooler format for serverless runtime:
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Prisma CLI/migrations connection.
# Preferred Supabase direct format when network supports it:
# postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Session pooler fallback for CLI/migrations:
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Internal cron authorization. Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_BUCKET=
R2_PUBLIC_URL=
