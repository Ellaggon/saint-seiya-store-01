---
import MainLayout from "@/ui/layouts/MainLayout.astro";
import {
  orderInclude,
  serializeOrder,
} from "@/application/orders/serializeOrder";
import {
  canCustomerPayOrder,
  orderStatusClass,
  orderStatusLabel,
} from "@/application/orders/orderStatus";
import { formatPrice } from "@/lib/utils";
import { prisma } from "@/infrastructure/database/prisma";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(
    "/login?returnTo=" + encodeURIComponent(Astro.url.pathname),
  );
}

const { id } = Astro.params;
if (!id) return Astro.redirect("/account/orders");

const orderRow = await prisma.order.findUnique({
  where: { id },
  include: orderInclude,
});

if (!orderRow || orderRow.userId !== user.id) {
  return new Response("Pedido no encontrado", { status: 404 });
}

const order = serializeOrder(orderRow);
---

<MainLayout title={`Pedido ${order.referenceCode}`}>
  <main class="mx-auto min-h-screen max-w-[720px] px-6 py-16 md:py-24">
    <div class="mb-8 space-y-3">
      <a
        href="/account/orders"
        class="text-[10px] font-black uppercase tracking-widest text-zinc-500 hover:text-amber-500"
      >
        ← Mis pedidos
      </a>
      <h1 class="text-3xl font-black uppercase tracking-tighter text-white sm:text-4xl">
        {order.referenceCode}
      </h1>
      <p class={`text-sm font-black uppercase tracking-widest ${orderStatusClass(order.status)}`}>
        {orderStatusLabel(order.status)}
      </p>
      <div class="h-1 w-12 bg-amber-500"></div>
    </div>

    <div class="space-y-5">
      <section class="border border-zinc-900 bg-zinc-950 px-5 py-6">
        <p class="text-[10px] font-black uppercase tracking-[0.24em] text-amber-500">
          Productos
        </p>
        <ul class="mt-4 space-y-3">
          {
            order.items.map((item) => (
              <li class="flex justify-between gap-3 text-[11px] uppercase tracking-widest text-zinc-500">
                <span>
                  {item.quantity}× {item.name}
                </span>
                <span class="text-white">
                  {formatPrice(item.price * item.quantity)}
                </span>
              </li>
            ))
          }
        </ul>
        <div class="mt-4 flex justify-between border-t border-zinc-900 pt-4">
          <span class="text-[10px] font-black uppercase tracking-widest text-zinc-600">
            Total
          </span>
          <span class="text-lg font-black text-white">
            {formatPrice(order.totalAmount)}
          </span>
        </div>
      </section>

      <section class="border border-zinc-900 bg-zinc-950 px-5 py-6">
        <p class="text-[10px] font-black uppercase tracking-[0.24em] text-amber-500">
          Entrega
        </p>
        <dl class="mt-4 space-y-2 text-sm text-zinc-400">
          <div>
            <span class="text-zinc-600">Nombre: </span>
            {order.customerName || "—"}
          </div>
          <div>
            <span class="text-zinc-600">Ciudad: </span>
            {order.customerCity || "—"}
          </div>
          <div>
            <span class="text-zinc-600">Tracking: </span>
            {order.shippingTrackerId || "Pendiente"}
          </div>
        </dl>
      </section>

      {
        canCustomerPayOrder(order.status) && (
          <a
            href={`/orders/${order.id}/pay`}
            class="inline-flex w-full min-h-12 items-center justify-center bg-amber-500 px-6 py-3.5 text-[11px] font-black uppercase tracking-widest text-black transition-colors hover:bg-white"
          >
            Completar pago QR
          </a>
        )
      }
    </div>
  </main>
</MainLayout>
