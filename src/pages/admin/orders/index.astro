---
import MainLayout from "@/ui/layouts/MainLayout.astro";
import { serializeOrder } from "@/application/orders/serializeOrder";
import {
  orderStatusClass,
  orderStatusLabel,
} from "@/application/orders/orderStatus";
import { listAdminOrders } from "@/application/orders/adminOrderQueries";
import { formatPrice } from "@/lib/utils";

const user = Astro.locals.user;
if (!user || user.role !== "ADMIN") {
  return Astro.redirect("/login");
}

const statusFilter = Astro.url.searchParams.get("status") ?? "ALL";
const q = Astro.url.searchParams.get("q")?.trim() ?? "";

const orders = await listAdminOrders({
  status: statusFilter === "ALL" ? undefined : statusFilter as any,
  q,
});

const serialized = orders.map((order) => serializeOrder(order));

const filters = [
  { value: "ALL", label: "Todos" },
  { value: "PAYMENT_REVIEW", label: "En revisión" },
  { value: "AWAITING_PAYMENT", label: "Esperando pago" },
  { value: "PAID", label: "Pagados" },
  { value: "SHIPPED", label: "Enviados" },
  { value: "DELIVERED", label: "Entregados" },
  { value: "CANCELED", label: "Cancelados" },
  { value: "PENDING", label: "Legacy WhatsApp" },
];

const formatDate = (value: string) =>
  new Date(value).toLocaleDateString("es-BO", {
    year: "numeric",
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
---

<MainLayout title="Admin - Pedidos">
  <div class="mx-auto max-w-[1200px] px-6 py-12">
    <div class="mb-10 space-y-2">
      <p class="text-[10px] font-black uppercase tracking-[0.4em] text-amber-500">
        Panel de Control
      </p>
      <h1 class="text-4xl font-black uppercase tracking-tighter text-white">
        Pedidos
      </h1>
      <p class="max-w-xl text-sm text-zinc-500">
        Cola de pagos QR, comprobantes y despacho.
      </p>
      <div class="h-1 w-12 bg-amber-500"></div>
    </div>

    <form method="GET" class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end">
      <label class="block flex-1 space-y-2">
        <span class="text-[10px] font-black uppercase tracking-widest text-zinc-600">
          Buscar
        </span>
        <input
          type="search"
          name="q"
          value={q}
          placeholder="Referencia, nombre, teléfono…"
          class="w-full border border-zinc-800 bg-black px-4 py-3 text-sm text-white outline-none focus:border-amber-500"
        />
      </label>
      <label class="block space-y-2 sm:w-56">
        <span class="text-[10px] font-black uppercase tracking-widest text-zinc-600">
          Estado
        </span>
        <select
          name="status"
          class="w-full border border-zinc-800 bg-black px-4 py-3 text-sm text-white outline-none focus:border-amber-500"
        >
          {
            filters.map((f) => (
              <option value={f.value} selected={f.value === statusFilter}>
                {f.label}
              </option>
            ))
          }
        </select>
      </label>
      <button
        type="submit"
        class="bg-white px-6 py-3 text-[11px] font-black uppercase tracking-widest text-black hover:bg-amber-500"
      >
        Filtrar
      </button>
    </form>

    <div class="overflow-x-auto border border-zinc-900 bg-zinc-950">
      <table class="w-full min-w-[960px] border-collapse text-left">
        <thead class="border-b border-zinc-900 bg-black">
          <tr>
            <th class="px-5 py-4 text-[10px] font-black uppercase tracking-widest text-amber-500">
              Pedido
            </th>
            <th class="px-5 py-4 text-[10px] font-black uppercase tracking-widest text-amber-500">
              Cliente
            </th>
            <th class="px-5 py-4 text-[10px] font-black uppercase tracking-widest text-amber-500">
              Total
            </th>
            <th class="px-5 py-4 text-[10px] font-black uppercase tracking-widest text-amber-500">
              Método
            </th>
            <th class="px-5 py-4 text-[10px] font-black uppercase tracking-widest text-amber-500">
              Estado
            </th>
            <th class="px-5 py-4 text-[10px] font-black uppercase tracking-widest text-amber-500">
              Fecha
            </th>
            <th class="px-5 py-4 text-right text-[10px] font-black uppercase tracking-widest text-amber-500">
              Acción
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-900">
          {
            serialized.length === 0 ? (
              <tr>
                <td
                  colspan="7"
                  class="px-5 py-12 text-center text-xs uppercase tracking-widest text-zinc-500"
                >
                  No hay pedidos con estos filtros.
                </td>
              </tr>
            ) : (
              serialized.map((order) => (
                <tr class="transition-colors hover:bg-zinc-900/40">
                  <td class="px-5 py-4">
                    <p class="text-sm font-black uppercase tracking-tight text-white">
                      {order.referenceCode}
                    </p>
                    {order.payment?.status === "UNDER_REVIEW" && (
                      <span class="mt-1 inline-block text-[9px] font-black uppercase tracking-widest text-sky-400">
                        Comprobante pendiente
                      </span>
                    )}
                  </td>
                  <td class="px-5 py-4">
                    <p class="text-xs font-bold uppercase tracking-tight text-white">
                      {order.customerName || order.user?.name || "—"}
                    </p>
                    <p class="mt-1 text-[10px] uppercase tracking-widest text-zinc-600">
                      {order.customerPhone || order.user?.email || "Sin contacto"}
                    </p>
                  </td>
                  <td class="px-5 py-4 text-sm font-black text-white">
                    {formatPrice(order.totalAmount)}
                  </td>
                  <td class="px-5 py-4 text-[10px] font-black uppercase tracking-widest text-zinc-500">
                    {order.paymentMethod === "QR_BANK" ? "QR" : "WhatsApp"}
                  </td>
                  <td class="px-5 py-4">
                    <span
                      class={`text-[10px] font-black uppercase tracking-widest ${orderStatusClass(order.status)}`}
                    >
                      {orderStatusLabel(order.status)}
                    </span>
                  </td>
                  <td class="px-5 py-4 text-[10px] font-bold text-zinc-600">
                    {formatDate(order.createdAt)}
                  </td>
                  <td class="px-5 py-4 text-right">
                    <a
                      href={`/admin/orders/${order.id}`}
                      class="text-[10px] font-black uppercase tracking-widest text-amber-500 hover:text-white"
                    >
                      Ver →
                    </a>
                  </td>
                </tr>
              ))
            )
          }
        </tbody>
      </table>
    </div>
  </div>
</MainLayout>
