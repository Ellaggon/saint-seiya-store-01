---
import MainLayout from "@/ui/layouts/MainLayout.astro";
import AdminPreorderForm from "@/ui/components/admin/preorders/AdminPreorderForm.astro";
import { ApplicationError } from "@/application/errors/ApplicationError";
import { getCachedAdminPreorderDetail } from "@/application/services/AdminQueryCache";
import { createGetPreorderDetailUseCase } from "@/infrastructure/preorders/PreorderUseCaseFactory";
import { toEditableProductOption } from "@/ui/pages/admin/preorders/adminPreorderApi";

const user = Astro.locals.user;
if (!user || user.role !== "ADMIN") {
  return Astro.redirect("/login");
}

const id = Astro.params.id;
if (!id) {
  return Astro.redirect("/admin/preorders");
}

const error = Astro.url.searchParams.get("error");
const saved = Astro.url.searchParams.get("saved") === "1";

let preorder;
try {
  const getPreorderDetail = createGetPreorderDetailUseCase();
  preorder = await getCachedAdminPreorderDetail(id, () =>
    getPreorderDetail.execute({ id }),
  );
} catch (requestError) {
  const appError = ApplicationError.normalizeUnknownError(requestError);
  if (appError.code === "INVALID_PREORDER_STATE") {
    return Astro.redirect("/admin/preorders");
  }
  throw appError;
}

const products = [toEditableProductOption(preorder.product)];
---

<MainLayout title={`Admin - ${preorder.product.name}`}>
  <AdminPreorderForm
    products={products}
    preorder={preorder}
    error={error}
    saved={saved}
  />
</MainLayout>
