---
import ProductForm from "@/ui/pages/admin/ProductForm.astro";
import { getCachedAdminProductDetail } from "@/application/services/AdminQueryCache";
import { PrismaProductRepository } from "@/infrastructure/database/PrismaProductRepository";
import { GetAdminProductUseCase } from "@/application/use-cases/admin/products/GetAdminProductUseCase";
import { loadAdminProductFormOptions } from "@/ui/pages/admin/loadAdminProductFormOptions";

const user = Astro.locals.user;
if (!user || user.role !== "ADMIN") {
  return Astro.redirect("/login");
}

const { id } = Astro.params;
const productRepository = new PrismaProductRepository();
const getProduct = new GetAdminProductUseCase(productRepository);

const [product, formOptions] = await Promise.all([
  id
    ? getCachedAdminProductDetail(id, () => getProduct.execute(id))
    : Promise.resolve(null),
  loadAdminProductFormOptions(productRepository),
]);

if (!product || product.deletedAt) {
  return Astro.redirect("/admin/products");
}
---

<ProductForm
  product={product}
  categories={formOptions.categories}
  collections={formOptions.collections}
  isEditing={true}
/>
