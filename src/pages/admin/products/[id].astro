---
import ProductForm from "@/ui/pages/admin/ProductForm.astro";
import { PrismaProductRepository } from "@/infrastructure/database/PrismaProductRepository";
import { GetAdminProductUseCase } from "@/application/use-cases/admin/products/GetAdminProductUseCase";

// Protect route
const user = Astro.locals.user;
if (!user || user.role !== "ADMIN") {
  return Astro.redirect("/login");
}

const { id } = Astro.params;

const productRepository = new PrismaProductRepository();
const getProduct = new GetAdminProductUseCase(productRepository);
const product = id ? await getProduct.execute(id) : null;

if (!product || product.deletedAt) {
  return Astro.redirect("/admin/products");
}

const categoriesResponse = await fetch(
  new URL("/api/categories", Astro.url.origin),
);
const categories = await categoriesResponse.json();

const collectionsResponse = await fetch(
  new URL("/api/collections", Astro.url.origin),
);
const collections = await collectionsResponse.json();
---

<ProductForm
  product={product}
  categories={categories}
  collections={collections}
  isEditing={true}
/>
