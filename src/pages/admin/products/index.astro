---
import ProductList from "@/ui/pages/admin/ProductList.astro";
import { PrismaProductRepository } from "@/infrastructure/database/PrismaProductRepository";
import { ListAdminProductsUseCase } from "@/application/use-cases/admin/products/ListAdminProductsUseCase";

// Protect route (middleware should handle this, but for safety inside the template too)
const user = Astro.locals.user;
if (!user || user.role !== "ADMIN") {
  return Astro.redirect("/login");
}

const productRepository = new PrismaProductRepository();
const listProducts = new ListAdminProductsUseCase(productRepository);
const products = await listProducts.execute();
---

<ProductList products={products} />
