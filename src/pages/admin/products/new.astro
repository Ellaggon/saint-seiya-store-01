---
import ProductForm from "@/ui/pages/admin/ProductForm.astro";
import { PrismaProductRepository } from "@/infrastructure/database/PrismaProductRepository";
import { loadAdminProductFormOptions } from "@/ui/pages/admin/loadAdminProductFormOptions";

const user = Astro.locals.user;
if (!user || user.role !== "ADMIN") {
  return Astro.redirect("/login");
}

const productRepository = new PrismaProductRepository();
const formOptions = await loadAdminProductFormOptions(productRepository);
const returnTo = Astro.url.searchParams.get("returnTo") || "/admin/products";
---

<ProductForm
  categories={formOptions.categories}
  collections={formOptions.collections}
  returnTo={returnTo}
/>
