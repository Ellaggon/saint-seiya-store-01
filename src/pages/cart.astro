---
import MainLayout from "@/ui/layouts/MainLayout.astro";
import { getStoreSettings } from "@/application/services/StoreSettingsService";
import {
  isWhatsAppConfigured,
  storeMessengerUrl,
} from "@/lib/storeContact";

const storeSettings = await getStoreSettings();
const cartWhatsApp = storeSettings.cartWhatsApp;
const whatsappReady = isWhatsAppConfigured(cartWhatsApp);
const messengerUrl = storeMessengerUrl;
---

<MainLayout title="Carrito">
  <div class="mx-auto max-w-[900px] overflow-x-hidden px-4 py-10 sm:px-6 md:py-24">
    <div class="mb-8 flex flex-col gap-4 sm:mb-10 sm:flex-row sm:items-end sm:justify-between sm:gap-6">
      <div class="space-y-3">
        <p class="text-[10px] font-black uppercase tracking-[0.35em] text-amber-500">
          Sanctuary
        </p>
        <h1 class="text-3xl font-black uppercase tracking-tighter text-white sm:text-4xl md:text-5xl">
          Carrito
        </h1>
        <div class="h-1 w-12 bg-amber-500"></div>
      </div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 sm:flex-col sm:items-end sm:gap-2">
        <a
          href="/catalog"
          class="text-[11px] font-black uppercase tracking-widest text-zinc-500 transition-colors hover:text-amber-500"
        >
          Seguir comprando →
        </a>
        <a
          href="/account/orders"
          class="text-[11px] font-black uppercase tracking-widest text-zinc-600 transition-colors hover:text-amber-500"
        >
          Mis pedidos
        </a>
      </div>
    </div>

    <div
      id="cart-banner"
      class="mb-6 hidden border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-[11px] font-black uppercase tracking-widest text-amber-400"
      role="status"
      aria-live="polite"
    >
    </div>

    <div
      id="cart-empty"
      class="hidden border border-zinc-900 bg-zinc-950 px-5 py-12 text-center sm:px-6 sm:py-14"
    >
      <p class="text-sm font-black uppercase tracking-[0.2em] text-zinc-500">
        Tu carrito está vacío
      </p>
      <a
        href="/catalog"
        class="mt-6 inline-flex border border-amber-500/60 px-6 py-3 text-[11px] font-black uppercase tracking-widest text-amber-500 transition-colors hover:bg-amber-500 hover:text-black"
      >
        Explorar catálogo
      </a>
    </div>

    <div id="cart-content" class="hidden space-y-5 sm:space-y-6">
      <div class="flex items-center justify-end">
        <button
          type="button"
          id="cart-clear"
          class="min-h-10 px-1 text-[10px] font-black uppercase tracking-widest text-zinc-500 transition-colors hover:text-red-400"
        >
          Vaciar carrito
        </button>
      </div>

      <ul id="cart-items" class="divide-y divide-zinc-900 overflow-hidden border border-zinc-900 bg-zinc-950">
      </ul>

      <div
        class="sticky bottom-0 z-20 -mx-4 border-t border-zinc-900 bg-black/95 px-4 py-4 backdrop-blur-md sm:static sm:mx-0 sm:border sm:border-zinc-900 sm:bg-black sm:px-5 sm:py-5 sm:backdrop-blur-none"
      >
        <div class="flex flex-col gap-4">
          <div class="flex items-end justify-between gap-4">
            <div class="min-w-0">
              <p class="text-[10px] font-black uppercase tracking-[0.24em] text-zinc-600">
                Total
              </p>
              <p id="cart-total" class="mt-1 text-2xl font-black text-white">Bs 0</p>
              <p
                id="cart-checkout-hint"
                class="mt-2 hidden text-[10px] uppercase tracking-widest text-red-400"
              >
                Corrige los productos no disponibles para continuar
              </p>
            </div>
          </div>
          <div class="flex w-full flex-col gap-3">
            <a
              id="cart-checkout"
              href="/checkout"
              class="inline-flex w-full min-h-12 items-center justify-center bg-amber-500 px-6 py-3.5 text-[11px] font-black uppercase tracking-widest text-black transition-colors hover:bg-white sm:w-auto sm:self-end sm:px-8 sm:py-4"
            >
              Continuar al pago
            </a>
            {
              whatsappReady ? (
                <button
                  type="button"
                  id="cart-whatsapp-support"
                  data-whatsapp-number={cartWhatsApp}
                  class="inline-flex w-full min-h-11 items-center justify-center gap-2 border border-[#25D366]/40 px-6 py-3 text-[10px] font-black uppercase tracking-widest text-[#25D366] transition-colors hover:bg-[#25D366] hover:text-black sm:w-auto sm:self-end"
                >
                  ¿Dudas? Escribir por WhatsApp
                </button>
              ) : null
            }
            {
              messengerUrl && (
                <a
                  id="cart-checkout-messenger"
                  href={messengerUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-center text-[10px] font-black uppercase tracking-widest text-zinc-500 transition-colors hover:text-[#0084FF] sm:text-right"
                >
                  O escribir por Messenger →
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import {
    CART_UPDATED_EVENT,
    cartHasBlockingIssues,
    clearCart,
    getCartItemCount,
    getItemMaxQuantity,
    readCart,
    removeItem,
    setItemQuantity,
    syncCartBadge,
    validateCartWithServer,
    type CartLineView,
  } from "@/ui/scripts/cart";
  import {
    buildWhatsAppUrl,
    isWhatsAppConfigured,
  } from "@/lib/storeContact";

  let lineViews: CartLineView[] = [];
  let validating = false;
  let skipNextEventRender = false;

  const formatBob = (value: number): string =>
    `Bs ${value.toLocaleString("es-BO", {
      minimumFractionDigits: 0,
      maximumFractionDigits: 2,
    })}`;

  const escapeHtml = (value: string): string =>
    value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");

  const issueMessage = (line: CartLineView): string | null => {
    if (line.issue === "not_found") return "Producto no encontrado";
    if (line.issue === "out_of_stock") return "Agotado";
    if (line.issue === "unavailable") {
      return line.availabilityLabel || "No disponible";
    }
    if (line.issue === "qty_exceeds") {
      return `Stock limitado: máximo ${line.stock}`;
    }
    if (line.priceChanged) return "Precio actualizado";
    return null;
  };

  const setBanner = (message: string | null, tone: "amber" | "red" = "amber") => {
    const banner = document.getElementById("cart-banner");
    if (!banner) return;
    if (!message) {
      banner.classList.add("hidden");
      banner.textContent = "";
      return;
    }
    banner.textContent = message;
    banner.classList.remove("hidden");
    banner.classList.toggle("border-amber-500/40", tone === "amber");
    banner.classList.toggle("bg-amber-500/10", tone === "amber");
    banner.classList.toggle("text-amber-400", tone === "amber");
    banner.classList.toggle("border-red-500/40", tone === "red");
    banner.classList.toggle("bg-red-500/10", tone === "red");
    banner.classList.toggle("text-red-400", tone === "red");
  };

  const syncCheckoutState = () => {
    const checkout = document.getElementById(
      "cart-checkout",
    ) as HTMLAnchorElement | null;
    const hint = document.getElementById("cart-checkout-hint");
    const blocked =
      lineViews.length === 0 || cartHasBlockingIssues(lineViews);
    if (checkout) {
      if (blocked) {
        checkout.setAttribute("aria-disabled", "true");
        checkout.classList.add(
          "pointer-events-none",
          "bg-zinc-800",
          "text-zinc-500",
        );
        checkout.classList.remove("bg-amber-500", "text-black");
      } else {
        checkout.removeAttribute("aria-disabled");
        checkout.classList.remove(
          "pointer-events-none",
          "bg-zinc-800",
          "text-zinc-500",
        );
        checkout.classList.add("bg-amber-500", "text-black");
      }
    }
    if (hint) {
      hint.classList.toggle(
        "hidden",
        !cartHasBlockingIssues(lineViews) || lineViews.length === 0,
      );
    }
  };

  const renderCart = (lines?: CartLineView[]) => {
    const items = readCart();
    const empty = document.getElementById("cart-empty");
    const content = document.getElementById("cart-content");
    const list = document.getElementById("cart-items");
    const totalEl = document.getElementById("cart-total");
    if (!empty || !content || !list || !totalEl) return;

    syncCartBadge();

    if (lines) {
      lineViews = lines;
    } else if (lineViews.length === 0 || lineViews.length !== items.length) {
      lineViews = items.map((item) => ({
        ...item,
        canPurchase: getItemMaxQuantity(item) > 0,
        availabilityLabel: "Disponible",
        issue: null,
        priceChanged: false,
      }));
    } else {
      lineViews = items.map((item) => {
        const prev = lineViews.find((line) => line.productId === item.productId);
        const max = getItemMaxQuantity(item);
        let issue = prev?.issue ?? null;
        if (issue === "qty_exceeds" && item.quantity <= max) {
          issue = null;
        }
        return {
          ...item,
          canPurchase: prev?.canPurchase ?? max > 0,
          availabilityLabel: prev?.availabilityLabel ?? "Disponible",
          issue,
          priceChanged: prev?.priceChanged ?? false,
        };
      });
    }

    if (items.length === 0) {
      empty.classList.remove("hidden");
      content.classList.add("hidden");
      list.innerHTML = "";
      totalEl.textContent = formatBob(0);
      lineViews = [];
      setBanner(null);
      syncCheckoutState();
      return;
    }

    empty.classList.add("hidden");
    content.classList.remove("hidden");

    const purchasableTotal = lineViews.reduce((sum, line) => {
      if (!line.canPurchase) return sum;
      return sum + line.price * line.quantity;
    }, 0);
    totalEl.textContent = formatBob(purchasableTotal);

    list.innerHTML = lineViews
      .map((item) => {
        const safeName = escapeHtml(item.name);
        const safeId = encodeURIComponent(item.productId);
        const safeImage = escapeHtml(item.imageUrl);
        const max = getItemMaxQuantity(item);
        const atMax = item.quantity >= max || !item.canPurchase;
        const message = issueMessage(item);
        const invalid =
          Boolean(item.issue && item.issue !== "qty_exceeds") ||
          !item.canPurchase;

        return `
      <li class="min-w-0 px-3 py-4 sm:px-5 ${invalid ? "bg-red-950/20" : ""}" data-product-id="${safeId}">
        <div class="flex min-w-0 gap-3 sm:gap-4">
          <div class="h-16 w-16 shrink-0 border border-zinc-800 bg-black p-1 sm:h-[4.5rem] sm:w-[4.5rem] ${invalid ? "opacity-50" : ""}">
            <img src="${safeImage}" alt="" class="h-full w-full object-cover" />
          </div>
          <div class="min-w-0 flex-1 space-y-3">
            <div class="min-w-0">
              <a
                href="/product/${safeId}"
                class="block min-w-0 break-words text-sm font-black uppercase leading-snug tracking-tight text-white hover:text-amber-500 [overflow-wrap:anywhere] line-clamp-2"
              >
                ${safeName}
              </a>
              <p class="mt-1 text-[10px] uppercase tracking-widest text-zinc-500">
                ${formatBob(item.price)} c/u
                ${max > 0 && item.canPurchase ? ` · Stock ${max}` : ""}
              </p>
              ${
                message
                  ? `<p class="mt-2 text-[10px] font-black uppercase tracking-widest ${invalid ? "text-red-400" : "text-amber-400"}">${escapeHtml(message)}</p>`
                  : ""
              }
            </div>

            <div class="flex min-w-0 flex-wrap items-center justify-between gap-3">
              <div class="inline-flex items-center border border-zinc-800" role="group" aria-label="Cantidad de ${safeName}">
                <button
                  type="button"
                  data-cart-action="decrement"
                  data-product-id="${safeId}"
                  class="flex h-10 w-10 items-center justify-center text-base font-black text-zinc-300 transition-colors hover:bg-zinc-900 hover:text-amber-500 disabled:cursor-not-allowed disabled:opacity-30"
                  aria-label="Disminuir cantidad"
                  ${!item.canPurchase ? "disabled" : ""}
                >
                  −
                </button>
                <span class="min-w-[2.75rem] text-center text-xs font-black tabular-nums text-white" aria-live="polite">
                  ${item.quantity}
                </span>
                <button
                  type="button"
                  data-cart-action="increment"
                  data-product-id="${safeId}"
                  class="flex h-10 w-10 items-center justify-center text-base font-black text-zinc-300 transition-colors hover:bg-zinc-900 hover:text-amber-500 disabled:cursor-not-allowed disabled:opacity-30"
                  aria-label="Aumentar cantidad"
                  ${atMax ? "disabled" : ""}
                >
                  +
                </button>
              </div>

              <div class="flex min-w-0 items-center gap-3">
                <p class="text-sm font-black tabular-nums text-white">
                  ${formatBob(item.price * item.quantity)}
                </p>
                <button
                  type="button"
                  data-cart-action="remove"
                  data-product-id="${safeId}"
                  class="inline-flex h-10 min-w-10 items-center justify-center border border-zinc-800 px-3 text-[10px] font-black uppercase tracking-widest text-zinc-400 transition-colors hover:border-red-500/40 hover:text-red-400"
                  aria-label="Eliminar ${safeName}"
                >
                  <span class="sm:hidden" aria-hidden="true">✕</span>
                  <span class="hidden sm:inline">Eliminar</span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </li>`;
      })
      .join("");

    syncCheckoutState();
  };

  const revalidateCart = async (): Promise<boolean> => {
    if (validating) return false;
    const items = readCart();
    if (items.length === 0) {
      renderCart([]);
      return false;
    }

    validating = true;
    try {
      skipNextEventRender = true;
      const { lines } = await validateCartWithServer(items);
      const capped = lines.some((line) => line.issue === "qty_exceeds");
      const blocked = cartHasBlockingIssues(lines);
      const priceUpdates = lines.some((line) => line.priceChanged);

      if (blocked) {
        setBanner(
          "Hay productos no disponibles. Elimínalos o ajústalos para continuar.",
          "red",
        );
      } else if (capped) {
        setBanner("Ajustamos algunas cantidades al stock disponible.");
      } else if (priceUpdates) {
        setBanner("Actualizamos precios según el catálogo.");
      } else {
        setBanner(null);
      }

      renderCart(lines);
      return !blocked;
    } catch {
      setBanner(
        "No pudimos verificar stock/precios. Revisa tu conexión.",
        "red",
      );
      renderCart();
      return false;
    } finally {
      validating = false;
    }
  };

  const openWhatsAppSupport = () => {
    const btn = document.getElementById(
      "cart-whatsapp-support",
    ) as HTMLButtonElement | null;
    const number = btn?.dataset.whatsappNumber?.trim() ?? "";
    if (!isWhatsAppConfigured(number)) return;
    const message = [
      "Hola Sanctuary 👋",
      "Tengo una consulta sobre productos en mi carrito.",
    ].join("\n");
    window.open(buildWhatsAppUrl(message, number), "_blank", "noopener,noreferrer");
  };

  const handleCartAction = (event: Event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest<HTMLButtonElement>("[data-cart-action]");
    if (!button || button.disabled) return;

    const productId = decodeURIComponent(button.dataset.productId || "");
    const action = button.dataset.cartAction;
    if (!productId || !action) return;

    const item = readCart().find((entry) => entry.productId === productId);
    if (!item && action !== "remove") return;

    if (action === "increment") {
      const result = setItemQuantity(productId, (item?.quantity ?? 0) + 1);
      if (result.capped) {
        setBanner(
          `Stock máximo: ${getItemMaxQuantity(item!)} unidades.`,
          "amber",
        );
      }
      return;
    }
    if (action === "decrement") {
      setItemQuantity(productId, (item?.quantity ?? 1) - 1);
      return;
    }
    if (action === "remove") {
      removeItem(productId);
    }
  };

  const bindCartPage = () => {
    renderCart();
    void revalidateCart();

    const list = document.getElementById("cart-items");
    if (list && list.dataset.bound !== "1") {
      list.dataset.bound = "1";
      list.addEventListener("click", handleCartAction);
    }

    const clearButton = document.getElementById("cart-clear");
    if (clearButton && clearButton.dataset.bound !== "1") {
      clearButton.dataset.bound = "1";
      clearButton.addEventListener("click", () => {
        if (getCartItemCount() === 0) return;
        const confirmed = window.confirm(
          "¿Vaciar el carrito? Se eliminarán todos los productos.",
        );
        if (!confirmed) return;
        clearCart();
      });
    }

    const support = document.getElementById("cart-whatsapp-support");
    if (support && support.dataset.bound !== "1") {
      support.dataset.bound = "1";
      support.addEventListener("click", openWhatsAppSupport);
    }
  };

  bindCartPage();
  document.addEventListener("astro:page-load", bindCartPage);
  window.addEventListener(CART_UPDATED_EVENT, () => {
    if (skipNextEventRender) {
      skipNextEventRender = false;
      return;
    }
    renderCart();
  });
</script>
