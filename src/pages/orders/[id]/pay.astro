---
import MainLayout from "@/ui/layouts/MainLayout.astro";
import { getStoreSettings } from "@/application/services/StoreSettingsService";
import {
  orderInclude,
  serializeOrder,
} from "@/application/orders/serializeOrder";
import {
  canCustomerPayOrder,
  orderStatusClass,
  orderStatusLabel,
} from "@/application/orders/orderStatus";
import {
  buildQrPaidMessage,
  buildWhatsAppUrl,
  isWhatsAppConfigured,
} from "@/lib/storeContact";
import { formatPrice } from "@/lib/utils";
import { prisma } from "@/infrastructure/database/prisma";

const { id } = Astro.params;
const token = Astro.url.searchParams.get("token");
const user = Astro.locals.user;

if (!id) {
  return Astro.redirect("/cart");
}

const order = await prisma.order.findUnique({
  where: { id },
  include: orderInclude,
});

if (!order) {
  return new Response("Pedido no encontrado", { status: 404 });
}

const canAccess =
  user?.role === "ADMIN" ||
  (user?.id && order.userId === user.id) ||
  (token && order.guestAccessToken && token === order.guestAccessToken);

if (!canAccess) {
  if (!user) {
    return Astro.redirect(
      `/login?returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`,
    );
  }
  return new Response("Forbidden", { status: 403 });
}

const storeSettings = await getStoreSettings();
const serialized = serializeOrder(order);
const whatsappReady = isWhatsAppConfigured(storeSettings.cartWhatsApp);
const waMessage = buildQrPaidMessage({
  referenceCode: order.referenceCode,
  totalAmount: Number(order.totalAmount),
  customerName: order.customerName,
  customerCity: order.customerCity,
  proofUploaded: Boolean(serialized.payment?.proofUrl),
});
const waUrl = whatsappReady
  ? buildWhatsAppUrl(waMessage, storeSettings.cartWhatsApp)
  : null;

const awaitingPay = canCustomerPayOrder(order.status);
const inReview = order.status === "PAYMENT_REVIEW";
const paid =
  order.status === "PAID" ||
  order.status === "SHIPPED" ||
  order.status === "DELIVERED";
---

<MainLayout title={`Pagar ${order.referenceCode}`}>
  <div class="mx-auto max-w-[720px] px-4 py-10 sm:px-6 md:py-24">
    <div class="mb-8 space-y-3">
      <p class="text-[10px] font-black uppercase tracking-[0.35em] text-amber-500">
        Pago QR
      </p>
      <h1 class="text-3xl font-black uppercase tracking-tighter text-white sm:text-4xl">
        {order.referenceCode}
      </h1>
      <div class="h-1 w-12 bg-amber-500"></div>
      <p class={`text-sm font-black uppercase tracking-widest ${orderStatusClass(order.status)}`}>
        {orderStatusLabel(order.status)}
      </p>
    </div>

    {
      paid ? (
        <div class="border border-emerald-500/30 bg-emerald-500/5 px-5 py-8 text-center">
          <p class="text-sm font-black uppercase tracking-[0.2em] text-emerald-400">
            Pago confirmado
          </p>
          <p class="mt-3 text-xs leading-6 text-zinc-500">
            Tu pedido está en preparación. Puedes ver el estado en Mis pedidos.
          </p>
          <a
            href="/account/orders"
            class="mt-6 inline-flex border border-amber-500/60 px-6 py-3 text-[11px] font-black uppercase tracking-widest text-amber-500 transition-colors hover:bg-amber-500 hover:text-black"
          >
            Ver mis pedidos
          </a>
        </div>
      ) : (
        <div class="space-y-5">
          <div class="border border-zinc-900 bg-zinc-950 px-5 py-6 text-center">
            <p class="text-[10px] font-black uppercase tracking-[0.24em] text-zinc-600">
              Monto a pagar
            </p>
            <p class="mt-2 text-4xl font-black text-white">
              {formatPrice(Number(order.totalAmount))}
            </p>
            <p class="mt-4 text-xs leading-relaxed text-zinc-500">
              En el concepto / referencia del pago escribe exactamente:
            </p>
            <p class="mt-2 text-lg font-black uppercase tracking-[0.2em] text-amber-500">
              {order.referenceCode}
            </p>
          </div>

          <div class="border border-zinc-900 bg-zinc-950 px-5 py-6">
            <p class="text-[10px] font-black uppercase tracking-[0.24em] text-amber-500">
              Escanea el QR
            </p>
            {storeSettings.paymentQrImageUrl ? (
              <div class="mt-5 flex justify-center">
                <img
                  src={storeSettings.paymentQrImageUrl}
                  alt="QR bancario Sanctuary"
                  class="max-h-72 w-auto max-w-full border border-zinc-800 bg-white p-3"
                />
              </div>
            ) : (
              <p class="mt-4 text-xs text-amber-400">
                El QR aún no está configurado. Escríbenos por WhatsApp.
              </p>
            )}
            {storeSettings.paymentQrBankName && (
              <p class="mt-4 text-center text-sm font-bold text-white">
                {storeSettings.paymentQrBankName}
              </p>
            )}
            <p class="mt-3 text-center text-xs leading-relaxed text-zinc-500">
              {storeSettings.paymentQrInstructions ||
                "Paga el monto exacto e incluye la referencia del pedido. El pedido se confirma cuando verifiquemos el comprobante."}
            </p>
          </div>

          <div class="border border-zinc-900 bg-zinc-950 px-5 py-6">
            <p class="text-[10px] font-black uppercase tracking-[0.24em] text-amber-500">
              Resumen
            </p>
            <ul class="mt-4 space-y-2">
              {order.items.map((item) => (
                <li class="flex justify-between gap-3 text-[11px] uppercase tracking-widest text-zinc-500">
                  <span>
                    {item.quantity}× {item.product.name}
                  </span>
                  <span class="text-white">
                    {formatPrice(Number(item.price) * item.quantity)}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          {inReview && (
            <div class="border border-sky-500/30 bg-sky-500/5 px-5 py-4 text-xs leading-relaxed text-sky-300">
              Comprobante en revisión. Te confirmamos cuando verifiquemos el
              pago.
              {serialized.payment?.adminNote && (
                <span class="mt-2 block text-zinc-500">
                  Nota: {serialized.payment.adminNote}
                </span>
              )}
            </div>
          )}

          {awaitingPay && (
            <div class="space-y-4 border border-zinc-900 bg-zinc-950 px-5 py-6">
              <p class="text-[10px] font-black uppercase tracking-[0.24em] text-amber-500">
                Ya pagué — subir comprobante
              </p>
              <p
                id="proof-banner"
                class="hidden text-[11px] font-black uppercase tracking-widest text-amber-400"
              ></p>
              <input
                id="proof-file"
                type="file"
                accept="image/jpeg,image/png,image/webp,application/pdf"
                class="w-full border border-zinc-800 bg-black px-3 py-3 text-sm text-zinc-400 file:mr-4 file:border-0 file:bg-amber-500 file:px-3 file:py-2 file:text-[10px] file:font-black file:uppercase file:tracking-widest file:text-black"
              />
              <button
                type="button"
                id="proof-submit"
                data-order-id={order.id}
                data-token={token ?? ""}
                class="inline-flex w-full min-h-12 items-center justify-center bg-amber-500 px-6 py-3.5 text-[11px] font-black uppercase tracking-widest text-black transition-colors hover:bg-white disabled:cursor-not-allowed disabled:bg-zinc-800 disabled:text-zinc-500"
              >
                Enviar comprobante
              </button>
              {waUrl && (
                <a
                  href={waUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex w-full min-h-12 items-center justify-center gap-2 border border-[#25D366]/50 px-6 py-3.5 text-[11px] font-black uppercase tracking-widest text-[#25D366] transition-colors hover:bg-[#25D366] hover:text-black"
                >
                  Avisar por WhatsApp
                </a>
              )}
            </div>
          )}
        </div>
      )
    }
  </div>
</MainLayout>

{
  awaitingPay && (
    <script>
      const banner = document.getElementById("proof-banner");
      const fileInput = document.getElementById(
        "proof-file",
      ) as HTMLInputElement | null;
      const submitBtn = document.getElementById(
        "proof-submit",
      ) as HTMLButtonElement | null;

      const show = (msg: string) => {
        if (!banner) return;
        banner.textContent = msg;
        banner.classList.remove("hidden");
      };

      submitBtn?.addEventListener("click", async () => {
        if (!submitBtn || !fileInput?.files?.length) {
          show("Selecciona una imagen o PDF del comprobante");
          return;
        }

        const file = fileInput.files[0]!;
        submitBtn.disabled = true;
        submitBtn.textContent = "Subiendo…";

        try {
          const form = new FormData();
          form.append("file", file);
          const uploadRes = await fetch("/api/upload-payment-proof", {
            method: "POST",
            body: form,
            credentials: "same-origin",
          });
          const uploadJson = (await uploadRes.json()) as {
            url?: string;
            error?: string;
          };
          if (!uploadRes.ok || !uploadJson.url) {
            throw new Error(uploadJson.error || "No se pudo subir el archivo");
          }

          const token = submitBtn.dataset.token || "";
          const orderId = submitBtn.dataset.orderId || "";
          const proofRes = await fetch(`/api/orders/${orderId}/proof`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({
              proofUrl: uploadJson.url,
              token: token || undefined,
            }),
          });
          const proofJson = (await proofRes.json().catch(() => null)) as {
            error?: { message?: string };
          } | null;
          if (!proofRes.ok) {
            throw new Error(
              proofJson?.error?.message || "No se pudo registrar el comprobante",
            );
          }

          window.location.reload();
        } catch (error) {
          show(
            error instanceof Error
              ? error.message
              : "Error al enviar comprobante",
          );
          submitBtn.disabled = false;
          submitBtn.textContent = "Enviar comprobante";
        }
      });
    </script>
  )
}
