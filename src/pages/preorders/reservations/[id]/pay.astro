---
import MainLayout from "@/ui/layouts/MainLayout.astro";
import { getStoreSettings } from "@/application/services/StoreSettingsService";
import {
  buildQrPaidMessage,
  buildWhatsAppUrl,
  isWhatsAppConfigured,
} from "@/lib/storeContact";
import { formatPrice } from "@/lib/utils";
import { prisma } from "@/infrastructure/database/prisma";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(
    `/login?returnTo=${encodeURIComponent(Astro.url.pathname)}`,
  );
}

const { id } = Astro.params;
if (!id) return Astro.redirect("/preorders");

const reservation = await prisma.preorderReservation.findUnique({
  where: { id },
  include: {
    payments: { orderBy: { createdAt: "desc" } },
    campaign: {
      include: {
        product: { select: { id: true, name: true, imageUrl: true } },
      },
    },
  },
});

if (!reservation || reservation.userId !== user.id) {
  return new Response("Reserva no encontrada", { status: 404 });
}

const pending = reservation.payments.find((p) => p.status === "PENDING");
const paidEnough =
  reservation.status === "PAID" ||
  reservation.status === "CONFIRMED" ||
  reservation.status === "PARTIALLY_PAID" ||
  reservation.status === "FULFILLED";

const meta =
  pending &&
  typeof pending.metadata === "object" &&
  pending.metadata !== null
    ? (pending.metadata as Record<string, unknown>)
    : {};
const proofUrl =
  typeof meta.proofUrl === "string" ? meta.proofUrl : null;

const storeSettings = await getStoreSettings();
const amount = pending ? Number(pending.amount) : Number(reservation.depositRequired);
const reference = `PRE-${reservation.id.slice(0, 8).toUpperCase()}`;
const whatsappReady = isWhatsAppConfigured(storeSettings.cartWhatsApp);
const waMessage = buildQrPaidMessage({
  referenceCode: reference,
  totalAmount: amount,
  customerName: user.name,
  proofUploaded: Boolean(proofUrl),
});
const waUrl = whatsappReady
  ? buildWhatsAppUrl(waMessage, storeSettings.cartWhatsApp)
  : null;
---

<MainLayout title={`Pagar preventa ${reference}`}>
  <div class="mx-auto max-w-[720px] px-4 py-10 sm:px-6 md:py-24">
    <div class="mb-8 space-y-3">
      <p class="text-[10px] font-black uppercase tracking-[0.35em] text-amber-500">
        Preventa · Pago QR
      </p>
      <h1 class="text-3xl font-black uppercase tracking-tighter text-white sm:text-4xl">
        {reservation.campaign.product.name}
      </h1>
      <p class="text-sm font-black uppercase tracking-widest text-amber-500">
        {reference}
      </p>
      <div class="h-1 w-12 bg-amber-500"></div>
    </div>

    {
      paidEnough && !pending ? (
        <div class="border border-emerald-500/30 bg-emerald-500/5 px-5 py-8 text-center">
          <p class="text-sm font-black uppercase tracking-[0.2em] text-emerald-400">
            Pago registrado
          </p>
          <p class="mt-3 text-xs text-zinc-500">
            Tu reserva está confirmada o parcialmente pagada.
          </p>
        </div>
      ) : !pending ? (
        <div class="border border-zinc-900 bg-zinc-950 px-5 py-8 text-center text-xs text-zinc-500">
          No hay un pago pendiente para esta reserva.
        </div>
      ) : (
        <div class="space-y-5">
          <div class="border border-zinc-900 bg-zinc-950 px-5 py-6 text-center">
            <p class="text-[10px] font-black uppercase tracking-[0.24em] text-zinc-600">
              Monto a pagar
            </p>
            <p class="mt-2 text-4xl font-black text-white">
              {formatPrice(amount)}
            </p>
            <p class="mt-4 text-xs text-zinc-500">
              Concepto / referencia:
            </p>
            <p class="mt-2 text-lg font-black uppercase tracking-[0.2em] text-amber-500">
              {reference}
            </p>
          </div>

          <div class="border border-zinc-900 bg-zinc-950 px-5 py-6">
            <p class="text-[10px] font-black uppercase tracking-[0.24em] text-amber-500">
              Escanea el QR
            </p>
            {storeSettings.paymentQrImageUrl ? (
              <div class="mt-5 flex justify-center">
                <img
                  src={storeSettings.paymentQrImageUrl}
                  alt="QR bancario"
                  class="max-h-72 w-auto max-w-full border border-zinc-800 bg-white p-3"
                />
              </div>
            ) : (
              <p class="mt-4 text-xs text-amber-400">
                QR no configurado. Usa WhatsApp para coordinar el pago.
              </p>
            )}
            {storeSettings.paymentQrBankName && (
              <p class="mt-4 text-center text-sm font-bold text-white">
                {storeSettings.paymentQrBankName}
              </p>
            )}
            <p class="mt-3 text-center text-xs leading-relaxed text-zinc-500">
              {storeSettings.paymentQrInstructions ||
                "Paga el monto e incluye la referencia. Confirmamos al verificar el comprobante."}
            </p>
          </div>

          {proofUrl && (
            <div class="border border-sky-500/30 bg-sky-500/5 px-5 py-4 text-xs text-sky-300">
              Comprobante enviado. Esperando verificación del admin.
            </div>
          )}

          <div class="space-y-4 border border-zinc-900 bg-zinc-950 px-5 py-6">
            <p class="text-[10px] font-black uppercase tracking-[0.24em] text-amber-500">
              Subir comprobante
            </p>
            <p
              id="preorder-proof-banner"
              class="hidden text-[11px] font-black uppercase tracking-widest text-amber-400"
            ></p>
            <input
              id="preorder-proof-file"
              type="file"
              accept="image/jpeg,image/png,image/webp,application/pdf"
              class="w-full border border-zinc-800 bg-black px-3 py-3 text-sm text-zinc-400 file:mr-4 file:border-0 file:bg-amber-500 file:px-3 file:py-2 file:text-[10px] file:font-black file:uppercase file:tracking-widest file:text-black"
            />
            <button
              type="button"
              id="preorder-proof-submit"
              data-reservation-id={reservation.id}
              class="inline-flex w-full min-h-12 items-center justify-center bg-amber-500 px-6 py-3.5 text-[11px] font-black uppercase tracking-widest text-black hover:bg-white"
            >
              Enviar comprobante
            </button>
            {waUrl && (
              <a
                href={waUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full min-h-12 items-center justify-center border border-[#25D366]/50 px-6 py-3.5 text-[11px] font-black uppercase tracking-widest text-[#25D366] hover:bg-[#25D366] hover:text-black"
              >
                Avisar por WhatsApp
              </a>
            )}
          </div>
        </div>
      )
    }
  </div>
</MainLayout>

{
  pending && (
    <script>
      const banner = document.getElementById("preorder-proof-banner");
      const fileInput = document.getElementById(
        "preorder-proof-file",
      ) as HTMLInputElement | null;
      const submitBtn = document.getElementById(
        "preorder-proof-submit",
      ) as HTMLButtonElement | null;

      const show = (msg: string) => {
        if (!banner) return;
        banner.textContent = msg;
        banner.classList.remove("hidden");
      };

      submitBtn?.addEventListener("click", async () => {
        if (!submitBtn || !fileInput?.files?.length) {
          show("Selecciona el comprobante");
          return;
        }
        const file = fileInput.files[0]!;
        submitBtn.disabled = true;
        submitBtn.textContent = "Subiendo…";
        try {
          const form = new FormData();
          form.append("file", file);
          const uploadRes = await fetch("/api/upload-payment-proof", {
            method: "POST",
            body: form,
            credentials: "same-origin",
          });
          const uploadJson = (await uploadRes.json()) as {
            url?: string;
            error?: string;
          };
          if (!uploadRes.ok || !uploadJson.url) {
            throw new Error(uploadJson.error || "Error al subir");
          }

          const reservationId = submitBtn.dataset.reservationId || "";
          const proofRes = await fetch(
            `/api/preorders/reservations/${reservationId}/proof`,
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              credentials: "same-origin",
              body: JSON.stringify({ proofUrl: uploadJson.url }),
            },
          );
          const proofJson = (await proofRes.json().catch(() => null)) as {
            error?: { message?: string };
          } | null;
          if (!proofRes.ok) {
            throw new Error(
              proofJson?.error?.message || "No se pudo registrar el comprobante",
            );
          }
          window.location.reload();
        } catch (error) {
          show(error instanceof Error ? error.message : "Error");
          submitBtn.disabled = false;
          submitBtn.textContent = "Enviar comprobante";
        }
      });
    </script>
  )
}
