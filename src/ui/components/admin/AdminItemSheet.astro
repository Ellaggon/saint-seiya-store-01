---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
}

const { id, title, subtitle } = Astro.props;
---

<dialog
  id={id}
  class="admin-item-sheet z-[80] w-[calc(100%-2rem)] max-w-md border border-zinc-800 bg-black p-0 text-white shadow-[0_24px_80px_rgba(0,0,0,0.75)]"
  aria-labelledby={`${id}-title`}
>
  <div class="border-b border-zinc-900 px-5 py-4">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0 space-y-1">
        <p class="text-amber-500 text-[10px] font-black uppercase tracking-[0.35em]">
          Acciones
        </p>
        <h2
          id={`${id}-title`}
          class="truncate text-base font-black uppercase tracking-[0.08em] text-white"
        >
          {title}
        </h2>
        {
          subtitle && (
            <p class="truncate text-[10px] uppercase tracking-widest text-zinc-500">
              {subtitle}
            </p>
          )
        }
      </div>
      <button
        type="button"
        class="admin-item-sheet-close shrink-0 p-2 text-zinc-500 transition-colors hover:text-amber-500"
        aria-label="Cerrar"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="max-h-[70vh] space-y-4 overflow-y-auto px-5 py-5">
    <slot name="details" />
    <div class="flex flex-col gap-3">
      <slot />
    </div>
  </div>
</dialog>

<style>
  .admin-item-sheet {
    margin: auto;
  }

  .admin-item-sheet::backdrop {
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
  }
</style>
