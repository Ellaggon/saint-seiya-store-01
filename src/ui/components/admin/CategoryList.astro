---
import MainLayout from "../../layouts/MainLayout.astro";
import AdminItemSheet from "./AdminItemSheet.astro";
import AdminItemSheetsInit from "./AdminItemSheetsInit.astro";
import AdminMobileListRow from "./AdminMobileListRow.astro";

interface Props {
  categories: any[];
  error?: string | null;
}

const { categories, error = null } = Astro.props;

const actionLabel = (deletedAt?: Date | string | null): string =>
  deletedAt ? "Activar" : "Desactivar";

const actionValue = (deletedAt?: Date | string | null): string =>
  deletedAt ? "activate" : "deactivate";

const actionConfirm = (deletedAt?: Date | string | null): string =>
  deletedAt
    ? "¿Activar esta categoría?"
    : "¿Desactivar esta categoría? No se eliminará, solo dejará de estar activa.";

const statusClass = (deletedAt?: Date | string | null): string =>
  !deletedAt
    ? "text-green-500 border-green-500/30 bg-green-500/5"
    : "text-zinc-500 border-zinc-800 bg-zinc-900";
---

<MainLayout title="Admin - Gestión de Categorías">
  <div class="max-w-[1280px] mx-auto px-6 py-12">
    <!-- Header Section -->
    <div
      class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12"
    >
      <div class="space-y-2">
        <p
          class="text-amber-500 text-[10px] font-black uppercase tracking-[0.4em]"
        >
          Panel de Control
        </p>
        <h1 class="text-4xl font-black text-white uppercase tracking-tighter">
          Categorías de Productos (Sagas)
        </h1>
        <div class="w-12 h-1 bg-amber-500"></div>
      </div>

      <a
        href="/admin/categories/new"
        class="inline-flex items-center justify-center bg-white text-black text-[11px] font-black uppercase tracking-widest px-8 py-4 hover:bg-amber-500 transition-colors duration-300"
      >
        Añadir Nueva Categoría
      </a>
    </div>

    {
      error && (
        <div class="border border-red-500/30 bg-red-500/5 text-red-400 px-5 py-4 text-xs font-bold uppercase tracking-widest mb-8">
          {error}
        </div>
      )
    }

    {
      categories.length === 0 ? (
        <div class="border border-zinc-900 bg-zinc-950 px-6 py-12 text-center text-zinc-500 text-xs uppercase tracking-widest italic">
          No hay categorías registradas todavía.
        </div>
      ) : (
        <>
          <!-- Mobile: compact rows + action sheet -->
          <div class="space-y-2 md:hidden">
            {categories.map((cat) => {
              const sheetId = `category-sheet-${cat.id}`;
              return (
                <>
                  <AdminMobileListRow
                    sheetId={sheetId}
                    title={cat.name}
                    statusLabel={!cat.deletedAt ? "ACTIVO" : "DESACTIVADO"}
                    statusClass={statusClass(cat.deletedAt)}
                    editHref={`/admin/categories/${cat.id}/edit`}
                  />
                  <AdminItemSheet id={sheetId} title={cat.name} subtitle={cat.slug}>
                    <div
                      slot="details"
                      class="flex items-center justify-between gap-3 border border-zinc-900 bg-zinc-950 px-4 py-3"
                    >
                      <span class="text-[10px] font-black uppercase tracking-widest text-zinc-500">
                        Estado
                      </span>
                      <span
                        class={`text-[9px] font-black uppercase tracking-tighter border px-2 py-1 ${statusClass(cat.deletedAt)}`}
                      >
                        {!cat.deletedAt ? "ACTIVO" : "DESACTIVADO"}
                      </span>
                    </div>
                    <a
                      href={`/admin/categories/${cat.id}/edit`}
                      class="inline-flex w-full items-center justify-center border border-zinc-800 bg-zinc-950 px-4 py-3 text-[11px] font-black uppercase tracking-widest text-white transition-colors hover:border-amber-500 hover:text-amber-500"
                    >
                      Editar
                    </a>
                    <form
                      action="/api/admin/categories/actions"
                      method="POST"
                      onsubmit={`return confirm('${actionConfirm(cat.deletedAt)}')`}
                    >
                      <input type="hidden" name="id" value={cat.id} />
                      <input
                        type="hidden"
                        name="_action"
                        value={actionValue(cat.deletedAt)}
                      />
                      <button
                        type="submit"
                        class={`inline-flex w-full items-center justify-center border px-4 py-3 text-[11px] font-black uppercase tracking-widest transition-colors ${
                          cat.deletedAt
                            ? "border-green-500/30 text-green-500 hover:bg-green-500/10"
                            : "border-zinc-800 text-zinc-400 hover:border-amber-500 hover:text-amber-500"
                        }`}
                      >
                        {actionLabel(cat.deletedAt)}
                      </button>
                    </form>
                    <form
                      action="/api/admin/categories/actions"
                      method="POST"
                      onsubmit="return confirm('¿Eliminar definitivamente esta categoría? Esta acción no se puede deshacer y fallará si tiene productos asociados.')"
                    >
                      <input type="hidden" name="id" value={cat.id} />
                      <input type="hidden" name="_action" value="delete" />
                      <button
                        type="submit"
                        class="inline-flex w-full items-center justify-center border border-red-500/30 px-4 py-3 text-[11px] font-black uppercase tracking-widest text-red-500 transition-colors hover:bg-red-500/10"
                      >
                        Eliminar
                      </button>
                    </form>
                  </AdminItemSheet>
                </>
              );
            })}
          </div>

          <!-- Tablet/desktop: full table -->
          <div class="hidden md:block bg-zinc-950 border border-zinc-900 overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead class="bg-black border-b border-zinc-900">
                <tr>
                  <th class="px-6 py-4 text-[10px] font-black text-amber-500 uppercase tracking-widest">
                    Nombre
                  </th>
                  <th class="px-6 py-4 text-[10px] font-black text-amber-500 uppercase tracking-widest">
                    Slug
                  </th>
                  <th class="px-6 py-4 text-[10px] font-black text-amber-500 uppercase tracking-widest">
                    Estado
                  </th>
                  <th class="px-6 py-4 text-[10px] font-black text-amber-500 uppercase tracking-widest text-right">
                    Acciones
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-900">
                {categories.map((cat) => (
                  <tr class="hover:bg-zinc-900/50 transition-colors group">
                    <td class="px-6 py-5">
                      <span class="text-white font-bold text-sm uppercase tracking-tight">
                        {cat.name}
                      </span>
                    </td>
                    <td class="px-6 py-5">
                      <span class="text-zinc-600 text-[10px] tracking-widest uppercase">
                        {cat.slug}
                      </span>
                    </td>
                    <td class="px-6 py-5">
                      <span
                        class={`text-[9px] font-black uppercase px-2 py-1 tracking-tighter border ${statusClass(cat.deletedAt)}`}
                      >
                        {!cat.deletedAt ? "ACTIVO" : "DESACTIVADO"}
                      </span>
                    </td>
                    <td class="px-6 py-5 text-right">
                      <div class="flex justify-end items-center gap-3">
                        <a
                          href={`/admin/categories/${cat.id}/edit`}
                          class="text-[10px] font-black text-white hover:text-amber-500 uppercase transition-colors"
                        >
                          Editar
                        </a>
                        <span class="text-zinc-800">|</span>
                        <form
                          action="/api/admin/categories/actions"
                          method="POST"
                          onsubmit={`return confirm('${actionConfirm(cat.deletedAt)}')`}
                        >
                          <input type="hidden" name="id" value={cat.id} />
                          <input
                            type="hidden"
                            name="_action"
                            value={actionValue(cat.deletedAt)}
                          />
                          <button
                            type="submit"
                            class={`text-[10px] font-black uppercase transition-colors ${
                              cat.deletedAt
                                ? "text-green-500 hover:text-white"
                                : "text-zinc-600 hover:text-amber-500"
                            }`}
                          >
                            {actionLabel(cat.deletedAt)}
                          </button>
                        </form>
                        <span class="text-zinc-800">|</span>
                        <form
                          action="/api/admin/categories/actions"
                          method="POST"
                          onsubmit="return confirm('¿Eliminar definitivamente esta categoría? Esta acción no se puede deshacer y fallará si tiene productos asociados.')"
                        >
                          <input type="hidden" name="id" value={cat.id} />
                          <input type="hidden" name="_action" value="delete" />
                          <button
                            type="submit"
                            class="text-[10px] font-black text-red-500 hover:text-red-300 uppercase transition-colors"
                          >
                            Eliminar
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )
    }
    <AdminItemSheetsInit />
  </div>
</MainLayout>
