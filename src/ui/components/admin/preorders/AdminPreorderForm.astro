---
import type { ProductDTO } from "@/application/dto/catalog.dto";
import type { PreorderDetailDTO } from "@/application/dto/preorder.dto";
import { formatPrice } from "@/lib/utils";
import AdminPreorderDeleteDialog from "./AdminPreorderDeleteDialog.astro";
import AdminPreorderReceipt from "./AdminPreorderReceipt.astro";

interface Props {
  products: ProductDTO[];
  preorder?: PreorderDetailDTO | null;
  error?: string | null;
  saved?: boolean;
}

const { products, preorder = null, error = null, saved = false } = Astro.props;
const campaign = preorder?.campaign;
const isEditing = Boolean(campaign);
const hasReservations = (campaign?.reservedUnits ?? 0) > 0;
const reservedUnits = campaign?.reservedUnits ?? 0;
const product = preorder?.product;
const selectedProduct = products.find((item) => item.id === campaign?.productId);
const productId = campaign?.productId ?? "";
const productName = product?.name ?? selectedProduct?.name ?? "";
const productImage = product?.imageUrl ?? selectedProduct?.imageUrl ?? "";
const productPrice = selectedProduct?.price ?? product?.price ?? 0;
const productMeta = [
  product?.collection?.name,
  product?.category?.name ?? selectedProduct?.category,
]
  .filter(Boolean)
  .join(" · ");

const dateValue = (value?: string | null): string =>
  value ? value.slice(0, 10) : "";

const formatDisplayDate = (value?: string | null): string => {
  if (!value) return "";
  const date = new Date(`${value.slice(0, 10)}T12:00:00`);
  if (Number.isNaN(date.getTime())) return "";
  return new Intl.DateTimeFormat("es-BO", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }).format(date);
};

const calculateDeposit = (price: number, type: string, value: number): number => {
  if (type === "FULL") return price;
  if (type === "FIXED") return Math.min(value, price);
  return Math.min(price * (value / 100), price);
};

const depositType = campaign?.depositType ?? "PERCENT";
const depositValue = campaign?.depositValue ?? 0;
const dueNow = calculateDeposit(productPrice, depositType, depositValue);
const balance = Math.max(productPrice - dueNow, 0);

const windowCopy = (() => {
  const opens = dateValue(campaign?.opensAt);
  const closes = dateValue(campaign?.closesAt);
  if (!opens && !closes) {
    return {
      text: "Abierta todo el tiempo que esté en vitrina.",
      tone: "muted" as const,
    };
  }
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const openDate = opens ? new Date(`${opens}T00:00:00`) : null;
  const closeDate = closes ? new Date(`${closes}T00:00:00`) : null;
  if (openDate && today < openDate) {
    return {
      text: `Todavía no acepta reservas. Abre el ${formatDisplayDate(opens)}.`,
      tone: "muted" as const,
    };
  }
  if (closeDate && today > closeDate) {
    return {
      text: "Ya no acepta reservas nuevas.",
      tone: "danger" as const,
    };
  }
  if (closeDate) {
    const days = Math.max(
      1,
      Math.ceil((closeDate.getTime() - today.getTime()) / 86_400_000),
    );
    return {
      text: `Abierta. Cierra en ${days} ${days === 1 ? "día" : "días"}.`,
      tone: "live" as const,
    };
  }
  return { text: "Abierta mientras esté en vitrina.", tone: "live" as const };
})();

const etaLabel = campaign?.etaLabel?.trim() || "Sin informar";
const etaRange =
  campaign?.etaStart || campaign?.etaEnd
    ? `Ventana ${formatDisplayDate(campaign?.etaStart) || "—"} – ${formatDisplayDate(campaign?.etaEnd) || "—"}`
    : "";
const slotsLabel =
  reservedUnits > 0
    ? `${campaign?.totalSlots ?? 0} unidades · ${reservedUnits} ya tomadas`
    : `${campaign?.totalSlots ?? 0} unidades`;
const despuesLabel =
  depositType === "FULL" || balance <= 0
    ? "Pagan el total hoy. No queda saldo."
    : `Después ${formatPrice(balance)}, cuando llegue a tienda`;

const status = campaign?.status ?? "DRAFT";
const isSoldOut = Boolean(campaign?.isSoldOut || status === "SOLD_OUT");
const isLifecycle = ["ARRIVED", "CLOSED", "CANCELED"].includes(status);
const showSegmented = isEditing && !isSoldOut && !isLifecycle;
const occupancyPercent =
  (campaign?.totalSlots ?? 0) > 0
    ? Math.min(100, (reservedUnits / (campaign?.totalSlots ?? 1)) * 100)
    : 0;

const depositChoices = [
  {
    value: "PERCENT",
    title: "Un porcentaje ahora",
    description: "Dejan una parte del precio para asegurar la figura.",
  },
  {
    value: "FIXED",
    title: "Un monto fijo ahora",
    description: "Dejan una cifra, da igual el precio de la figura.",
  },
  {
    value: "FULL",
    title: "Pagan el total al reservar",
    description: "No hay saldo. Entran pagando el precio completo.",
  },
];

const productCatalog = products.map((item) => ({
  id: item.id,
  name: item.name,
  price: item.price,
  imageUrl: item.imageUrl || "",
  meta: item.category || "",
}));

const windowToneClass =
  windowCopy.tone === "live"
    ? "text-[#4ADE80]"
    : windowCopy.tone === "danger"
      ? "text-[#F87171]"
      : "text-[#71717A]";
---

<div class="preorder-ficha">
  {
    error && (
      <div class="mx-auto max-w-[1120px] px-8 pt-6">
        <p
          class="rounded-md border border-red-500/25 bg-red-500/5 px-4 py-3 text-[13px] leading-5 text-red-400"
          role="alert"
        >
          {error}
        </p>
      </div>
    )
  }

  <form
    id="preorder-campaign-form"
    action="/admin/preorders/actions"
    method="POST"
    data-editing={isEditing ? "true" : "false"}
    data-reserved={String(reservedUnits)}
    data-deposit-locked={hasReservations ? "true" : "false"}
    data-product-price={String(productPrice)}
    data-product-name={productName}
    data-product-image={productImage}
    data-product-meta={productMeta}
  >
    <input type="hidden" name="_action" value={isEditing ? "update" : "create"} />
    {campaign && <input type="hidden" name="id" value={campaign.id} />}
    <input type="hidden" id="productId" name="productId" value={productId} />
    {
      isEditing && (
        <input type="hidden" id="status" name="status" value={status} />
      )
    }

    <div
      class="sticky top-16 z-20 border-b border-[#18181B] bg-black md:top-20"
    >
      <div
        class="mx-auto flex h-14 max-w-[1120px] items-center justify-between gap-4 px-8"
      >
        <a
          href="/admin/preorders"
          data-astro-prefetch="hover"
          class="inline-flex items-center gap-1.5 text-[13px] font-medium leading-[18px] text-[#71717A] transition-colors duration-150 hover:text-[#FAFAFA]"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          Preventas
        </a>

        <div class="flex items-center gap-2">
          {
            isEditing && productId && (
              <a
                href={`/product/${productId}`}
                class="preorder-ghost hidden sm:inline-flex"
                target="_blank"
                rel="noreferrer"
              >
                Ver ficha
              </a>
            )
          }
          {
            isEditing && campaign && (
              <a
                href={`/admin/preorders/${campaign.id}/reservations`}
                class="preorder-ghost hidden sm:inline-flex"
              >
                {reservedUnits > 0 ? `Reservas · ${reservedUnits}` : "Reservas"}
              </a>
            )
          }
          <button
            type="button"
            data-discard
            class="preorder-ghost"
          >
            Descartar
          </button>
          <button
            type="submit"
            data-save
            class="preorder-save hidden lg:inline-flex"
          >
            {isEditing ? "Guardar cambios" : "Crear preventa"}
          </button>
        </div>
      </div>
    </div>

    <div class="mx-auto max-w-[1120px] px-8 pb-28 pt-6 lg:pb-24">
      <header class="preorder-hero">
        <div
          class="h-[110px] w-[88px] shrink-0 overflow-hidden rounded-[14px] border border-[#18181B] bg-[#09090B]"
          data-hero-photo
        >
          {
            productImage ? (
              <img
                src={productImage}
                alt=""
                class="h-full w-full object-cover"
                data-hero-image
              />
            ) : null
          }
        </div>

        <div class="min-w-0 flex-1">
          <h1
            class="text-[26px] font-semibold leading-8 tracking-[-0.02em] text-[#FAFAFA]"
            data-hero-title
          >
            {isEditing ? productName : "¿Cuál figura entra a preventa?"}
          </h1>
          <p
            class="mt-2 text-[13px] leading-[18px] text-[#A1A1AA]"
            data-hero-meta
          >
            {isEditing ? productMeta || "Preventa" : "Busca en el catálogo. Si todavía no existe, créala primero."}
          </p>
          <p
            class:list={[
              "mt-2 text-[22px] font-semibold leading-7 tracking-[-0.01em] text-[#D4AF37]",
              !isEditing && !productId && "hidden",
            ]}
            data-hero-price
          >
            {productPrice ? formatPrice(productPrice) : ""}
          </p>

          {
            !isEditing && (
              <div class="relative mt-4 max-w-xl">
                <label for="product-search" class="preorder-label">
                  Figura
                </label>
                <input
                  id="product-search"
                  type="search"
                  autocomplete="off"
                  placeholder="Nombre de la figura"
                  class="preorder-input mt-2 w-full"
                />
                <div
                  id="product-results"
                  hidden
                  class="absolute z-10 mt-1 max-h-72 w-full overflow-auto rounded-md border border-[#27272A] bg-black"
                ></div>
                <p
                  class="mt-2 hidden text-[12px] leading-[18px] text-[#F87171]"
                  data-product-error
                >
                  Elige una figura para abrir la preventa.
                </p>
                <a
                  href="/admin/products/new?returnTo=/admin/preorders/new"
                  class="mt-2 inline-block text-[12px] leading-4 text-[#71717A] transition-colors duration-150 hover:text-[#D4AF37]"
                >
                  Crear producto
                </a>
              </div>
            )
          }

          {
            isEditing && productId && (
              <a
                href={`/admin/products/${productId}`}
                class="mt-2 inline-block text-[12px] leading-4 text-[#71717A] transition-colors duration-150 hover:text-[#D4AF37]"
              >
                Editar producto
              </a>
            )
          }

          {
            showSegmented && (
              <div
                class="preorder-segment mt-4"
                role="radiogroup"
                aria-label="Estado de la preventa"
              >
                <button type="button" data-status="DRAFT" aria-pressed={status === "DRAFT"}>
                  <span data-status-dot="draft"></span>
                  Borrador
                </button>
                <button type="button" data-status="ACTIVE" aria-pressed={status === "ACTIVE"}>
                  <span data-status-dot="live"></span>
                  En vitrina
                </button>
                <button type="button" data-status="PAUSED" aria-pressed={status === "PAUSED"}>
                  <span data-status-dot="paused"></span>
                  Pausada
                </button>
              </div>
            )
          }

          {
            isSoldOut && (
              <p class="mt-4 text-[12px] font-medium leading-4 text-[#F87171]">
                Agotada · El cupo está lleno.
              </p>
            )
          }

          {
            isLifecycle && (
              <p class="mt-4 text-[13px] font-medium leading-[18px] text-[#A1A1AA]">
                {status === "ARRIVED"
                  ? "Llegó a tienda"
                  : status === "CLOSED"
                    ? "Cerrada"
                    : "Cancelada"}
              </p>
            )
          }

          {
            isEditing && (
              <details class="preorder-more mt-3">
                <summary>Más acciones</summary>
                <div class="preorder-more-menu">
                  <button type="button" data-status="ARRIVED">
                    Marcar llegada
                  </button>
                  <button type="button" data-status="CLOSED">
                    Cerrar preventa
                  </button>
                  <button type="button" data-status="CANCELED">
                    Cancelar campaña
                  </button>
                  <button type="button" data-status="DRAFT">
                    Volver a borrador
                  </button>
                </div>
              </details>
            )
          }

          <div class="mt-4">
            <div class="mb-2 flex items-baseline justify-between gap-3">
              <p class="text-[12px] leading-4 text-[#A1A1AA]" data-hero-occupancy>
                {
                  reservedUnits === 0
                    ? "Nadie ha reservado todavía"
                    : `${reservedUnits} de ${campaign?.totalSlots ?? 0} reservadas`
                }
              </p>
              <p class="text-[12px] leading-4 text-[#A1A1AA]" data-hero-occupancy-total>
                {campaign?.totalSlots ?? 0} unidades
              </p>
            </div>
            <div class="h-1 overflow-hidden rounded-full bg-[#18181B]" aria-hidden="true">
              <div
                class="h-full bg-[#D4AF37]"
                data-hero-occupancy-bar
                style={`width: ${occupancyPercent}%`}
              ></div>
            </div>
          </div>
        </div>
      </header>

      <button
        type="button"
        class="mt-5 flex h-12 w-full items-center justify-between rounded-md border border-[#18181B] bg-[#09090B] px-4 text-left lg:hidden"
        data-receipt-open
      >
        <span
          class="text-[13px] leading-[18px] text-[#A1A1AA]"
          data-receipt-strip
        >
          Recibo del cliente
        </span>
        <span class="text-[12px] text-[#71717A]">Ver</span>
      </button>

      <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-[1.7fr_1fr] lg:gap-12">
        <div>
          <section class="preorder-act">
            <h2 class="preorder-act-title">Cuántas unidades abre esta preventa.</h2>
            <p class="preorder-lead">
              Es el cupo de esta campaña. No toca el stock del catálogo.
            </p>
            <label for="totalSlots" class="preorder-label">Unidades</label>
            <div class="relative mt-2 w-[140px]">
              <input
                type="number"
                id="totalSlots"
                name="totalSlots"
                min={Math.max(1, reservedUnits || 1)}
                value={campaign?.totalSlots ?? ""}
                required
                class="preorder-input w-full pr-8"
              />
              <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-[12px] text-[#71717A]">
                u
              </span>
            </div>
            <p class="preorder-help">
              {
                reservedUnits > 0
                  ? `Ya hay ${reservedUnits} reservas. No puedes bajar de ${reservedUnits}.`
                  : "Puedes subir o bajar mientras no haya reservas."
              }
            </p>
          </section>

          <section class="preorder-act">
            <h2 class="preorder-act-title">Cómo reservan.</h2>
            <p class="preorder-lead">
              Elige una. El recibo muestra lo que paga el cliente hoy y lo que queda.
            </p>

            {
              hasReservations && (
                <p class="mb-4 text-[12px] leading-[18px] text-[#A1A1AA]">
                  El abono quedó fijo porque ya hay reservas. Si necesitas
                  cambiarlo, hay que resolver esas reservas primero.
                </p>
              )
            }

            <div class="space-y-3">
              {
                depositChoices.map((choice) => (
                  <label
                    class:list={[
                      "preorder-choice",
                      depositType === choice.value && "is-selected",
                    ]}
                  >
                    <input
                      type="radio"
                      name="depositType"
                      value={choice.value}
                      checked={depositType === choice.value}
                      disabled={hasReservations}
                    />
                    <span class="preorder-choice-mark" aria-hidden="true">
                      <span></span>
                    </span>
                    <span class="min-w-0">
                      <span class="block text-[14px] font-semibold leading-5 text-[#FAFAFA]">
                        {choice.title}
                      </span>
                      <span class="mt-1 block text-[12px] leading-[18px] text-[#71717A]">
                        {choice.description}
                      </span>
                    </span>
                  </label>
                ))
              }
            </div>
            {hasReservations && (
              <input type="hidden" name="depositType" value={depositType} />
            )}

            <div
              id="depositValuePanel"
              class:list={["preorder-choice-panel", depositType === "FULL" && "hidden"]}
            >
              <label for="depositValue" class="preorder-label" id="depositValueLabel">
                {depositType === "FIXED" ? "Monto de abono" : "Porcentaje de abono"}
              </label>
              <div class="preorder-affix mt-2">
                <span
                  id="depositValuePrefix"
                  class:list={[
                    "preorder-affix-addon",
                    depositType !== "FIXED" && "hidden",
                  ]}
                >
                  Bs
                </span>
                <input
                  type="number"
                  id="depositValue"
                  name="depositValue"
                  min="0"
                  step="0.01"
                  value={campaign?.depositValue ?? ""}
                  required={depositType !== "FULL"}
                  readonly={hasReservations || depositType === "FULL"}
                  class="preorder-input"
                />
                <span
                  id="depositValueSuffix"
                  class:list={[
                    "preorder-affix-addon preorder-affix-suffix",
                    depositType !== "PERCENT" && "hidden",
                  ]}
                >
                  %
                </span>
              </div>
              <p class="preorder-help" data-deposit-live>
                {depositType === "FULL"
                  ? `Pagan ${formatPrice(productPrice)} ahora. No queda saldo.`
                  : `Hoy ${formatPrice(dueNow)} · después ${formatPrice(balance)}`}
              </p>
            </div>

            <div class="preorder-choice-extra flex min-h-11 items-center justify-between gap-4">
              <div class="min-w-0">
                <p class="text-[14px] leading-[22px] text-[#FAFAFA]">
                  También pueden pagar todo ahora, si quieren.
                </p>
                <p class="preorder-help mt-1">
                  Si lo apagas, solo se cobra el abono mínimo.
                </p>
              </div>
              <label class="preorder-toggle">
                <span class="sr-only">Permitir pago completo</span>
                <input
                  type="checkbox"
                  name="allowFullPayment"
                  value="true"
                  checked={campaign?.allowFullPayment ?? true}
                />
                <span class="preorder-toggle-track"></span>
              </label>
            </div>
          </section>

          <section class="preorder-act">
            <h2 class="preorder-act-title">Cuándo se puede reservar.</h2>
            <p class="preorder-lead">
              Fuera de estas fechas no entra nadie, aunque esté en vitrina.
            </p>
            <div class="flex flex-wrap items-end gap-4">
              <div>
                <label for="opensAt" class="preorder-label">Abre</label>
                <input
                  type="date"
                  id="opensAt"
                  name="opensAt"
                  value={dateValue(campaign?.opensAt)}
                  class="preorder-input mt-2 w-[168px]"
                />
              </div>
              <span class="mb-[22px] hidden h-px w-6 bg-[#27272A] sm:block" aria-hidden="true"></span>
              <div>
                <label for="closesAt" class="preorder-label">Cierra</label>
                <input
                  type="date"
                  id="closesAt"
                  name="closesAt"
                  value={dateValue(campaign?.closesAt)}
                  class="preorder-input mt-2 w-[168px]"
                />
              </div>
            </div>
            <p class:list={["mt-3 text-[13px] leading-5", windowToneClass]} data-window-phrase>
              {windowCopy.text}
            </p>
          </section>

          <section class="preorder-act">
            <h2 class="preorder-act-title">Qué les decimos de la llegada.</h2>
            <p class="preorder-lead">
              Una frase clara vale más que tres fechas. Eso es lo que se lee en la ficha.
            </p>
            <label for="etaLabel" class="preorder-label">Frase visible</label>
            <input
              type="text"
              id="etaLabel"
              name="etaLabel"
              value={campaign?.etaLabel ?? ""}
              placeholder="Llegada estimada diciembre 2026"
              class="preorder-input preorder-input-copy mt-2 w-full"
            />
            <p class="preorder-help">Aparece tal cual en la ficha del producto.</p>

            <p class="preorder-label mt-4">Ventana aproximada, opcional</p>
            <div class="mt-2 flex flex-wrap items-end gap-4">
              <div>
                <label for="etaStart" class="preorder-label">Desde</label>
                <input
                  type="date"
                  id="etaStart"
                  name="etaStart"
                  value={dateValue(campaign?.etaStart)}
                  class="preorder-input mt-2 w-[168px]"
                />
              </div>
              <div>
                <label for="etaEnd" class="preorder-label">Hasta</label>
                <input
                  type="date"
                  id="etaEnd"
                  name="etaEnd"
                  value={dateValue(campaign?.etaEnd)}
                  class="preorder-input mt-2 w-[168px]"
                />
              </div>
            </div>
            <p class="preorder-help">
              Si aún no tienes mes cerrado, deja solo la frase.
            </p>
          </section>

          <section class="preorder-act">
            <h2 class="preorder-act-title">Reglas que mostramos.</h2>
            <p class="preorder-lead">
              Dos o tres frases. Lo que el cliente acepta al reservar.
            </p>
            <label for="terms" class="preorder-label">Condiciones</label>
            <textarea
              id="terms"
              name="terms"
              rows="5"
              placeholder="El abono confirma la reserva. El saldo se paga cuando el producto llegue a tienda."
              class="preorder-input preorder-textarea mt-2 w-full"
            >{campaign?.terms ?? ""}</textarea>
            <p class="preorder-help">Se muestra en la ficha, bajo el precio.</p>
          </section>

          <details class="preorder-act preorder-internal">
            <summary class="text-[13px] font-medium leading-[18px] text-[#71717A] transition-colors duration-150 hover:text-[#FAFAFA]">
              Datos internos
            </summary>
            <div class="mt-5 space-y-5">
              <div>
                <label for="releaseDate" class="preorder-label">
                  Fecha del fabricante
                </label>
                <input
                  type="date"
                  id="releaseDate"
                  name="releaseDate"
                  value={dateValue(campaign?.releaseDate)}
                  class="preorder-input mt-2 w-[168px]"
                />
                <p class="preorder-help">
                  No controla la preventa. Es referencia tuya.
                </p>
              </div>
              <div>
                <label for="arrivalNotes" class="preorder-label">
                  Notas de recepción
                </label>
                <textarea
                  id="arrivalNotes"
                  name="arrivalNotes"
                  rows="4"
                  class="preorder-input preorder-textarea mt-2 w-full"
                >{campaign?.arrivalNotes ?? ""}</textarea>
                <p class="preorder-help">
                  Para cuando la caja llegue a tienda. El cliente no lo ve.
                </p>
              </div>
            </div>
          </details>
        </div>

        <aside class="hidden lg:block">
          <div class="sticky top-36 rounded-[14px] border border-[#18181B] bg-[#09090B] p-6">
            <AdminPreorderReceipt
              productName={productName}
              productImage={productImage || null}
              productPriceLabel={productPrice ? formatPrice(productPrice) : ""}
              hoyLabel={formatPrice(dueNow)}
              despuesLabel={despuesLabel}
              etaLabel={etaLabel}
              etaRangeLabel={etaRange}
              windowLabel={
                campaign?.opensAt || campaign?.closesAt
                  ? `Se puede reservar ${formatDisplayDate(campaign?.opensAt) || "—"} – ${formatDisplayDate(campaign?.closesAt) || "—"}`
                  : "Mientras esté en vitrina."
              }
              slotsLabel={slotsLabel}
            />
          </div>
        </aside>
      </div>

      {
        isEditing && campaign && (
          <section class="mt-16 border-t border-[#18181B] pt-8">
            <h2 class="text-[14px] font-semibold leading-5 text-[#FAFAFA]">
              Eliminar esta preventa
            </h2>
            <p class="mt-2 max-w-[520px] text-[13px] leading-5 text-[#71717A]">
