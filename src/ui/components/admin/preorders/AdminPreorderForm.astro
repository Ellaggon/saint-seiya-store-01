              hay reservas pagadas, no se podrá.
            </p>
            <button
              type="button"
              data-preorder-delete-open
              data-campaign-id={campaign.id}
              data-product-name={productName}
              data-has-reservations={hasReservations ? "true" : "false"}
              class="mt-4 inline-flex h-9 items-center rounded-md border border-[#7F1D1D] px-3.5 text-[13px] font-medium leading-[18px] text-[#F87171] transition-colors duration-150 hover:bg-[rgba(248,113,113,0.08)]"
            >
              Eliminar preventa
            </button>
          </section>
        )
      }
    </div>

    <div
      class="fixed inset-x-0 bottom-0 z-20 flex h-16 items-center gap-2 border-t border-[#18181B] bg-black px-4 lg:hidden"
    >
      <button type="button" data-discard class="preorder-ghost h-11">
        Descartar
      </button>
      <button type="submit" data-save class="preorder-save inline-flex h-11 flex-1">
        {isEditing ? "Guardar cambios" : "Crear preventa"}
      </button>
    </div>
  </form>

  <dialog
    data-receipt-dialog
    class="w-[calc(100%-2rem)] max-w-md rounded-[14px] border border-[#27272A] bg-[#09090B] p-6 text-white backdrop:bg-black/70"
  >
    <div class="mb-4 flex items-center justify-between">
      <p class="text-[13px] font-medium text-[#A1A1AA]">Recibo</p>
      <button
        type="button"
        data-receipt-close
        class="text-[13px] text-[#71717A] hover:text-[#FAFAFA]"
      >
        Cerrar
      </button>
    </div>
    <AdminPreorderReceipt
      productName={productName}
      productImage={productImage || null}
      productPriceLabel={productPrice ? formatPrice(productPrice) : ""}
      hoyLabel={formatPrice(dueNow)}
      despuesLabel={despuesLabel}
      etaLabel={etaLabel}
      etaRangeLabel={etaRange}
      windowLabel={
        campaign?.opensAt || campaign?.closesAt
          ? `Se puede reservar ${formatDisplayDate(campaign?.opensAt) || "—"} – ${formatDisplayDate(campaign?.closesAt) || "—"}`
          : "Mientras esté en vitrina."
      }
      slotsLabel={slotsLabel}
    />
  </dialog>

  {isEditing && <AdminPreorderDeleteDialog />}

  <div
    id="preorder-toast"
    class="pointer-events-none fixed bottom-20 left-1/2 z-40 hidden -translate-x-1/2 rounded-md border border-[#27272A] bg-[#09090B] px-4 py-2.5 text-[13px] font-medium leading-[18px] text-[#FAFAFA] lg:bottom-8"
    role="status"
  >
    {isEditing ? "Preventa actualizada" : "Preventa creada"}
  </div>
</div>

{
