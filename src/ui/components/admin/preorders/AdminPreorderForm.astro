---
import type { ProductDTO } from "@/application/dto/catalog.dto";
import type { PreorderDetailDTO } from "@/application/dto/preorder.dto";
import { formatPrice } from "@/lib/utils";

interface Props {
  products: ProductDTO[];
  preorder?: PreorderDetailDTO | null;
  error?: string | null;
}

const { products, preorder = null, error = null } = Astro.props;
const campaign = preorder?.campaign;
const isEditing = Boolean(campaign);
const hasReservations = (campaign?.reservedUnits ?? 0) > 0;

const dateValue = (value?: string | null): string =>
  value ? value.slice(0, 10) : "";

const selectedProduct = products.find(
  (product) => product.id === campaign?.productId,
);

const selectedProductPrice = selectedProduct?.price ?? preorder?.product.price ?? 0;

const depositOptions = [
  {
    value: "PERCENT",
    label: "Porcentaje del precio",
    description: "El cliente paga un porcentaje del total para reservar.",
  },
  {
    value: "FIXED",
    label: "Monto fijo",
    description: "El cliente paga un monto fijo por reserva.",
  },
  {
    value: "FULL",
    label: "Pago total obligatorio",
    description: "El cliente paga el total del producto al reservar.",
  },
];

const statusOptions = [
  { value: "DRAFT", label: "Borrador" },
  { value: "ACTIVE", label: "Activa" },
  { value: "PAUSED", label: "Pausada" },
  { value: "SOLD_OUT", label: "Agotada" },
  { value: "ARRIVED", label: "Llegó a tienda" },
  { value: "CLOSED", label: "Cerrada" },
  { value: "CANCELED", label: "Cancelada" },
];
---

{error && (
  <div class="border border-red-500/30 bg-red-500/5 text-red-400 px-5 py-4 text-xs font-bold uppercase tracking-widest mb-8">
    {error}
  </div>
)}

<form
  action="/admin/preorders/actions"
  method="POST"
  onsubmit="this.querySelector('button[type=submit]').disabled = true;"
  class="space-y-8"
>
  <input type="hidden" name="_action" value={isEditing ? "update" : "create"} />
  {campaign && <input type="hidden" name="id" value={campaign.id} />}
  {isEditing && <input type="hidden" name="productId" value={campaign?.productId} />}

  <section class="bg-zinc-950 p-8 border border-zinc-900 shadow-2xl space-y-6">
    <div class="space-y-2">
      <p class="text-amber-500 text-[10px] font-black uppercase tracking-[0.4em]">
        Producto y cupos
      </p>
      <h2 class="text-white text-xl font-black uppercase tracking-widest">
        Qué se va a reservar
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="space-y-2 md:col-span-2">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <label for="productId" class="block text-[10px] font-black text-amber-500 uppercase tracking-widest">Producto en preventa</label>
          {!isEditing && (
            <a
              href="/admin/products/new?returnTo=/admin/preorders/new"
              class="inline-flex items-center justify-center border border-zinc-800 text-zinc-300 hover:text-black hover:bg-amber-500 hover:border-amber-500 px-4 py-2 text-[10px] font-black uppercase tracking-widest transition-colors"
            >
              Crear producto
            </a>
          )}
        </div>
        <select
          id="productId"
          name="productId"
          required
          disabled={isEditing}
          data-selected-price={selectedProductPrice}
          class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors appearance-none disabled:text-zinc-500"
        >
          <option value="" disabled selected={!isEditing} data-price="0">Seleccionar producto...</option>
          {
            products.map((product) => (
              <option
                value={product.id}
                selected={product.id === campaign?.productId}
                data-price={product.price}
              >
                {product.name} - {formatPrice(product.price)}
              </option>
            ))
          }
        </select>
        <p class="text-zinc-600 text-[10px] uppercase tracking-widest leading-relaxed">
          Solo aparecen productos publicados o marcados como preventa. Si todavía no existe, créalo primero y vuelve a esta pantalla.
        </p>
      </div>

      <div class="space-y-2">
        <label for="totalSlots" class="block text-[10px] font-black text-amber-500 uppercase tracking-widest">Unidades disponibles para preventa</label>
        <input
          type="number"
          id="totalSlots"
          name="totalSlots"
          min={Math.max(1, campaign?.reservedUnits ?? 1)}
          value={campaign?.totalSlots ?? ""}
          required
          class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors"
        />
        <p class="text-zinc-600 text-[10px] uppercase tracking-widest leading-relaxed">
          Capacidad de esta campaña. No modifica el stock normal del catálogo.
        </p>
        {hasReservations && (
          <p class="text-zinc-500 text-[10px] uppercase tracking-widest">
            No puede bajar de {campaign?.reservedUnits} unidades ya reservadas.
          </p>
        )}
      </div>

      <div class="space-y-2">
        <label class="block text-[10px] font-black text-amber-500 uppercase tracking-widest">Máximo por cliente</label>
        <div class="w-full bg-black border border-zinc-800 px-4 py-3 text-zinc-600 text-sm">
          Próximamente
        </div>
        <p class="text-zinc-600 text-[10px] uppercase tracking-widest leading-relaxed">
          Recomendado para operación real, pero todavía no está guardado en la base de datos.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-zinc-950 p-8 border border-zinc-900 shadow-2xl space-y-6">
    <div class="space-y-2">
      <p class="text-amber-500 text-[10px] font-black uppercase tracking-[0.4em]">
        Pago del cliente
      </p>
      <h2 class="text-white text-xl font-black uppercase tracking-widest">
        Cuánto paga para reservar
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="space-y-2">
        <label for="depositType" class="block text-[10px] font-black text-amber-500 uppercase tracking-widest">Forma de abono</label>
        <select
          id="depositType"
          name="depositType"
          disabled={hasReservations}
          class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors appearance-none disabled:text-zinc-500"
        >
          {depositOptions.map((option) => (
            <option
              value={option.value}
              selected={option.value === (campaign?.depositType ?? "PERCENT")}
              data-description={option.description}
            >
              {option.label}
            </option>
          ))}
        </select>
        <p id="depositTypeHelp" class="text-zinc-600 text-[10px] uppercase tracking-widest leading-relaxed">
          El cliente paga un porcentaje del total para reservar.
        </p>
        {hasReservations && <input type="hidden" name="depositType" value={campaign?.depositType} />}
      </div>

      <div id="depositValueField" class="space-y-2">
        <label id="depositValueLabel" for="depositValue" class="block text-[10px] font-black text-amber-500 uppercase tracking-widest">Porcentaje de abono</label>
        <div class="relative">
          <input
            type="number"
            id="depositValue"
            name="depositValue"
            min="0"
            step="0.01"
            value={campaign?.depositValue ?? ""}
            required
            readonly={hasReservations}
            class="w-full bg-black border border-zinc-800 px-4 py-3 pr-12 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors read-only:text-zinc-500"
          />
          <span id="depositValueSuffix" class="absolute right-4 top-1/2 -translate-y-1/2 text-zinc-500 text-xs font-black">
            %
          </span>
        </div>
        <p id="depositValueHelp" class="text-zinc-600 text-[10px] uppercase tracking-widest leading-relaxed">
          Ejemplo: 30 significa que el cliente paga el 30% ahora y el resto queda pendiente.
        </p>
        {hasReservations && (
          <p class="text-zinc-500 text-[10px] uppercase tracking-widest">
            Bloqueado porque ya existen reservas.
          </p>
        )}
      </div>

      <div class="space-y-2 md:col-span-2">
        <label class="block text-[10px] font-black text-amber-500 uppercase tracking-widest">Pago total</label>
        <label class="flex items-start gap-3 bg-black border border-zinc-800 px-4 py-3 text-white text-xs font-bold uppercase tracking-widest">
          <input type="checkbox" name="allowFullPayment" checked={campaign?.allowFullPayment ?? true} class="accent-amber-500 mt-0.5" />
          <span>
            Permitir pagar el total al reservar
            <small class="block text-zinc-600 text-[10px] leading-relaxed mt-2">
              Si está activo, el cliente puede pagar el 100% aunque exista un abono mínimo.
            </small>
          </span>
        </label>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4 border border-zinc-900 bg-black p-5">
      <div>
        <p class="text-zinc-600 text-[9px] font-black uppercase tracking-[0.25em]">Paga hoy</p>
        <p id="previewDueNow" class="text-amber-500 text-lg font-black mt-2">$0</p>
      </div>
      <div>
        <p class="text-zinc-600 text-[9px] font-black uppercase tracking-[0.25em]">Saldo pendiente</p>
        <p id="previewBalance" class="text-white text-lg font-black mt-2">$0</p>
      </div>
      <div>
        <p class="text-zinc-600 text-[9px] font-black uppercase tracking-[0.25em]">Llegada visible</p>
        <p id="previewEta" class="text-white text-xs font-black uppercase tracking-widest mt-2">Sin informar</p>
      </div>
      <div>
        <p class="text-zinc-600 text-[9px] font-black uppercase tracking-[0.25em]">Cupos</p>
        <p id="previewSlots" class="text-white text-lg font-black mt-2">0</p>
      </div>
    </div>
  </section>

  <section class="bg-zinc-950 p-8 border border-zinc-900 shadow-2xl space-y-6">
    <div class="space-y-2">
      <p class="text-amber-500 text-[10px] font-black uppercase tracking-[0.4em]">
        Fechas de preventa
      </p>
      <h2 class="text-white text-xl font-black uppercase tracking-widest">
        Cuándo se puede reservar
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="space-y-2">
        <label for="opensAt" class="block text-[10px] font-black text-amber-500 uppercase tracking-widest">Inicio de preventa</label>
        <input type="date" id="opensAt" name="opensAt" value={dateValue(campaign?.opensAt)} class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors" />
        <p class="text-zinc-600 text-[10px] uppercase tracking-widest leading-relaxed">
          Antes de esta fecha no se aceptan reservas aunque la campaña esté activa.
        </p>
      </div>

      <div class="space-y-2">
        <label for="closesAt" class="block text-[10px] font-black text-amber-500 uppercase tracking-widest">Cierre de preventa</label>
        <input type="date" id="closesAt" name="closesAt" value={dateValue(campaign?.closesAt)} class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors" />
        <p class="text-zinc-600 text-[10px] uppercase tracking-widest leading-relaxed">
          Después de esta fecha la campaña deja de recibir reservas.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-zinc-950 p-8 border border-zinc-900 shadow-2xl space-y-6">
    <div class="space-y-2">
      <p class="text-amber-500 text-[10px] font-black uppercase tracking-[0.4em]">
        Llegada estimada
      </p>
      <h2 class="text-white text-xl font-black uppercase tracking-widest">
        Qué verá el cliente sobre la entrega
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="space-y-2 md:col-span-2">
        <label for="etaLabel" class="block text-[10px] font-black text-amber-500 uppercase tracking-widest">Texto visible de llegada</label>
        <input
          type="text"
          id="etaLabel"
          name="etaLabel"
          value={campaign?.etaLabel ?? ""}
          placeholder="Ej: Llegada estimada octubre 2026"
          class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors"
        />
        <p class="text-zinc-600 text-[10px] uppercase tracking-widest leading-relaxed">
          Mensaje principal que se muestra al cliente. Es más claro que una fecha suelta.
        </p>
      </div>

      <div class="space-y-2">
        <label for="etaStart" class="block text-[10px] font-black text-amber-500 uppercase tracking-widest">Llegada estimada desde</label>
        <input type="date" id="etaStart" name="etaStart" value={dateValue(campaign?.etaStart)} class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors" />
      </div>

      <div class="space-y-2">
        <label for="etaEnd" class="block text-[10px] font-black text-amber-500 uppercase tracking-widest">Llegada estimada hasta</label>
        <input type="date" id="etaEnd" name="etaEnd" value={dateValue(campaign?.etaEnd)} class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors" />
      </div>
    </div>

    <details class="border border-zinc-900 bg-black">
      <summary class="cursor-pointer px-4 py-3 text-zinc-400 hover:text-white text-[10px] font-black uppercase tracking-widest">
        Fechas avanzadas
      </summary>
      <div class="border-t border-zinc-900 p-4 space-y-2">
        <label for="releaseDate" class="block text-[10px] font-black text-amber-500 uppercase tracking-widest">Fecha oficial de lanzamiento</label>
        <input type="date" id="releaseDate" name="releaseDate" value={dateValue(campaign?.releaseDate)} class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors" />
        <p class="text-zinc-600 text-[10px] uppercase tracking-widest leading-relaxed">
          Fecha anunciada por el fabricante o proveedor. No controla apertura, cierre ni disponibilidad de reservas.
        </p>
      </div>
    </details>
  </section>

  <section class="bg-zinc-950 p-8 border border-zinc-900 shadow-2xl space-y-6">
    <div class="space-y-2">
      <p class="text-amber-500 text-[10px] font-black uppercase tracking-[0.4em]">
        Condiciones
      </p>
      <h2 class="text-white text-xl font-black uppercase tracking-widest">
        Reglas comerciales de la preventa
      </h2>
    </div>

    <div class="space-y-2">
      <label for="terms" class="block text-[10px] font-black text-amber-500 uppercase tracking-widest">Condiciones de la preventa</label>
      <textarea
        id="terms"
        name="terms"
        rows="4"
        placeholder="Ej: El abono confirma la reserva. El saldo se paga cuando el producto llegue a tienda."
        class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors"
      >{campaign?.terms ?? ""}</textarea>
      <p class="text-zinc-600 text-[10px] uppercase tracking-widest leading-relaxed">
        Este texto puede mostrarse al cliente en la ficha de producto.
      </p>
    </div>

    <details class="border border-zinc-900 bg-black">
      <summary class="cursor-pointer px-4 py-3 text-zinc-400 hover:text-white text-[10px] font-black uppercase tracking-widest">
        Recepción interna
      </summary>
      <div class="border-t border-zinc-900 p-4 space-y-2">
        <label for="arrivalNotes" class="block text-[10px] font-black text-amber-500 uppercase tracking-widest">Notas internas de recepción</label>
        <textarea id="arrivalNotes" name="arrivalNotes" rows="3" class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors">{campaign?.arrivalNotes ?? ""}</textarea>
        <p class="text-zinc-600 text-[10px] uppercase tracking-widest leading-relaxed">
          Útil cuando el producto llega a tienda. No debería reemplazar las condiciones visibles para el cliente.
        </p>
      </div>
    </details>
  </section>

  <section class="bg-zinc-950 p-8 border border-zinc-900 shadow-2xl space-y-6">
    <div class="space-y-2">
      <p class="text-amber-500 text-[10px] font-black uppercase tracking-[0.4em]">
        Publicación
      </p>
      <h2 class="text-white text-xl font-black uppercase tracking-widest">
        Estado de la campaña
      </h2>
    </div>

    {isEditing ? (
      <div class="space-y-2">
        <label for="status" class="block text-[10px] font-black text-amber-500 uppercase tracking-widest">Estado</label>
        <select id="status" name="status" class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors appearance-none">
          {statusOptions.map((status) => (
            <option value={status.value} selected={status.value === campaign?.status}>{status.label}</option>
          ))}
        </select>
        <p class="text-zinc-600 text-[10px] uppercase tracking-widest leading-relaxed">
          Activa permite reservas si las fechas de preventa también lo permiten.
        </p>
      </div>
    ) : (
      <div class="border border-zinc-900 bg-black px-4 py-4">
        <p class="text-white text-xs font-black uppercase tracking-widest">Se creará como borrador</p>
        <p class="text-zinc-600 text-[10px] uppercase tracking-widest leading-relaxed mt-2">
          Después podrás revisarla y activarla desde la edición de campaña.
        </p>
      </div>
    )}

    <div class="flex flex-col sm:flex-row gap-4 pt-4 border-t border-zinc-900">
      <button type="submit" class="bg-white text-black text-[11px] font-black uppercase tracking-widest px-8 py-4 hover:bg-amber-500 transition-colors duration-300">
        {isEditing ? "Guardar Preventa" : "Crear Preventa"}
      </button>
      <a href="/admin/preorders" class="inline-flex items-center justify-center border border-zinc-800 text-zinc-400 text-[11px] font-black uppercase tracking-widest px-8 py-4 hover:text-white hover:border-zinc-600 transition-colors">
        Cancelar
      </a>
    </div>
  </section>
</form>

<script>
  const productSelect = document.getElementById("productId") as HTMLSelectElement | null;
  const depositTypeSelect = document.getElementById("depositType") as HTMLSelectElement | null;
  const depositTypeHelp = document.getElementById("depositTypeHelp");
  const depositValueField = document.getElementById("depositValueField");
  const depositValueInput = document.getElementById("depositValue") as HTMLInputElement | null;
  const depositValueLabel = document.getElementById("depositValueLabel");
  const depositValueHelp = document.getElementById("depositValueHelp");
  const depositValueSuffix = document.getElementById("depositValueSuffix");
  const totalSlotsInput = document.getElementById("totalSlots") as HTMLInputElement | null;
  const etaLabelInput = document.getElementById("etaLabel") as HTMLInputElement | null;
  const etaStartInput = document.getElementById("etaStart") as HTMLInputElement | null;
  const releaseDateInput = document.getElementById("releaseDate") as HTMLInputElement | null;
  const previewDueNow = document.getElementById("previewDueNow");
  const previewBalance = document.getElementById("previewBalance");
  const previewEta = document.getElementById("previewEta");
  const previewSlots = document.getElementById("previewSlots");
  const isDepositLocked = Boolean(document.querySelector('input[type="hidden"][name="depositType"]'));

  const moneyFormatter = new Intl.NumberFormat("es-CL", {
    style: "currency",
    currency: "CLP",
    maximumFractionDigits: 0,
  });

  const getSelectedProductPrice = (): number => {
    if (!productSelect) return 0;
    const option = productSelect.selectedOptions[0];
    const optionPrice = Number(option?.dataset.price ?? 0);
    const selectedPrice = Number(productSelect.dataset.selectedPrice ?? 0);
    return Number.isFinite(optionPrice) && optionPrice > 0 ? optionPrice : selectedPrice;
  };

  const calculateDeposit = (price: number, type: string, value: number): number => {
    if (type === "FULL") return price;
    if (type === "FIXED") return Math.min(value, price);
    return Math.min(price * (value / 100), price);
  };

  const updateDepositControls = () => {
    const type = depositTypeSelect?.value ?? "PERCENT";
    const selectedOption = depositTypeSelect?.selectedOptions[0];
    if (depositTypeHelp) {
      depositTypeHelp.textContent =
        selectedOption?.dataset.description ?? "Define cuánto paga el cliente al reservar.";
    }

    if (!depositValueField || !depositValueInput || !depositValueLabel || !depositValueHelp || !depositValueSuffix) {
      return;
    }

    if (type === "FULL") {
      depositValueField.classList.add("opacity-60");
      if (!isDepositLocked) {
        depositValueInput.value = "0";
      }
      depositValueInput.readOnly = true;
      depositValueLabel.textContent = "Valor de abono";
      depositValueSuffix.textContent = "";
      depositValueHelp.textContent = "No se solicita un abono separado: el cliente paga el total al reservar.";
      return;
    }

    depositValueField.classList.remove("opacity-60");
    if (!depositValueField.querySelector("p.text-zinc-500")) {
      depositValueInput.readOnly = false;
    }

    if (type === "FIXED") {
      depositValueLabel.textContent = "Monto de abono";
      depositValueSuffix.textContent = "$";
      depositValueHelp.textContent = "Monto fijo que el cliente paga ahora. No puede superar el precio del producto.";
      return;
    }

    depositValueLabel.textContent = "Porcentaje de abono";
    depositValueSuffix.textContent = "%";
    depositValueHelp.textContent = "Ejemplo: 30 significa que el cliente paga el 30% ahora y el resto queda pendiente.";
  };

  const updatePreview = () => {
    const price = getSelectedProductPrice();
    const type = depositTypeSelect?.value ?? "PERCENT";
    const value = Number(depositValueInput?.value ?? 0);
    const deposit = calculateDeposit(price, type, Number.isFinite(value) ? value : 0);
    const balance = Math.max(price - deposit, 0);
    const slots = Number(totalSlotsInput?.value ?? 0);
    const eta =
      etaLabelInput?.value.trim() ||
      etaStartInput?.value ||
      releaseDateInput?.value ||
      "Sin informar";

    if (previewDueNow) previewDueNow.textContent = moneyFormatter.format(deposit);
    if (previewBalance) previewBalance.textContent = moneyFormatter.format(balance);
    if (previewEta) previewEta.textContent = eta;
    if (previewSlots) previewSlots.textContent = Number.isFinite(slots) && slots > 0 ? String(slots) : "0";
  };

  const syncForm = () => {
    updateDepositControls();
    updatePreview();
  };

  [
    productSelect,
    depositTypeSelect,
    depositValueInput,
    totalSlotsInput,
    etaLabelInput,
    etaStartInput,
    releaseDateInput,
  ].forEach((element) => {
    element?.addEventListener("input", syncForm);
    element?.addEventListener("change", syncForm);
  });

  syncForm();
</script>
