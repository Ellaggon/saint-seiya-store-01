---
/**
 * Compact category selector for the public catalog.
 */
interface Props {
  categories: {
    id: string;
    name: string;
    slug: string;
    imageUrl?: string | null;
  }[];
  currentCategory?: string;
  getCategoryUrl: (slug?: string) => string;
}

const { categories, currentCategory, getCategoryUrl } = Astro.props;
---

<div class="bg-black border-y border-zinc-900">
  <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-5">
    <div class="flex items-center gap-3 overflow-x-auto pb-1">
      <span class="text-zinc-500 text-sm font-medium flex-shrink-0">
        Categorías
      </span>
      <a
        href={getCategoryUrl()}
        data-filter-link
        data-category-card
        class={`flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium transition-colors ${
          !currentCategory
            ? "bg-white text-black"
            : "bg-zinc-950 text-zinc-400 hover:text-white"
        }`}
      >
        Todas
      </a>
      {categories.map((cat) => (
        <a
          href={getCategoryUrl(cat.slug)}
          data-filter-link
          data-category-card
          class={`flex-shrink-0 rounded-full px-4 py-2 text-sm font-medium transition-colors ${
            currentCategory === cat.slug
              ? "bg-white text-black"
              : "bg-zinc-950 text-zinc-400 hover:text-white"
          }`}
        >
          {cat.name}
        </a>
      ))}
    </div>
  </div>
</div>

<script>
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const card = target.closest("[data-category-card]");
    
    if (card) {
      const marketplace = document.getElementById("catalog-marketplace");
      if (marketplace) {
        setTimeout(() => {
          marketplace.scrollIntoView({
            behavior: "smooth",
            block: "start"
          });
        }, 120);
      }
    }
  });
</script>
