---
import ProductCard from "./ProductCard.astro";
import type { ProductCardViewModel } from "./productCardViewModel";

interface Props {
  products: ProductCardViewModel[];
}

const { products } = Astro.props;
---

<div class="catalog-products-grid grid grid-cols-1 gap-8 sm:grid-cols-2 md:gap-8 xl:grid-cols-4 xl:gap-10 2xl:grid-cols-5">
  {products.map((product) => <ProductCard product={product} />)}
</div>
