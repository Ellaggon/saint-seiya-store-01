---
import ProductCard from "./ProductCard.astro";
import type { ProductCardViewModel } from "./productCardViewModel";

interface Props {
  products: ProductCardViewModel[];
}

const { products } = Astro.props;
---

<div class="catalog-products-grid grid grid-cols-1 gap-5 md:gap-6 lg:grid-cols-2 xl:grid-cols-3 xl:gap-10 2xl:grid-cols-4">
  {products.map((product) => <ProductCard product={product} />)}
</div>
