---
import ProductCard from "./ProductCard.astro";
import type { ProductCardViewModel } from "./productCardViewModel";

interface Props {
  products: ProductCardViewModel[];
}

const { products } = Astro.props;
---

<div class="catalog-products-grid grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 md:gap-10">
  {products.map((product) => <ProductCard product={product} />)}
</div>
