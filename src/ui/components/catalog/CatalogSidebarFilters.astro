---
interface Props {
  metadata: {
    categories: { name: string; slug: string; count: number }[];
    collections: { name: string; slug: string; count: number }[];
  } | null;
  currentFilters: {
    category?: string;
    collection?: string;
    availability?: string;
    status?: string;
    q?: string;
    minPrice?: number;
    maxPrice?: number;
    showSoldOut?: boolean;
    openPreorders?: boolean;
    sort?: string;
    page?: number;
    pageSize?: number;
  };
}

const { metadata, currentFilters } = Astro.props;

const availabilityOptions = [
  { name: "Disponible ahora", value: "available" },
  { name: "Preventas abiertas", value: "preorder-open" },
  { name: "Agotados", value: "out-of-stock" },
];

// Helper to build filter URL
const getFilterUrl = (key: string, value: string | null) => {
  const url = new URL(Astro.url.pathname, Astro.url.origin);
  const params = new URLSearchParams(Astro.url.search);

  if (value === null) {
    params.delete(key);
  } else {
    params.set(key, value);
  }
  params.delete("page");

  return `${url.pathname}?${params.toString()}`;
};

const getAvailabilityUrl = (value: string | null) => {
  const url = new URL(Astro.url.pathname, Astro.url.origin);
  const params = new URLSearchParams(Astro.url.search);

  params.delete("status");
  params.delete("openPreorders");
  params.delete("showSoldOut");

  if (value === null) {
    params.delete("availability");
  } else {
    params.set("availability", value);
  }
  params.delete("page");

  const search = params.toString();
  return `${url.pathname}${search ? `?${search}` : ""}`;
};

const hasActiveFilters = Boolean(
  currentFilters.category ||
    currentFilters.collection ||
    currentFilters.availability ||
    currentFilters.status ||
    currentFilters.q ||
    currentFilters.minPrice !== undefined ||
    currentFilters.maxPrice !== undefined ||
    currentFilters.showSoldOut ||
    currentFilters.openPreorders,
);
---

<aside class="w-full lg:w-[280px] flex-shrink-0">
  <input type="checkbox" id="filter-toggle" class="peer sr-only" />

  <label
    for="filter-toggle"
    class="lg:hidden flex items-center justify-between border border-zinc-900 bg-zinc-950 px-5 py-4 cursor-pointer hover:border-zinc-700 transition-colors mb-8 group"
  >
    <span
      class="text-white font-semibold text-sm group-hover:text-amber-400 transition-colors"
      >Filtros</span
    >
    <span class="text-amber-500 text-lg leading-none">+</span>
  </label>

  <!-- Filter content -->
  <div
    class="hidden peer-checked:block lg:block space-y-7 animate-in fade-in slide-in-from-top-4 duration-300"
  >
    {
      hasActiveFilters && (
        <a
          href="/catalog"
          data-filter-link
          class="inline-flex text-zinc-400 text-sm font-medium hover:text-white transition-colors"
        >
          Limpiar filtros
        </a>
      )
    }

    <section class="space-y-3">
      <h3 class="text-white text-sm font-semibold">Estado de compra</h3>
      <ul class="space-y-1">
        {
          availabilityOptions.map((option) => (
            <li>
              <a
                href={getAvailabilityUrl(
                  currentFilters.availability === option.value ? null : option.value,
                )}
                data-filter-link
                class={`flex items-center justify-between rounded-md px-3 py-2 text-sm transition-colors ${
                  currentFilters.availability === option.value
                    ? "bg-white text-black"
                    : "text-zinc-400 hover:bg-zinc-950 hover:text-white"
                }`}
              >
                <span>{option.name}</span>
                {currentFilters.availability === option.value && (
                  <span aria-hidden="true">✓</span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <form
      action="/catalog"
      method="get"
      data-catalog-filter-form
      class="space-y-4 border-t border-zinc-900 pt-6"
    >
      {currentFilters.q && <input type="hidden" name="q" value={currentFilters.q} />}
      {currentFilters.category && <input type="hidden" name="category" value={currentFilters.category} />}
      {currentFilters.collection && <input type="hidden" name="collection" value={currentFilters.collection} />}
      {currentFilters.availability && <input type="hidden" name="availability" value={currentFilters.availability} />}
      {currentFilters.status && <input type="hidden" name="status" value={currentFilters.status} />}
      {currentFilters.sort && <input type="hidden" name="sort" value={currentFilters.sort} />}

      <h3 class="text-white text-sm font-semibold">Precio</h3>

      <div class="grid grid-cols-2 gap-3">
        <label class="flex flex-col gap-2">
          <span class="text-zinc-500 text-xs font-medium">Desde Bs</span>
          <input
            type="number"
            min="0"
            step="1"
            name="minPrice"
            value={currentFilters.minPrice ?? ""}
            class="bg-black border border-zinc-800 text-white text-sm px-3 py-3 focus:outline-none focus:border-zinc-500"
          />
        </label>
        <label class="flex flex-col gap-2">
          <span class="text-zinc-500 text-xs font-medium">Hasta Bs</span>
          <input
            type="number"
            min="0"
            step="1"
            name="maxPrice"
            value={currentFilters.maxPrice ?? ""}
            class="bg-black border border-zinc-800 text-white text-sm px-3 py-3 focus:outline-none focus:border-zinc-500"
          />
        </label>
      </div>

      <button
        type="submit"
        class="w-full rounded-md bg-white text-black text-sm font-semibold px-4 py-3 hover:bg-zinc-200 transition-colors"
      >
        Aplicar
      </button>
    </form>

    <details open class="group/section border-t border-zinc-900 pt-5">
      <summary
        class="flex items-center justify-between cursor-pointer list-none py-3 border-b border-zinc-900"
      >
        <h3
          class="text-white text-sm font-semibold"
        >
          Colección
        </h3>
        <span
          class="text-zinc-500 text-xs transition-transform group-open/section:rotate-45"
          >+</span
        >
      </summary>
      <ul class="flex flex-col gap-1 mt-3">
        {
          metadata?.collections.map((coll) => (
            <li>
              <a
                href={getFilterUrl("collection", coll.slug)}
                data-filter-link
                class={`group/item block rounded-md px-3 py-2 transition-colors ${
                  currentFilters.collection === coll.slug
                    ? "bg-white"
                    : "hover:bg-zinc-950"
                }`}
              >
                <span
                  class={`text-sm transition-colors flex items-center justify-between ${
                    currentFilters.collection === coll.slug
                      ? "text-black font-medium"
                      : "text-zinc-400 group-hover/item:text-white"
                  }`}
                >
                  <span class="flex items-center gap-2">
                    {coll.name}
                    <span
                      class={`text-xs ${
                        currentFilters.collection === coll.slug
                          ? "text-black/50"
                          : "text-zinc-600"
                      }`}
                    >
                      ({coll.count})
                    </span>
                  </span>
                  {currentFilters.collection === coll.slug && (
                    <span aria-hidden="true">✓</span>
                  )}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </details>

  </div>
</aside>
