---
interface Props {
  metadata: {
    categories: { name: string; slug: string; count: number }[];
    collections: { name: string; slug: string; count: number }[];
  } | null;
  currentFilters: {
    category?: string;
    collection?: string;
    availability?: string;
    status?: string;
    q?: string;
    minPrice?: number;
    maxPrice?: number;
    showSoldOut?: boolean;
    openPreorders?: boolean;
    sort?: string;
    page?: number;
    pageSize?: number;
  };
}

const { metadata, currentFilters } = Astro.props;

const sortOptions = [
  { value: "created-desc", label: "Más recientes" },
  { value: "price-asc", label: "Precio menor a mayor" },
  { value: "price-desc", label: "Precio mayor a menor" },
  { value: "name-asc", label: "Nombre A-Z" },
  { value: "eta-asc", label: "Llegada más próxima" },
];

// Helper to build filter URL
const getFilterUrl = (key: string, value: string | null) => {
  const url = new URL(Astro.url.pathname, Astro.url.origin);
  const params = new URLSearchParams(Astro.url.search);

  if (value === null) {
    params.delete(key);
  } else {
    params.set(key, value);
  }
  params.delete("page");

  return `${url.pathname}?${params.toString()}`;
};

const hasActiveFilters = Boolean(
  currentFilters.collection ||
    currentFilters.q ||
    currentFilters.minPrice !== undefined ||
    currentFilters.maxPrice !== undefined,
);

const getClearSidebarFiltersUrl = () => {
  const url = new URL(Astro.url.pathname, Astro.url.origin);
  const params = new URLSearchParams();

  if (currentFilters.category) params.set("category", currentFilters.category);
  if (currentFilters.q) params.set("q", currentFilters.q);
  if (currentFilters.sort) params.set("sort", currentFilters.sort);

  const search = params.toString();
  return `${url.pathname}${search ? `?${search}` : ""}`;
};
---

<aside class="w-full lg:w-[280px] flex-shrink-0">
  <input type="checkbox" id="filter-toggle" class="peer sr-only" />

  <label
    for="filter-toggle"
    class="lg:hidden mb-5 flex cursor-pointer items-center justify-between rounded-md border border-zinc-900 bg-zinc-950/80 px-4 py-3.5 transition-colors hover:border-zinc-700 md:mb-6 md:px-5 md:py-4 group"
  >
    <span
      class="text-white font-semibold text-sm group-hover:text-amber-400 transition-colors"
      >Filtros</span
    >
    <span class="text-amber-500 text-lg leading-none">+</span>
  </label>

  <!-- Filter content -->
  <div
    class="hidden peer-checked:block lg:block animate-in fade-in slide-in-from-top-4 duration-300"
  >
    {
      hasActiveFilters && (
        <a
          href={getClearSidebarFiltersUrl()}
          data-filter-link
          class="mb-6 inline-flex text-xs font-semibold text-zinc-500 transition-colors hover:text-white"
        >
          Limpiar filtros
        </a>
      )
    }

    <div class="space-y-8">
      <section class="space-y-3">
        <h3 class="text-[10px] font-black uppercase tracking-[0.22em] text-zinc-500">
          Ordenar
        </h3>
        <div class="relative">
          <select
            id="catalog-sort-select"
            name="sort"
            class="w-full appearance-none rounded-md border border-zinc-800 bg-black px-3 py-3 pr-10 text-sm font-semibold text-white transition-colors hover:border-zinc-600 focus:border-amber-500 focus:outline-none"
          >
            {
              sortOptions.map((option) => (
                <option
                  value={option.value}
                  selected={(currentFilters.sort || "created-desc") === option.value}
                >
                  {option.label}
                </option>
              ))
            }
          </select>
          <div
            class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-zinc-500"
          >
            <svg
              class="h-3 w-3 fill-current"
              viewBox="0 0 20 20"
              aria-hidden="true"
            >
              <path
                d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
              />
            </svg>
          </div>
        </div>
      </section>

    <form
      action="/catalog"
      method="get"
      data-catalog-filter-form
      class="space-y-4"
    >
      {currentFilters.q && <input type="hidden" name="q" value={currentFilters.q} />}
      {currentFilters.category && <input type="hidden" name="category" value={currentFilters.category} />}
      {currentFilters.collection && <input type="hidden" name="collection" value={currentFilters.collection} />}
      {currentFilters.sort && <input type="hidden" name="sort" value={currentFilters.sort} />}

      <h3 class="text-[10px] font-black uppercase tracking-[0.22em] text-zinc-500">
        Precio
      </h3>

      <div class="grid grid-cols-2 gap-2.5">
        <label class="flex flex-col gap-1.5">
          <span class="text-[10px] font-semibold uppercase tracking-wide text-zinc-600">
            Desde Bs
          </span>
          <input
            type="number"
            min="0"
            step="1"
            name="minPrice"
            value={currentFilters.minPrice ?? ""}
            class="rounded-md border border-zinc-800 bg-black px-3 py-3 text-sm text-white transition-colors focus:border-amber-500 focus:outline-none"
          />
        </label>
        <label class="flex flex-col gap-1.5">
          <span class="text-[10px] font-semibold uppercase tracking-wide text-zinc-600">
            Hasta Bs
          </span>
          <input
            type="number"
            min="0"
            step="1"
            name="maxPrice"
            value={currentFilters.maxPrice ?? ""}
            class="rounded-md border border-zinc-800 bg-black px-3 py-3 text-sm text-white transition-colors focus:border-amber-500 focus:outline-none"
          />
        </label>
      </div>

      <button
        type="submit"
        class="w-full rounded-md bg-amber-500 px-4 py-3 text-sm font-black text-black transition-colors hover:bg-amber-400"
      >
        Aplicar
      </button>
    </form>

    <details open class="group/section">
      <summary
        class="flex cursor-pointer list-none items-center justify-between py-1"
      >
        <h3
          class="text-[10px] font-black uppercase tracking-[0.22em] text-zinc-500"
        >
          Colección
        </h3>
        <span
          class="text-sm leading-none text-zinc-500 transition-transform group-open/section:rotate-45"
          >+</span
        >
      </summary>
      <ul class="mt-3 flex flex-col gap-1">
        {
          metadata?.collections.map((coll) => (
            <li>
              <a
                href={getFilterUrl("collection", coll.slug)}
                data-filter-link
                class={`group/item block rounded-md px-3 py-2.5 transition-colors ${
                  currentFilters.collection === coll.slug
                    ? "bg-amber-500"
                    : "hover:bg-zinc-950"
                }`}
              >
                <span
                  class={`text-sm transition-colors flex items-center justify-between ${
                    currentFilters.collection === coll.slug
                      ? "text-black font-medium"
                      : "text-zinc-400 group-hover/item:text-white"
                  }`}
                >
                  <span class="flex min-w-0 flex-1 items-center justify-between gap-3">
                    <span class="truncate">{coll.name}</span>
                    <span
                      class={`flex-none text-xs ${
                        currentFilters.collection === coll.slug
                          ? "text-black/50"
                          : "text-zinc-600"
                      }`}
                    >
                      ({coll.count})
                    </span>
                  </span>
                  {currentFilters.collection === coll.slug && (
                    <span aria-hidden="true">✓</span>
                  )}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </details>
    </div>

  </div>
</aside>
