---
import PreorderAvailabilityMeter from "../preorders/PreorderAvailabilityMeter.astro";
import PreorderBadge from "../preorders/PreorderBadge.astro";
import PreorderEta from "../preorders/PreorderEta.astro";
import { formatPrice } from "@/lib/utils";
import type { DisplayAvailability } from "@/shared/catalog/displayAvailability";

interface Props {
  product: {
    id: string;
    name: string;
    character: string;
    line: string;
    price: number;
    image: string;
    status: string;
    displayAvailability: DisplayAvailability;
    preorder?: {
      etaLabel?: string | null;
      availableUnits: number;
      totalUnits: number;
      depositAmount: number;
      isOpen: boolean;
    };
  };
}

const { product } = Astro.props;
const preorder = product.preorder;
const isPreorderSoldOut = preorder ? preorder.availableUnits <= 0 : false;
const availability = product.displayAvailability;
const isSoldOut =
  availability.code === "OUT_OF_STOCK" ||
  availability.code === "PREORDER_SOLD_OUT" ||
  availability.code === "UNAVAILABLE" ||
  isPreorderSoldOut;
const ctaLabel = availability.canReserve ? "Reservar preventa" : availability.canPurchase ? "Ver producto" : availability.label;
const availabilityBadgeClass = availability.canPurchase
  ? "border-emerald-400/25 bg-emerald-400/10 text-emerald-300"
  : "border-zinc-700/70 bg-black/70 text-zinc-400";
const availabilityDotClass = availability.canPurchase
  ? "bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.75)]"
  : "bg-zinc-500";
---

<a
  href={`/product/${product.id}`}
  class="group grid grid-cols-[112px_minmax(0,1fr)] gap-4 cursor-pointer sm:grid-cols-[150px_minmax(0,1fr)] md:grid-cols-[180px_minmax(0,1fr)] lg:flex lg:flex-col lg:gap-5"
  data-conversion-event="catalog_product_click"
  data-product-id={product.id}
  data-product-name={product.name}
  data-product-availability={availability.code}
>
  <div
    class="relative aspect-square w-full overflow-hidden rounded-[14px] bg-zinc-950 border border-zinc-900 group-hover:border-zinc-700 transition-colors duration-300 lg:aspect-[4/5] lg:rounded-[18px]"
  >
    <img
      src={product.image}
      alt={product.name}
      class="h-full w-full rounded-[inherit] object-cover opacity-90 transition-opacity duration-300 group-hover:opacity-100"
      loading="lazy"
    />

    <div class="absolute top-2 left-2 z-10 flex max-w-[calc(100%-1rem)] flex-col gap-2 lg:top-3 lg:left-3">
      {
        preorder ? (
          <PreorderBadge isOpen={preorder.isOpen} isSoldOut={isPreorderSoldOut} />
        ) : (
          <span
            class={`inline-flex max-w-full items-center gap-1.5 rounded-md border px-2 py-1.5 text-[8px] font-black uppercase tracking-[0.12em] shadow-[0_10px_30px_rgba(0,0,0,0.32)] backdrop-blur lg:gap-2 lg:px-3 lg:py-2 lg:text-[10px] lg:tracking-[0.18em] ${availabilityBadgeClass}`}
          >
            <span
              class={`h-1.5 w-1.5 rounded-full ${availabilityDotClass}`}
              aria-hidden="true"
            >
            </span>
            <span class="truncate">{availability.label}</span>
          </span>
        )
      }
      {
        product.status === "NEW" && (
          <span class="rounded-full bg-[#E60012] text-white text-xs font-semibold px-3 py-1">
            Nuevo
          </span>
        )
      }
    </div>
  </div>

  <div class="flex min-w-0 flex-col justify-between gap-3 py-0.5 lg:py-0">
    <div class="space-y-1">
      <p class="truncate text-xs font-medium text-zinc-500 lg:text-sm">{product.line}</p>
      <h3 class="text-base font-semibold leading-snug text-white lg:text-lg">
        {product.name}
      </h3>
      <p class="truncate text-xs text-zinc-400 lg:text-sm">{product.character}</p>
    </div>

    <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
      <span class="text-sm font-semibold text-white lg:text-base">
        {formatPrice(product.price)}
      </span>
      <span class="text-[9px] font-black uppercase tracking-[0.14em] text-zinc-600 lg:text-[10px] lg:tracking-[0.18em]">
        {availability.label}
      </span>
    </div>

    {
      preorder && (
        <div class="mt-1 flex flex-col gap-2 border-t border-zinc-900 pt-3 lg:mt-2 lg:gap-3 lg:pt-4">
          <PreorderEta etaLabel={preorder.etaLabel} />
          <PreorderAvailabilityMeter
            availableUnits={preorder.availableUnits}
            totalUnits={preorder.totalUnits}
          />
          <div class="flex items-center justify-between text-sm">
            <span class="text-zinc-500">Abono</span>
            <span class="text-amber-500 font-semibold">
              {formatPrice(preorder.depositAmount)}
            </span>
          </div>
        </div>
      )
    }
    <span
      class={`inline-flex items-center justify-center rounded-md px-3 py-2.5 text-xs font-semibold transition-colors lg:mt-2 lg:px-4 lg:py-3 lg:text-sm ${
        isSoldOut
          ? "text-zinc-500 bg-zinc-950 border border-zinc-900"
          : "text-black bg-white group-hover:bg-zinc-200"
      }`}
    >
      {ctaLabel}
    </span>
  </div>
</a>
