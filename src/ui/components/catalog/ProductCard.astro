---
import PreorderAvailabilityMeter from "../preorders/PreorderAvailabilityMeter.astro";
import PreorderBadge from "../preorders/PreorderBadge.astro";
import PreorderEta from "../preorders/PreorderEta.astro";
import { formatPrice } from "@/lib/utils";
import type { DisplayAvailability } from "@/shared/catalog/displayAvailability";

interface Props {
  product: {
    id: string;
    name: string;
    character: string;
    line: string;
    price: number;
    image: string;
    status: string;
    displayAvailability: DisplayAvailability;
    preorder?: {
      etaLabel?: string | null;
      availableUnits: number;
      totalUnits: number;
      depositAmount: number;
      isOpen: boolean;
    };
  };
}

const { product } = Astro.props;
const preorder = product.preorder;
const isPreorderSoldOut = preorder ? preorder.availableUnits <= 0 : false;
const availability = product.displayAvailability;
const isSoldOut =
  availability.code === "OUT_OF_STOCK" ||
  availability.code === "PREORDER_SOLD_OUT" ||
  availability.code === "UNAVAILABLE" ||
  isPreorderSoldOut;
const ctaLabel = availability.canReserve ? "Reservar preventa" : availability.canPurchase ? "Ver producto" : availability.label;
---

<a
  href={`/product/${product.id}`}
  class="group flex flex-col gap-5 cursor-pointer block"
  data-conversion-event="catalog_product_click"
  data-product-id={product.id}
  data-product-name={product.name}
  data-product-availability={availability.code}
>
  <div
    class="relative w-full aspect-[4/5] bg-zinc-950 border border-zinc-900 group-hover:border-zinc-700 transition-colors duration-300 overflow-hidden"
  >
    <img
      src={product.image}
      alt={product.name}
      class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity duration-300"
      loading="lazy"
    />

    <div class="absolute top-3 left-3 flex flex-col gap-2 z-10">
      {
        preorder ? (
          <PreorderBadge isOpen={preorder.isOpen} isSoldOut={isPreorderSoldOut} />
        ) : (
          <span
            class={`rounded-full text-xs font-semibold px-3 py-1 ${
              availability.canPurchase
                ? "bg-green-500 text-black"
                : "bg-zinc-800 text-zinc-400 border border-zinc-700"
            }`}
          >
            {availability.label}
          </span>
        )
      }
      {
        product.status === "NEW" && (
          <span class="rounded-full bg-[#E60012] text-white text-xs font-semibold px-3 py-1">
            Nuevo
          </span>
        )
      }
    </div>
  </div>

  <div class="flex flex-col gap-3">
    <div class="space-y-1">
      <p class="text-zinc-500 text-sm font-medium">{product.line}</p>
      <h3 class="text-white text-lg font-semibold leading-snug">
        {product.name}
      </h3>
      <p class="text-zinc-400 text-sm">{product.character}</p>
    </div>

    <div class="flex items-center justify-between gap-4">
      <span class="text-white text-base font-semibold">
        {formatPrice(product.price)}
      </span>
      <span class="text-zinc-500 text-sm">{availability.label}</span>
    </div>

    {
      preorder && (
        <div class="mt-2 flex flex-col gap-3 border-t border-zinc-900 pt-4">
          <PreorderEta etaLabel={preorder.etaLabel} />
          <PreorderAvailabilityMeter
            availableUnits={preorder.availableUnits}
            totalUnits={preorder.totalUnits}
          />
          <div class="flex items-center justify-between text-sm">
            <span class="text-zinc-500">Abono</span>
            <span class="text-amber-500 font-semibold">
              {formatPrice(preorder.depositAmount)}
            </span>
          </div>
        </div>
      )
    }
    <span
      class={`mt-2 inline-flex items-center justify-center rounded-md px-4 py-3 text-sm font-semibold transition-colors ${
        isSoldOut
          ? "text-zinc-500 bg-zinc-950 border border-zinc-900"
          : "text-black bg-white group-hover:bg-zinc-200"
      }`}
    >
      {ctaLabel}
    </span>
  </div>
</a>
