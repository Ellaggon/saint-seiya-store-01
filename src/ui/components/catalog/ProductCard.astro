---
import PreorderAvailabilityMeter from "../preorders/PreorderAvailabilityMeter.astro";
import PreorderBadge from "../preorders/PreorderBadge.astro";
import PreorderEta from "../preorders/PreorderEta.astro";
import { formatPrice } from "@/lib/utils";
import type { DisplayAvailability } from "@/shared/catalog/displayAvailability";

interface Props {
  product: {
    id: string;
    name: string;
    character: string;
    line: string;
    price: number;
    image: string;
    status: string;
    displayAvailability: DisplayAvailability;
    preorder?: {
      etaLabel?: string | null;
      availableUnits: number;
      totalUnits: number;
      depositAmount: number;
      isOpen: boolean;
    };
  };
}

const { product } = Astro.props;
const preorder = product.preorder;
const isPreorderSoldOut = preorder ? preorder.availableUnits <= 0 : false;
const availability = product.displayAvailability;
const isSoldOut =
  availability.code === "OUT_OF_STOCK" ||
  availability.code === "PREORDER_SOLD_OUT" ||
  availability.code === "UNAVAILABLE" ||
  isPreorderSoldOut;
const ctaLabel = availability.canReserve ? "Reservar preventa" : availability.canPurchase ? "Ver producto" : availability.label;
const availabilityBadgeClass = availability.canPurchase
  ? "border-emerald-400/25 bg-emerald-400/10 text-emerald-300"
  : "border-zinc-700/70 bg-black/70 text-zinc-400";
const availabilityDotClass = availability.canPurchase
  ? "bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.75)]"
  : "bg-zinc-500";
---

<a
  href={`/product/${product.id}`}
  class="group grid h-[188px] grid-cols-[112px_minmax(0,1fr)] items-stretch gap-3 overflow-hidden sm:h-[204px] sm:grid-cols-[150px_minmax(0,1fr)] sm:gap-4 md:h-[220px] md:grid-cols-[180px_minmax(0,1fr)] lg:flex lg:h-auto lg:flex-col lg:gap-5 lg:overflow-visible"
  data-conversion-event="catalog_product_click"
  data-product-id={product.id}
  data-product-name={product.name}
  data-product-availability={availability.code}
>
  <div
    class="relative h-full min-h-0 overflow-hidden rounded-[14px] border border-zinc-900 bg-zinc-950 transition-colors duration-300 group-hover:border-zinc-700 lg:aspect-[4/5] lg:h-auto lg:w-full lg:rounded-[18px]"
  >
    <img
      src={product.image}
      alt={product.name}
      class="absolute inset-0 h-full w-full object-cover opacity-90 transition-opacity duration-300 group-hover:opacity-100"
      loading="lazy"
    />

    <div class="absolute top-2 left-2 z-10 flex max-w-[calc(100%-1rem)] flex-col gap-2 lg:top-3 lg:left-3">
      {
        preorder ? (
          <PreorderBadge isOpen={preorder.isOpen} isSoldOut={isPreorderSoldOut} />
        ) : (
          <span
            class={`inline-flex max-w-full items-center gap-1.5 rounded-md border px-2 py-1.5 text-[8px] font-black uppercase tracking-[0.12em] shadow-[0_10px_30px_rgba(0,0,0,0.32)] backdrop-blur lg:gap-2 lg:px-3 lg:py-2 lg:text-[10px] lg:tracking-[0.18em] ${availabilityBadgeClass}`}
          >
            <span
              class={`h-1.5 w-1.5 rounded-full ${availabilityDotClass}`}
              aria-hidden="true"
            >
            </span>
            <span class="truncate">{availability.label}</span>
          </span>
        )
      }
      {
        product.status === "NEW" && (
          <span class="rounded-full bg-[#E60012] text-white text-xs font-semibold px-3 py-1">
            Nuevo
          </span>
        )
      }
    </div>
  </div>

  <div class="flex min-h-0 min-w-0 flex-col justify-between gap-2 overflow-hidden py-0.5 lg:gap-3 lg:overflow-visible lg:py-0">
    <div class="min-h-0 space-y-1">
      <p class="h-4 truncate text-xs font-medium leading-4 text-zinc-500 lg:h-auto lg:text-sm lg:leading-normal">
        {product.line || "\u00A0"}
      </p>
      <h3 class="line-clamp-2 h-[2.75rem] text-base font-semibold leading-snug text-white lg:h-auto lg:line-clamp-none lg:text-lg">
        {product.name}
      </h3>
      <p class="h-4 truncate text-xs leading-4 text-zinc-400 lg:h-auto lg:text-sm lg:leading-normal">
        {product.character || "\u00A0"}
      </p>
    </div>

    <div class="flex min-h-[1.25rem] flex-col gap-1 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
      <span class="text-sm font-semibold text-white lg:text-base">
        {formatPrice(product.price)}
      </span>
      <span class="truncate text-[9px] font-black uppercase tracking-[0.14em] text-zinc-600 lg:text-[10px] lg:tracking-[0.18em]">
        {availability.label}
      </span>
    </div>

    {
      preorder && (
        <>
          <div class="flex min-h-5 items-center justify-between gap-2 border-t border-zinc-900/80 pt-2 lg:hidden">
            <span class="truncate text-[9px] font-black uppercase tracking-[0.14em] text-zinc-500">
              {preorder.etaLabel || "Preventa"}
            </span>
            <span class="shrink-0 text-xs font-semibold text-amber-500">
              {formatPrice(preorder.depositAmount)}
            </span>
          </div>
          <div class="mt-1 hidden flex-col gap-2 border-t border-zinc-900 pt-3 lg:mt-2 lg:flex lg:gap-3 lg:pt-4">
            <PreorderEta etaLabel={preorder.etaLabel} />
            <PreorderAvailabilityMeter
              availableUnits={preorder.availableUnits}
              totalUnits={preorder.totalUnits}
            />
            <div class="flex items-center justify-between text-sm">
              <span class="text-zinc-500">Abono</span>
              <span class="text-amber-500 font-semibold">
                {formatPrice(preorder.depositAmount)}
              </span>
            </div>
          </div>
        </>
      )
    }
    <span
      class={`inline-flex shrink-0 items-center gap-1.5 self-start text-[11px] font-semibold tracking-wide transition-colors lg:mt-1 lg:text-xs ${
        isSoldOut
          ? "text-zinc-600"
          : "text-zinc-300 group-hover:text-white"
      }`}
    >
      {ctaLabel}
      {
        !isSoldOut && (
          <svg
            class="h-3 w-3 transition-transform group-hover:translate-x-0.5"
            viewBox="0 0 12 12"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M4.5 2.5L8 6L4.5 9.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        )
      }
    </span>
  </div>
</a>
