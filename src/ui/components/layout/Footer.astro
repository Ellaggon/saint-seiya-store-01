---
/**
 * FOOTER COMPONENT
 * Functional: Structured site information and links.
 * UI: Dark, minimal, uppercase headings, gold hover states.
 */
import { CatalogQueryService } from "@/application/services/CatalogQueryService";
import { PrismaCatalogQueryRepository } from "@/infrastructure/database/PrismaCatalogQueryRepository";

type ExploreLink = {
  label: string;
  href: string;
};

type FilterOption = {
  name: string;
  slug: string;
  count: number;
};

const normalize = (value: string) =>
  value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .trim();

const matchesPreferred = (item: FilterOption, needles: string[]) => {
  const name = normalize(item.name);
  const slug = normalize(item.slug);
  return needles.some(
    (needle) => name.includes(needle) || slug.includes(needle.replace(/\s+/g, "-")),
  );
};

const toCollectionHref = (slug: string) => `/catalog?collection=${encodeURIComponent(slug)}`;
const toCategoryHref = (slug: string) => `/catalog?category=${encodeURIComponent(slug)}`;

const queryService = new CatalogQueryService(new PrismaCatalogQueryRepository());
const metadata = await queryService.getCatalogMetadata();

const liveCollections = (metadata.collections || []).filter((item) => item.count > 0);
const liveCategories = (metadata.categories || []).filter((item) => item.count > 0);

const preferredFilters: { needles: string[]; kind: "collection" | "category" | "any" }[] = [
  { needles: ["myth cloth ex", "myth-cloth-ex"], kind: "collection" },
  { needles: ["soul of gold", "soul-of-gold"], kind: "any" },
  { needles: ["vintage", "vintage 80", "vintage-80", "80s", "classic"], kind: "any" },
];

const usedKeys = new Set<string>();
const filterLinks: ExploreLink[] = [];

const markUsed = (kind: "collection" | "category", slug: string) => {
  usedKeys.add(`${kind}:${slug}`);
};

const isUsed = (kind: "collection" | "category", slug: string) =>
  usedKeys.has(`${kind}:${slug}`);

for (const preferred of preferredFilters) {
  const collectionMatch =
    preferred.kind === "category"
      ? undefined
      : liveCollections.find(
          (item) =>
            !isUsed("collection", item.slug) &&
            matchesPreferred(item, preferred.needles),
        );
  const categoryMatch =
    preferred.kind === "collection"
      ? undefined
      : liveCategories.find(
          (item) =>
            !isUsed("category", item.slug) &&
            matchesPreferred(item, preferred.needles),
        );

  const match =
    preferred.kind === "collection"
      ? collectionMatch
        ? { item: collectionMatch, kind: "collection" as const }
        : null
      : preferred.kind === "category"
        ? categoryMatch
          ? { item: categoryMatch, kind: "category" as const }
          : null
        : collectionMatch
          ? { item: collectionMatch, kind: "collection" as const }
          : categoryMatch
            ? { item: categoryMatch, kind: "category" as const }
            : null;

  if (!match) continue;

  markUsed(match.kind, match.item.slug);
  filterLinks.push({
    label: match.item.name,
    href:
      match.kind === "collection"
        ? toCollectionHref(match.item.slug)
        : toCategoryHref(match.item.slug),
  });
}

// Fill with provider-created filters if preferred ones are missing.
const fallbackPool: { item: FilterOption; kind: "collection" | "category" }[] = [
  ...liveCollections.map((item) => ({
    item,
    kind: "collection" as const,
  })),
  ...liveCategories.map((item) => ({
    item,
    kind: "category" as const,
  })),
];

for (const candidate of fallbackPool) {
  if (filterLinks.length >= 3) break;
  if (isUsed(candidate.kind, candidate.item.slug)) continue;
  markUsed(candidate.kind, candidate.item.slug);
  filterLinks.push({
    label: candidate.item.name,
    href:
      candidate.kind === "collection"
        ? toCollectionHref(candidate.item.slug)
        : toCategoryHref(candidate.item.slug),
  });
}

const exploreLinks: ExploreLink[] = [
  { label: "Catálogo completo", href: "/catalog" },
  ...filterLinks,
  { label: "Próximos lanzamientos", href: "/preorders" },
];
---

