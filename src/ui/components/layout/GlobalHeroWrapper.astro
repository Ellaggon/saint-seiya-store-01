---
/**
 * GLOBAL HERO WRAPPER
 * Functional: Campaign headers or collection intros.
 * UI: Full viewport height option, large headlines, gold accent line.
 */
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  fullHeight?: boolean;
  compact?: boolean;
  backgroundImage?: string;
  backgroundPosition?: string;
  htmlId?: string;
  defaultTitle?: string;
  defaultSubtitle?: string;
  inheritedBackground?: boolean;
  hideArchitecturalLines?: boolean;
  ctaLabel?: string;
  ctaHref?: string;
  /** Prefer high fetch priority for LCP heroes (home). */
  prioritizeImage?: boolean;
}

const {
  title,
  subtitle,
  eyebrow,
  fullHeight = false,
  compact = false,
  backgroundImage,
  backgroundPosition = "center",
  htmlId,
  defaultTitle,
  defaultSubtitle,
  inheritedBackground = false,
  hideArchitecturalLines = false,
  ctaLabel = "DESCUBRIR COLECCIÓN",
  ctaHref = "/catalog",
  prioritizeImage = false,
} = Astro.props;

const heightClass = fullHeight
  ? "min-h-[calc(100vh-80px)]"
  : compact
    ? "min-h-[180px] md:min-h-[220px]"
    : "min-h-[60vh] md:min-h-[70vh]";
const backgroundClass = inheritedBackground
  ? "bg-transparent"
  : "bg-black bg-cover bg-no-repeat";
---

<header
  id={htmlId}
  data-default-title={defaultTitle}
  data-default-subtitle={defaultSubtitle}
  class={`relative flex items-center justify-center overflow-hidden ${backgroundClass} ${heightClass}`}
>
  {
    backgroundImage && !inheritedBackground && (
      <img
        src={backgroundImage}
        alt=""
        class="absolute inset-0 z-0 h-full w-full object-cover"
        style={`object-position: ${backgroundPosition};`}
        width="1600"
        height="1067"
        decoding="async"
        fetchpriority={prioritizeImage ? "high" : "auto"}
        loading={prioritizeImage ? "eager" : "lazy"}
      />
    )
  }

  {
    !inheritedBackground && (
      <div
        class={`absolute inset-0 z-10 ${
          backgroundImage
            ? "bg-gradient-to-t from-black via-black/55 to-black/70"
            : "bg-gradient-to-t from-black via-black/40 to-black/80"
        }`}
      >
      </div>
    )
  }

  {
    !hideArchitecturalLines && !backgroundImage && (
      <div class="absolute inset-0 z-0 pointer-events-none opacity-20">
        <div class="absolute left-1/4 top-0 w-px h-full bg-zinc-800"></div>
        <div class="absolute right-1/4 top-0 w-px h-full bg-zinc-800"></div>
        <div class="absolute top-1/2 left-0 w-full h-px bg-zinc-800"></div>
      </div>
    )
  }

  <div
    class="relative z-20 mx-auto w-full max-w-[1280px] px-6 text-center animate-fade-in-up"
  >
    <div class={`flex flex-col items-center ${compact ? "gap-4" : "gap-5 md:gap-6"}`}>
      <div class={`h-px w-10 bg-amber-500 ${compact ? "" : "mb-1"}`}></div>

      <h1
        data-hero-title
        class={`font-black tracking-tight text-white leading-[0.95] ${compact ? "mb-1 text-4xl md:text-5xl" : "mb-2 text-5xl md:text-7xl lg:text-8xl"}`}
      >
        {title}
      </h1>

      {
        eyebrow && (
          <p class="max-w-3xl text-sm font-medium uppercase tracking-[0.18em] text-zinc-200 md:text-base md:tracking-[0.22em]">
            {eyebrow}
          </p>
        )
      }

      {
        subtitle && (
          <p
            class={`max-w-2xl font-medium leading-relaxed text-zinc-400 opacity-90 ${compact ? "text-sm md:text-base" : "text-xs uppercase tracking-[0.28em] md:text-sm md:tracking-[0.35em]"}`}
          >
            <span data-hero-subtitle>{subtitle}</span>
          </p>
        )
      }

      {
        !compact && ctaLabel && ctaHref && (
          <a
            href={ctaHref}
            class="group mt-8 inline-flex items-center gap-3 border-b border-amber-500/70 pb-2 text-[11px] font-black uppercase tracking-[0.28em] text-white transition-colors hover:border-white hover:text-amber-400 md:mt-10"
          >
            {ctaLabel}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="square"
              stroke-linejoin="round"
              class="text-amber-500 transition-transform group-hover:translate-x-1"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        )
      }
    </div>
  </div>
</header>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
</style>
