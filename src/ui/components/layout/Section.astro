---
/**
 * SECTION COMPONENT
 * Functional: Layout wrapper for logical segments.
 * UI: Vertical spacing of 96px, optional dark gray bg, hard border breaks.
 */
interface Props {
  variant?: "black" | "dark";
  withBorder?: boolean;
  fullWidth?: boolean;
  className?: string;
}

const {
  variant = "black",
  withBorder = false,
  fullWidth = false,
  className = "",
} = Astro.props;

const bgClass = variant === "dark" ? "bg-[#1A1A1A]" : "bg-black";
const borderClass = withBorder ? "border-t border-zinc-900" : "";
const widthClass = fullWidth ? "w-full px-4 md:px-8 2xl:px-10" : "max-w-[1280px] mx-auto px-6";
---

<section class={`${bgClass} ${borderClass} ${className}`}>
  <div class={widthClass}>
    <slot />
  </div>
</section>
