---
/**
 * TOP NAVIGATION BAR
 * Functional: Sticky navigation with Spanish UI.
 * UI: #000000 black bar, 1px gold line on scroll, hover animations.
 * Refactored: Centered desktop links and improved mobile interactions.
 */
const navItems = [
  { label: "HOME", href: "/", prefetch: "hover" },
  { label: "CATÁLOGO", href: "/catalog", prefetch: "viewport" },
  { label: "PREVENTAS", href: "/preorders", prefetch: "hover" },
  { label: "EXCLUSIVOS", href: "/exclusive" },
];

const adminItems = [
  { label: "Inicio", href: "/admin/home", icon: "home" },
  { label: "Pedidos", href: "/admin/orders", icon: "orders" },
  { label: "Gestión del Catálogo", href: "/admin/products", icon: "catalog" },
  { label: "Preventas", href: "/admin/preorders", icon: "calendar" },
  { label: "Colecciones", href: "/admin/collections", icon: "collection" },
  { label: "Categorías", href: "/admin/categories", icon: "category" },
  { label: "Redes sociales", href: "/admin/social", icon: "social" },
];
---

<nav
  id="master-nav"
  class="fixed top-0 left-0 w-full z-[30] bg-[#000000] border-b border-transparent transition-all duration-300 h-16 md:h-20 flex items-center"
>
  <div
    class="max-w-[1280px] mx-auto w-full px-6 flex items-center justify-between"
  >
    <!-- Left: Logo -->
    <div class="flex-1 flex justify-start">
      <a href="/" data-astro-prefetch="hover" class="flex-shrink-0">
        <span
          class="text-white text-xl md:text-2xl font-black uppercase tracking-[0.2em]"
          >SANCTUARY</span
        >
      </a>
    </div>

    <!-- Center: Navigation (Desktop) -->
    <div class="hidden md:flex flex-1 justify-center">
      <ul class="flex items-center gap-8 lg:gap-12">
        {
          navItems.map((item) => (
            <li class="relative group h-full flex items-center">
              <a
                href={item.href}
                data-astro-prefetch={item.prefetch}
                class="text-white font-bold text-[11px] tracking-[0.15em] uppercase transition-colors duration-200 hover:text-amber-500 whitespace-nowrap"
              >
                {item.label}
              </a>
              <div class="absolute -bottom-[2px] left-0 w-0 h-[1px] bg-amber-500 transition-all duration-300 group-hover:w-full" />
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Right: Icons & Mobile Trigger -->
    <div class="flex-1 flex justify-end items-center gap-4 md:gap-6">
      <div class="flex items-center gap-4 md:gap-6">
        <button
          id="catalog-search-modal-trigger"
          class="text-white hover:text-amber-500 transition-colors"
          aria-label="Buscar productos"
          aria-controls="catalog-search-modal"
          aria-expanded="false"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="square"
            stroke-linejoin="round"
            ><circle cx="11" cy="11" r="8"></circle><line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"></line>
          </svg>
        </button>
        <button
          id="admin-modal-trigger"
          class="text-white hover:text-amber-500 transition-colors"
          aria-label="Abrir accesos de administración"
          aria-controls="admin-modal"
          aria-expanded="false"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="square"
            stroke-linejoin="round"
            ><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle
              cx="12"
              cy="7"
              r="4"></circle>
          </svg>
        </button>
        <a
          id="nav-cart-trigger"
          href="/cart"
          data-astro-prefetch="hover"
          class="text-white hover:text-amber-500 transition-colors relative"
          aria-label="Carrito"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="square"
            stroke-linejoin="round"
            ><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"
            ></path><line x1="3" y1="6" x2="21" y2="6"></line><path
              d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span
            data-cart-count
            data-empty="true"
            aria-hidden="true"
            class="absolute -top-1 -right-1 hidden h-3.5 w-3.5 items-center justify-center bg-amber-500 text-[8px] font-black text-black data-[empty=false]:flex"
            >0</span
          >
        </a>
      </div>

      <!-- Mobile Menu Trigger -->
      <button
        id="mobile-menu-trigger"
        class="md:hidden text-white hover:text-amber-500 transition-colors p-2"
        aria-label="Menú"
        aria-controls="mobile-panel"
        aria-expanded="false"
      >
        <svg
          id="burger-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          stroke-linejoin="round"
          ><line x1="3" y1="12" x2="21" y2="12"></line><line
            x1="3"
            y1="6"
            x2="21"
            y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay (slide-in) -->
<div
  id="mobile-overlay"
  class="fixed inset-0 z-[40] bg-black/70 opacity-0 transition-opacity duration-300 md:hidden hidden"
>
</div>
<aside
  id="mobile-panel"
  class="fixed top-0 right-0 z-[50] h-full w-[85%] max-w-sm bg-[#000000] border-l border-zinc-900 translate-x-full transition-transform duration-300 md:hidden"
  aria-hidden="true"
>
  <div
    class="flex flex-col h-full bg-[#000000] border-l border-zinc-900 p-8 pt-6 gap-12 relative overflow-y-auto"
  >
    <!-- Menu Header: Search for "Explorar Santuario" and Close Button -->
    <div class="flex items-center justify-between">
      <div class="space-y-2">
        <p
          class="text-amber-500 text-[10px] font-black uppercase tracking-[0.4em]"
        >
          Explorar Santuario
        </p>
        <div class="w-12 h-px bg-amber-500"></div>
      </div>

      <button
        id="mobile-menu-close"
        class="text-white hover:text-amber-500 transition-colors p-2"
        aria-label="Cerrar Menú"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="32"
          height="32"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          stroke-linejoin="round"
          ><line x1="18" y1="6" x2="6" y2="18"></line><line
            x1="6"
            y1="6"
            x2="18"
            y2="18"></line>
        </svg>
      </button>
    </div>

    <ul class="flex-1 px-4 py-6 flex flex-col justify-center list-none m-0 p-0">
      {
        navItems.map((item) => (
          <li class="py-4 border-b border-zinc-900 last:border-0">
            <a
              href={item.href}
              data-astro-prefetch={item.prefetch}
              class="block text-white text-3xl font-black uppercase tracking-widest transition-colors duration-200 hover:text-amber-500 no-underline"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-auto space-y-6 pb-8">
      <div class="flex flex-col gap-4">
        <button
          class="w-full border border-zinc-800 py-4 text-[11px] font-black uppercase tracking-widest text-zinc-500 hover:text-white hover:border-amber-500 transition-all"
          >SOPORTE</button
        >
        <button
          id="mobile-admin-modal-trigger"
          class="w-full bg-zinc-900 py-4 text-[11px] font-black uppercase tracking-widest text-white hover:bg-zinc-800 transition-all"
          aria-controls="admin-modal"
          aria-expanded="false"
          >CUENTA</button
        >
      </div>
      <p
        class="text-zinc-700 text-[10px] uppercase tracking-widest font-bold text-center"
      >
        The Sanctuary Archive © 2026
      </p>
    </div>
  </div>
</aside>

<!-- Admin Quick Access Modal -->
<div
  id="admin-modal-overlay"
  class="fixed inset-0 z-[60] hidden bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300 md:pointer-events-none md:bg-transparent md:backdrop-blur-0"
>
</div>
<section
  id="admin-modal"
  class="fixed left-1/2 top-1/2 z-[70] hidden w-[calc(100%-2rem)] max-w-md -translate-x-1/2 -translate-y-1/2 border border-zinc-800 bg-black shadow-[0_24px_80px_rgba(0,0,0,0.75)] opacity-0 transition-opacity duration-300 md:left-[var(--admin-popover-left,auto)] md:top-[var(--admin-popover-top,72px)] md:w-[320px] md:max-w-none md:translate-x-0 md:translate-y-0 md:shadow-[0_18px_48px_rgba(0,0,0,0.55)]"
  role="dialog"
  aria-modal="true"
  aria-labelledby="admin-modal-title"
  aria-hidden="true"
  inert
>
  <div
    class="absolute -top-[6px] hidden h-3 w-3 rotate-45 border-l border-t border-zinc-800 bg-black md:block"
    style="left: var(--admin-popover-arrow-left, 50%);"
    aria-hidden="true"
  >
  </div>
  <div class="border-b border-zinc-900 px-6 py-5 md:px-5 md:py-4">
    <div class="flex items-start justify-between gap-6">
      <div class="space-y-2">
        <p class="text-amber-500 text-[10px] font-black uppercase tracking-[0.35em]">
          Panel administrativo
        </p>
        <h2
          id="admin-modal-title"
          class="text-white text-xl font-black uppercase tracking-[0.12em] md:text-base"
        >
          Accesos rápidos
        </h2>
      </div>
      <button
        id="admin-modal-close"
        class="p-2 text-zinc-500 transition-colors hover:text-amber-500"
        aria-label="Cerrar accesos de administración"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          stroke-linejoin="round"
          ><line x1="18" y1="6" x2="6" y2="18"></line><line
            x1="6"
            y1="6"
            x2="18"
            y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <nav class="p-4 md:p-3" aria-label="Accesos administrativos">
    <ul class="m-0 flex list-none flex-col gap-2 p-0">
      {
        adminItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="group flex items-center justify-between border border-zinc-900 bg-zinc-950 px-5 py-4 text-white transition-all hover:border-amber-500 hover:bg-zinc-900 md:px-4 md:py-3"
            >
              <span class="flex min-w-0 items-center gap-3">
                <span class="flex h-9 w-9 flex-none items-center justify-center border border-zinc-800 bg-black text-zinc-500 transition-colors group-hover:border-amber-500/60 group-hover:text-amber-500 md:h-8 md:w-8">
                  {item.icon === "home" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="17"
                      height="17"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="square"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M3 10.5 12 3l9 7.5" />
                      <path d="M5 9.5V21h14V9.5" />
                    </svg>
                  )}
                  {item.icon === "orders" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="17"
                      height="17"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="square"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M6 2h12v20H6z" />
                      <path d="M9 7h6" />
                      <path d="M9 12h6" />
                      <path d="M9 17h4" />
                    </svg>
                  )}
                  {item.icon === "catalog" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="17"
                      height="17"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="square"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M16 6H3" />
                      <path d="M21 12H3" />
                      <path d="M12 18H3" />
                    </svg>
                  )}
                  {item.icon === "calendar" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="17"
                      height="17"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="square"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M8 2v4" />
                      <path d="M16 2v4" />
                      <rect x="3" y="4" width="18" height="18" rx="1" />
                      <path d="M3 10h18" />
                    </svg>
                  )}
                  {item.icon === "collection" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="17"
                      height="17"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="square"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                      <path d="m3.27 6.96 8.73 5.05 8.73-5.05" />
                      <path d="M12 22.08V12" />
                    </svg>
                  )}
                  {item.icon === "category" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="17"
                      height="17"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="square"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect x="3" y="3" width="7" height="7" rx="1" />
                      <rect x="14" y="3" width="7" height="7" rx="1" />
                      <rect x="14" y="14" width="7" height="7" rx="1" />
                      <rect x="3" y="14" width="7" height="7" rx="1" />
                    </svg>
                  )}
                  {item.icon === "social" && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="17"
                      height="17"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="square"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <circle cx="18" cy="5" r="3" />
                      <circle cx="6" cy="12" r="3" />
                      <circle cx="18" cy="19" r="3" />
                      <path d="m8.59 13.51 6.83 3.98" />
                      <path d="M15.41 6.51 8.59 10.49" />
                    </svg>
                  )}
                </span>
                <span class="min-w-0 text-sm font-black uppercase tracking-[0.16em] md:text-[11px]">
                  {item.label}
                </span>
              </span>
              <svg
                class="text-zinc-600 transition-colors group-hover:text-amber-500"
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="square"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-3 border-t border-zinc-900 pt-3 space-y-3">
      <a
        href="/account/orders"
        class="group flex items-center justify-between border border-zinc-900 bg-black px-5 py-4 text-zinc-300 transition-all hover:border-amber-500/50 hover:bg-amber-500/10 hover:text-amber-500 md:px-4 md:py-3"
      >
        <span class="text-sm font-black uppercase tracking-[0.16em] md:text-[11px]">
          Mis pedidos
        </span>
        <svg
          class="text-zinc-700 transition-colors group-hover:text-amber-500"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" />
          <path d="M14 2v6h6" />
        </svg>
      </a>
      <a
        href="/logout"
        class="group flex items-center justify-between border border-zinc-900 bg-black px-5 py-4 text-zinc-500 transition-all hover:border-red-500/50 hover:bg-red-500/10 hover:text-red-400 md:px-4 md:py-3"
      >
        <span class="text-sm font-black uppercase tracking-[0.16em] md:text-[11px]">
          Cerrar sesión
        </span>
        <svg
          class="text-zinc-700 transition-colors group-hover:text-red-400"
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
          <path d="m16 17 5-5-5-5" />
          <path d="M21 12H9" />
        </svg>
      </a>
    </div>
  </nav>
</section>

<!-- Global Search Modal -->
<div
  id="catalog-search-modal-overlay"
  class="fixed inset-0 z-[60] hidden bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300"
>
</div>
<section
  id="catalog-search-modal"
  class="fixed left-1/2 top-[12vh] z-[70] hidden w-[calc(100%-2rem)] max-w-xl -translate-x-1/2 border border-zinc-800 bg-black shadow-[0_24px_80px_rgba(0,0,0,0.75)] opacity-0 transition-opacity duration-300 md:top-1/2 md:-translate-y-1/2"
  role="dialog"
  aria-modal="true"
  aria-labelledby="catalog-search-modal-title"
  aria-hidden="true"
  inert
>
  <div class="border-b border-zinc-900 px-6 py-5">
    <div class="flex items-start justify-between gap-6">
      <div class="space-y-2">
        <p class="text-amber-500 text-[10px] font-black uppercase tracking-[0.35em]">
          Búsqueda
        </p>
        <h2
          id="catalog-search-modal-title"
          class="text-white text-xl font-black uppercase tracking-[0.12em]"
        >
          Encuentra productos
        </h2>
      </div>
      <button
        id="catalog-search-modal-close"
        class="p-2 text-zinc-500 transition-colors hover:text-amber-500"
        aria-label="Cerrar búsqueda"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="square"
          stroke-linejoin="round"
          ><line x1="18" y1="6" x2="6" y2="18"></line><line
            x1="6"
            y1="6"
            x2="18"
            y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <form id="navbar-catalog-search-form" class="p-6" action="/catalog" method="get">
    <label class="sr-only" for="navbar-catalog-search-input">
      Buscar productos
    </label>

    <div
      class="mb-4 flex flex-wrap gap-2"
      role="radiogroup"
      aria-label="Alcance de búsqueda"
    >
      <label class="cursor-pointer">
        <input type="radio" name="searchScope" value="all" class="peer sr-only" checked />
        <span class="inline-flex rounded-md border border-zinc-800 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.14em] text-zinc-500 transition-colors peer-checked:border-amber-500 peer-checked:bg-amber-500 peer-checked:text-black">
          Todo
        </span>
      </label>
      <label class="cursor-pointer">
        <input type="radio" name="searchScope" value="catalog" class="peer sr-only" />
        <span class="inline-flex rounded-md border border-zinc-800 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.14em] text-zinc-500 transition-colors peer-checked:border-emerald-500 peer-checked:bg-emerald-500 peer-checked:text-black">
          Catálogo
        </span>
      </label>
      <label class="cursor-pointer">
        <input type="radio" name="searchScope" value="preorders" class="peer sr-only" />
        <span class="inline-flex rounded-md border border-zinc-800 px-3 py-1.5 text-[10px] font-black uppercase tracking-[0.14em] text-zinc-500 transition-colors peer-checked:border-amber-500 peer-checked:bg-amber-500 peer-checked:text-black">
          Preventas
        </span>
      </label>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-[1fr_auto]">
      <input
        id="navbar-catalog-search-input"
        name="q"
        type="search"
        autocomplete="off"
        placeholder="Buscar por producto, colección o personaje"
        class="w-full border border-zinc-800 bg-black px-4 py-4 text-sm font-bold text-white placeholder:text-zinc-600 focus:border-amber-500 focus:outline-none"
      />
      <button
        type="submit"
        class="inline-flex items-center justify-center border border-amber-500 bg-amber-500 px-6 py-4 text-[11px] font-black uppercase tracking-widest text-black transition-colors hover:border-white hover:bg-white"
      >
        Buscar
      </button>
    </div>

    <p
      id="global-search-status"
      class="mt-3 text-[10px] font-medium uppercase tracking-[0.14em] text-zinc-600"
      aria-live="polite"
    >
      Escribe al menos 2 caracteres.
    </p>

    <div
      id="global-search-results"
      class="mt-3 hidden max-h-[40vh] overflow-y-auto border border-zinc-900"
      role="listbox"
      aria-label="Sugerencias de productos"
    >
    </div>

    <div
      id="global-search-empty"
      class="mt-3 hidden border border-dashed border-zinc-900 px-4 py-4 text-center text-sm text-zinc-500"
    >
      Sin coincidencias en el alcance elegido.
    </div>
  </form>
</section>

<script src="../../scripts/globalSearch.ts"></script>

<script>
  (() => {
    const initializeTopNavigation = () => {
      const nav = document.getElementById("master-nav");
      const trigger = document.getElementById("mobile-menu-trigger");
      const close = document.getElementById("mobile-menu-close");
      const panel = document.getElementById("mobile-panel");
      const overlay = document.getElementById("mobile-overlay");
      const adminTriggers = document.querySelectorAll(
        '[aria-controls="admin-modal"]',
      );
      const adminModal = document.getElementById("admin-modal");
      const adminOverlay = document.getElementById("admin-modal-overlay");
      const adminClose = document.getElementById("admin-modal-close");
      const searchTrigger = document.getElementById(
        "catalog-search-modal-trigger",
      );
      const searchModal = document.getElementById("catalog-search-modal");
      const searchOverlay = document.getElementById(
        "catalog-search-modal-overlay",
      );
      const searchClose = document.getElementById("catalog-search-modal-close");
      const searchForm = document.getElementById(
        "navbar-catalog-search-form",
      );
      const searchInput = document.getElementById(
        "navbar-catalog-search-input",
      );

      if (!trigger || !panel || !overlay) return;
      if (trigger.dataset.menuInitialized === "true") return;
      trigger.dataset.menuInitialized = "true";

      const isDesktopViewport = () =>
        window.matchMedia("(min-width: 768px)").matches;

      const setScrollState = () => {
        nav?.classList.toggle("border-amber-500", window.scrollY > 50);
      };

      const positionAdminPopover = (sourceTrigger?: Element | null) => {
        if (!adminModal || !isDesktopViewport()) return;

        const triggerElement =
          sourceTrigger instanceof HTMLElement
            ? sourceTrigger
            : document.getElementById("admin-modal-trigger");
        if (!(triggerElement instanceof HTMLElement)) return;

        const popoverWidth = 320;
        const viewportGutter = 16;
        const triggerRect = triggerElement.getBoundingClientRect();
        const triggerCenter = triggerRect.left + triggerRect.width / 2;
        const desiredLeft = triggerCenter - popoverWidth / 2;
        const left = Math.min(
          Math.max(desiredLeft, viewportGutter),
          window.innerWidth - popoverWidth - viewportGutter,
        );
        const top = triggerRect.bottom + 14;
        const arrowLeft = Math.min(
          Math.max(triggerCenter - left, 18),
          popoverWidth - 18,
        );

        adminModal.style.setProperty("--admin-popover-left", `${left}px`);
        adminModal.style.setProperty("--admin-popover-top", `${top}px`);
        adminModal.style.setProperty(
          "--admin-popover-arrow-left",
          `${arrowLeft}px`,
        );
      };

      const openMenu = () => {
        trigger.setAttribute("aria-expanded", "true");
        panel.setAttribute("aria-hidden", "false");
        overlay.classList.remove("hidden");
        panel.classList.remove("translate-x-full");

        window.setTimeout(() => {
          overlay.classList.remove("opacity-0");
        }, 10);

        document.body.style.overflow = "hidden";
      };

      const closeMenu = () => {
        trigger.setAttribute("aria-expanded", "false");
        panel.setAttribute("aria-hidden", "true");
        overlay.classList.add("opacity-0");
        panel.classList.add("translate-x-full");

        window.setTimeout(() => {
          overlay.classList.add("hidden");
        }, 300);

        document.body.style.overflow = "";
      };

      const openAdminModal = (sourceTrigger?: Element | null) => {
        if (!adminModal || !adminOverlay) return;

        adminTriggers.forEach((adminTrigger) => {
          adminTrigger.setAttribute("aria-expanded", "true");
        });
        adminModal.setAttribute("aria-hidden", "false");
        adminModal.removeAttribute("inert");
        closeMenu();
        closeSearchModal();
        adminOverlay.classList.remove("hidden");
        adminModal.classList.remove("hidden");
        positionAdminPopover(sourceTrigger);

        window.setTimeout(() => {
          if (!isDesktopViewport()) {
            adminOverlay.classList.remove("opacity-0");
          }
          adminModal.classList.remove("opacity-0");
        }, 10);

        if (!isDesktopViewport()) {
          document.body.style.overflow = "hidden";
        }
        adminClose?.focus();
      };

      const closeAdminModal = () => {
        if (!adminModal || !adminOverlay) return;

        if (adminModal.contains(document.activeElement)) {
          const triggerToFocus = document.getElementById("admin-modal-trigger");
          if (triggerToFocus instanceof HTMLElement) {
            triggerToFocus.focus();
          } else if (document.activeElement instanceof HTMLElement) {
            document.activeElement.blur();
          }
        }

        adminTriggers.forEach((adminTrigger) => {
          adminTrigger.setAttribute("aria-expanded", "false");
        });
        adminModal.setAttribute("aria-hidden", "true");
        adminModal.setAttribute("inert", "");
        adminOverlay.classList.add("opacity-0");
        adminModal.classList.add("opacity-0");

        window.setTimeout(() => {
          adminOverlay.classList.add("hidden");
          adminModal.classList.add("hidden");
        }, 300);

        document.body.style.overflow = "";
      };

      const openSearchModal = () => {
        if (!searchTrigger || !searchModal || !searchOverlay) return;

        searchTrigger.setAttribute("aria-expanded", "true");
        searchModal.setAttribute("aria-hidden", "false");
        searchModal.removeAttribute("inert");
        closeMenu();
        closeAdminModal();
        searchOverlay.classList.remove("hidden");
        searchModal.classList.remove("hidden");

        window.setTimeout(() => {
          searchOverlay.classList.remove("opacity-0");
          searchModal.classList.remove("opacity-0");
        }, 10);

        const currentCatalogInput = document.getElementById(
          "catalog-search-input",
        );
        if (searchInput instanceof HTMLInputElement) {
          if (currentCatalogInput instanceof HTMLInputElement) {
            searchInput.value = currentCatalogInput.value;
          } else {
            const currentUrl = new URL(window.location.href);
            searchInput.value = currentUrl.searchParams.get("q") || "";
          }
          searchInput.dispatchEvent(new Event("input", { bubbles: true }));
        }

        document.body.style.overflow = "hidden";
        searchInput?.focus();
      };

      const closeSearchModal = () => {
        if (!searchTrigger || !searchModal || !searchOverlay) return;

        if (searchModal.contains(document.activeElement)) {
          searchTrigger.focus();
        }

        searchTrigger.setAttribute("aria-expanded", "false");
        searchModal.setAttribute("aria-hidden", "true");
        searchModal.setAttribute("inert", "");
        searchOverlay.classList.add("opacity-0");
        searchModal.classList.add("opacity-0");

        window.setTimeout(() => {
          searchOverlay.classList.add("hidden");
          searchModal.classList.add("hidden");
        }, 300);

        document.body.style.overflow = "";
      };

      setScrollState();
      window.addEventListener(
        "scroll",
        () => {
          setScrollState();
          if (!adminModal?.classList.contains("hidden")) {
            positionAdminPopover();
          }
        },
        { passive: true },
      );
      window.addEventListener("resize", () => {
        if (!adminModal?.classList.contains("hidden")) {
          positionAdminPopover();
        }
      });
      trigger.addEventListener("click", openMenu);
      close?.addEventListener("click", closeMenu);
      overlay.addEventListener("click", closeMenu);
      adminTriggers.forEach((adminTrigger) => {
        adminTrigger.addEventListener("click", () => {
          openAdminModal(adminTrigger);
        });
      });
      adminClose?.addEventListener("click", closeAdminModal);
      adminOverlay?.addEventListener("click", closeAdminModal);
      document.addEventListener("click", (event) => {
        if (!isDesktopViewport()) return;
        if (!adminModal || adminModal.classList.contains("hidden")) return;
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (adminModal.contains(target)) return;
        if (target.closest('[aria-controls="admin-modal"]')) return;

        closeAdminModal();
      });
      adminModal?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeAdminModal);
      });
      searchTrigger?.addEventListener("click", openSearchModal);
      searchClose?.addEventListener("click", closeSearchModal);
      searchOverlay?.addEventListener("click", closeSearchModal);
      panel.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      window.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        closeMenu();
        closeAdminModal();
        closeSearchModal();
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initializeTopNavigation);
    } else {
      initializeTopNavigation();
    }

    document.addEventListener("astro:page-load", initializeTopNavigation);
  })();
</script>
