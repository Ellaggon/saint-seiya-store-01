---
interface Props {
  href?: string;
  isOpen: boolean;
  isSoldOut?: boolean;
  productId?: string;
  campaignId?: string;
}

const {
  href,
  isOpen,
  isSoldOut = false,
  productId,
  campaignId,
} = Astro.props;
const disabled = !isOpen || isSoldOut;
const trackingAttrs = {
  "data-conversion-event": "preorder_cta_click",
  "data-product-id": productId,
  "data-campaign-id": campaignId,
};
---

{
  disabled ? (
    <span class="block border border-zinc-800 text-zinc-500 text-[10px] font-black uppercase tracking-[0.2em] px-4 py-3 text-center">
      No disponible
    </span>
  ) : href ? (
    <a
      href={href}
      {...trackingAttrs}
      class="block border border-amber-500 text-amber-500 text-[10px] font-black uppercase tracking-[0.2em] px-4 py-3 text-center hover:bg-amber-500 hover:text-black transition-all"
    >
      Reservar
    </a>
  ) : (
    <button
      type="button"
      id="preorder-cta-open"
      {...trackingAttrs}
      class="block w-full border border-amber-500 text-amber-500 text-[10px] font-black uppercase tracking-[0.2em] px-4 py-3 text-center hover:bg-amber-500 hover:text-black transition-all"
    >
      Reservar
    </button>
  )
}
