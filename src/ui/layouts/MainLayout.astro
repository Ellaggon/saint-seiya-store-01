---
import { ClientRouter } from "astro:transitions";
import TopNavigationBar from "../components/layout/TopNavigationBar.astro";
import Footer from "../components/layout/Footer.astro";
import "../styles/global.css";

/**
 * MAIN MASTER LAYOUT
 * Structural foundation for all pages.
 */
interface Props {
  title: string;
  description?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "Saint Seiya Store - Figuras coleccionables y preventas premium",
  structuredData,
} = Astro.props;
const structuredDataJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, "\\u003c")
  : null;
---

<!DOCTYPE html>
<html lang="es" class="bg-black">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content={description}
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <!-- Preload fonts if possible -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Saint Seiya Store</title>
    <ClientRouter fallback="animate" />
    {
      structuredDataJson && (
        <script
          type="application/ld+json"
          set:html={structuredDataJson}
        />
      )
    }
  </head>
  <body
    class="min-h-screen bg-black text-white selection:bg-amber-500 selection:text-black antialiased overflow-x-hidden pt-16 md:pt-20"
  >
    <TopNavigationBar />
    <div
      id="route-loading-indicator"
      class="pointer-events-none fixed inset-x-0 top-0 z-[80] opacity-0 transition-opacity duration-150"
      aria-hidden="true"
    >
      <div class="h-[2px] w-full overflow-hidden bg-zinc-950">
        <div
          class="route-loading-bar h-full w-1/3 bg-amber-500 shadow-[0_0_18px_rgba(245,158,11,0.65)]"
        >
        </div>
      </div>
    </div>

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script>
      const authHashParams = new URLSearchParams(window.location.hash.slice(1));
      if (
        authHashParams.get("type") === "recovery" &&
        window.location.pathname !== "/reset-password"
      ) {
        window.location.href = `/reset-password${window.location.hash}`;
      }
    </script>

    <script>
      window.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const tracked = target.closest("[data-conversion-event]");
        if (!(tracked instanceof HTMLElement)) return;

        const eventName = tracked.dataset.conversionEvent;
        if (!eventName) return;

        const payload = {
          event: eventName,
          productId: tracked.dataset.productId,
          productName: tracked.dataset.productName,
          campaignId: tracked.dataset.campaignId,
          availability: tracked.dataset.productAvailability,
          href:
            tracked instanceof HTMLAnchorElement
              ? tracked.href
              : tracked.getAttribute("href"),
        };

        window.dispatchEvent(
          new CustomEvent("commerce:conversion", { detail: payload }),
        );
        (window as unknown as { dataLayer?: unknown[] }).dataLayer?.push(payload);
      });
    </script>

    <script>
      (() => {
        if ((window as unknown as { __saintRouteLoading?: boolean }).__saintRouteLoading) {
          return;
        }
        (window as unknown as { __saintRouteLoading?: boolean }).__saintRouteLoading = true;

        const getIndicator = () =>
          document.getElementById("route-loading-indicator");

        const setLoading = (isLoading: boolean) => {
          const indicator = getIndicator();
          if (!indicator) return;
          indicator.classList.toggle("opacity-0", !isLoading);
          indicator.classList.toggle("opacity-100", isLoading);
          document.documentElement.dataset.routeLoading = String(isLoading);
        };

        const shouldShowForLink = (event: MouseEvent, link: HTMLAnchorElement) => {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) {
            return false;
          }

          if (
            link.hasAttribute("download") ||
            link.dataset.astroReload !== undefined ||
            link.dataset.filterLink !== undefined
          ) {
            return false;
          }

          const target = link.getAttribute("target");
          if (target && target !== "_self") return false;

          const nextUrl = new URL(link.href, window.location.href);
          if (nextUrl.origin !== window.location.origin) return false;

          return (
            nextUrl.pathname !== window.location.pathname ||
            nextUrl.search !== window.location.search
          );
        };

        document.addEventListener(
          "click",
          (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;

            const link = target.closest("a");
            if (!(link instanceof HTMLAnchorElement)) return;
            if (!shouldShowForLink(event, link)) return;

            setLoading(true);
          },
          { capture: true },
        );

        document.addEventListener("astro:before-preparation", () => {
          setLoading(true);
        });
        document.addEventListener("astro:after-swap", () => {
          setLoading(false);
        });
        document.addEventListener("astro:page-load", () => {
          setLoading(false);
        });
        window.addEventListener("pageshow", () => {
          setLoading(false);
        });
      })();
    </script>

    <style is:global>
      @keyframes route-loading-slide {
        0% {
          transform: translateX(-120%);
        }
        100% {
          transform: translateX(320%);
        }
      }

      .route-loading-bar {
        animation: route-loading-slide 950ms ease-in-out infinite;
      }

      /* Spotlight Simulation */
      .spotlight-hover {
        position: relative;
        overflow: hidden;
      }
      .spotlight-hover::after {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
          circle at var(--x) var(--y),
          rgba(212, 175, 55, 0.15) 0%,
          transparent 50%
        );
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
      }
      .spotlight-hover:hover::after {
        opacity: 1;
      }

      /* Custom Scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #000;
      }
      ::-webkit-scrollbar-thumb {
        background: #1a1a1a;
        border: 1px solid #333;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #d4af37;
      }
    </style>

    <script>
      // Global spotlight effect
      document.querySelectorAll(".spotlight-hover").forEach((el) => {
        el.addEventListener("mousemove", (e: MouseEvent) => {
          const rect = el.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          (el as HTMLElement).style.setProperty("--x", `${x}px`);
          (el as HTMLElement).style.setProperty("--y", `${y}px`);
        });
      });
    </script>
  </body>
</html>
