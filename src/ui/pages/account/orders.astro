---
import MainLayout from "../../layouts/MainLayout.astro";
import { prisma } from "@/infrastructure/database/prisma";
import { formatPrice } from "@/lib/utils";
import {
  canCustomerPayOrder,
  orderStatusClass,
  orderStatusLabel,
} from "@/application/orders/orderStatus";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(
    "/login?returnTo=" + encodeURIComponent("/account/orders"),
  );
}

const orders = await prisma.order.findMany({
  where: { userId: user.id },
  orderBy: { createdAt: "desc" },
  include: {
    items: {
      include: {
        product: {
          select: { id: true, name: true, imageUrl: true },
        },
      },
    },
    payments: {
      orderBy: { createdAt: "desc" },
      take: 1,
    },
  },
});

const formatDate = (value: Date) =>
  value.toLocaleDateString("es-BO", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<MainLayout title="Mis pedidos">
  <main class="mx-auto min-h-screen max-w-[900px] px-6 py-16 md:py-24">
    <div class="mb-10 space-y-3">
      <p class="text-[10px] font-black uppercase tracking-[0.35em] text-amber-500">
        Cuenta
      </p>
      <h1 class="text-4xl font-black uppercase tracking-tighter text-white md:text-5xl">
        Mis pedidos
      </h1>
      <div class="h-1 w-12 bg-amber-500"></div>
      <p class="max-w-xl text-xs leading-6 text-zinc-500">
        Historial de pedidos y estado de pagos QR.
      </p>
    </div>

    {
      orders.length === 0 ? (
        <div class="border border-zinc-900 bg-zinc-950 px-6 py-14 text-center">
          <p class="text-sm font-black uppercase tracking-[0.2em] text-zinc-500">
            Aún no tienes pedidos
          </p>
          <a
            href="/catalog"
            class="mt-6 inline-flex border border-amber-500/60 px-6 py-3 text-[11px] font-black uppercase tracking-widest text-amber-500 transition-colors hover:bg-amber-500 hover:text-black"
          >
            Explorar catálogo
          </a>
        </div>
      ) : (
        <ul class="space-y-4">
          {orders.map((order) => {
            const title =
              order.items.length === 1
                ? order.items[0]?.product.name
                : `${order.items.length} productos`;
            const ref = order.referenceCode || order.id.slice(0, 8).toUpperCase();
            const payHref = `/orders/${order.id}/pay`;
            return (
              <li class="border border-zinc-900 bg-zinc-950 px-5 py-5 transition-colors hover:border-amber-500/40">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                  <div class="min-w-0 space-y-2">
                    <span class="block text-[10px] font-black uppercase tracking-[0.24em] text-amber-500">
                      {ref}
                    </span>
                    <h2 class="truncate text-lg font-black uppercase tracking-tight text-white">
                      {title}
                    </h2>
                    <p class="text-[10px] uppercase tracking-widest text-zinc-600">
                      {formatDate(order.createdAt)}
                    </p>
                    <ul class="mt-3 space-y-1">
                      {order.items.map((item) => (
                        <li class="text-[11px] uppercase tracking-widest text-zinc-500">
                          {item.quantity}× {item.product.name} ·{" "}
                          {formatPrice(Number(item.price))}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="shrink-0 space-y-3 text-left sm:text-right">
                    <span
                      class={`block text-sm font-black uppercase tracking-widest ${orderStatusClass(order.status)}`}
                    >
                      {orderStatusLabel(order.status)}
                    </span>
                    <span class="mt-1 block text-sm font-black text-white">
                      {formatPrice(Number(order.totalAmount))}
                    </span>
                    {order.shippingTrackerId && (
                      <span class="mt-2 block text-[10px] uppercase tracking-widest text-zinc-600">
                        Tracking: {order.shippingTrackerId}
                      </span>
                    )}
                    <div class="flex flex-col gap-2 sm:items-end">
                      <a
                        href={`/account/orders/${order.id}`}
                        class="text-[10px] font-black uppercase tracking-widest text-zinc-500 hover:text-amber-500"
                      >
                        Ver detalle →
                      </a>
                      {canCustomerPayOrder(order.status) && (
                        <a
                          href={payHref}
                          class="inline-flex border border-amber-500/60 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-amber-500 transition-colors hover:bg-amber-500 hover:text-black"
                        >
                          Completar pago
                        </a>
                      )}
                    </div>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </main>
</MainLayout>
