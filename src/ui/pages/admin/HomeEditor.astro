---
import MainLayout from "@/ui/layouts/MainLayout.astro";
import type { HomePageContent } from "@/application/dto/homeContent.dto";

interface CollectionOption {
  name: string;
  slug: string;
}

interface Props {
  content: HomePageContent;
  collections: CollectionOption[];
  saved?: boolean;
  error?: string | null;
}

const { content, collections, saved = false, error = null } = Astro.props;

const collectionName = (slug: string): string =>
  collections.find((item) => item.slug === slug)?.name ?? slug;
---

<MainLayout title="Admin - Inicio">
  <div class="max-w-[1100px] mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
      <div class="space-y-2">
        <p class="text-amber-500 text-[10px] font-black uppercase tracking-[0.4em]">
          Panel de Control
        </p>
        <h1 class="text-4xl font-black text-white uppercase tracking-tighter">
          Página de Inicio
        </h1>
        <p class="max-w-xl text-sm text-zinc-500">
          Edita las secciones visibles en la home. Los cambios se publican al
          guardar.
        </p>
        <div class="w-12 h-1 bg-amber-500"></div>
      </div>
      <a
        href="/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center border border-zinc-800 px-6 py-3 text-[11px] font-black uppercase tracking-widest text-zinc-300 transition-colors hover:border-amber-500 hover:text-amber-500"
      >
        Ver sitio
      </a>
    </div>

    {
      saved && (
        <div class="mb-8 border border-green-500/30 bg-green-500/5 px-5 py-4 text-xs font-bold uppercase tracking-widest text-green-400">
          Contenido del inicio guardado.
        </div>
      )
    }
    {
      error && (
        <div class="mb-8 border border-red-500/30 bg-red-500/5 px-5 py-4 text-xs font-bold uppercase tracking-widest text-red-400">
          {error}
        </div>
      )
    }

    <form
      id="home-editor-form"
      action="/api/admin/home/actions"
      method="POST"
      class="space-y-10"
    >
      <!-- Section 1: Hero -->
      <section class="overflow-hidden border border-zinc-900 bg-zinc-950">
        <div class="flex items-center justify-between border-b border-zinc-900 px-5 py-4">
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.35em] text-amber-500">
              Sección 1
            </p>
            <h2 class="text-lg font-black uppercase tracking-tight text-white">
              Hero principal
            </h2>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-0 lg:grid-cols-2">
          <div class="relative min-h-[280px] bg-black">
            <img
              id="hero-preview"
              src={content.hero.backgroundImageUrl}
              alt="Vista previa del hero"
              class="absolute inset-0 h-full w-full object-cover opacity-80"
              style={`object-position: ${content.hero.backgroundPosition || "center 35%"}`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 space-y-2 p-6">
              <p
                id="hero-secondary-preview"
                class="text-[10px] font-black uppercase tracking-[0.28em] text-amber-500"
              >
                {content.hero.secondaryTitle}
              </p>
              <p
                id="hero-title-preview"
                class="text-3xl font-black uppercase tracking-tighter text-white"
              >
                {content.hero.title}
              </p>
              <p
                id="hero-subtitle-preview"
                class="text-sm text-zinc-300"
              >
                {content.hero.subtitle}
              </p>
            </div>
            <label class="absolute right-4 top-4 z-20 inline-flex cursor-pointer items-center border border-zinc-700 bg-black/80 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-white transition-colors hover:border-amber-500 hover:text-amber-500">
              <span data-upload-label>Cambiar imagen</span>
              <input
                type="file"
                accept="image/jpeg,image/png,image/webp"
                class="home-image-upload absolute inset-0 cursor-pointer opacity-0"
                data-hidden-id="hero-backgroundImageUrl"
                data-preview-id="hero-preview"
              />
            </label>
            <input
              type="hidden"
              name="hero.backgroundImageUrl"
              id="hero-backgroundImageUrl"
              value={content.hero.backgroundImageUrl}
            />
            <input
              type="hidden"
              name="hero.backgroundPosition"
              value={content.hero.backgroundPosition || "center 35%"}
            />
            <input
              type="hidden"
              name="hero.ctaLabel"
              value={content.hero.ctaLabel || "Ver preventa"}
            />
            <input
              type="hidden"
              name="hero.ctaHref"
              value={content.hero.ctaHref || "/preorders"}
            />
          </div>

          <div class="space-y-5 p-6">
            <div class="space-y-2">
              <label
                for="hero.title"
                class="block text-[10px] font-black uppercase tracking-widest text-amber-500"
              >
                Título principal
              </label>
              <input
                type="text"
                id="hero.title"
                name="hero.title"
                value={content.hero.title}
                required
                data-live-preview="hero-title-preview"
                class="w-full border border-zinc-800 bg-black px-4 py-3 text-white focus:border-amber-500 focus:outline-none"
              />
            </div>
            <div class="space-y-2">
              <label
                for="hero.secondaryTitle"
                class="block text-[10px] font-black uppercase tracking-widest text-amber-500"
              >
                Título secundario
              </label>
              <input
                type="text"
                id="hero.secondaryTitle"
                name="hero.secondaryTitle"
                value={content.hero.secondaryTitle}
                required
                data-live-preview="hero-secondary-preview"
                class="w-full border border-zinc-800 bg-black px-4 py-3 text-white focus:border-amber-500 focus:outline-none"
              />
            </div>
            <div class="space-y-2">
              <label
                for="hero.subtitle"
                class="block text-[10px] font-black uppercase tracking-widest text-amber-500"
              >
                Subtítulo
              </label>
              <input
                type="text"
                id="hero.subtitle"
                name="hero.subtitle"
                value={content.hero.subtitle}
                required
                data-live-preview="hero-subtitle-preview"
                class="w-full border border-zinc-800 bg-black px-4 py-3 text-white focus:border-amber-500 focus:outline-none"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Feature -->
      <section class="overflow-hidden border border-zinc-900 bg-zinc-950">
        <div class="border-b border-zinc-900 px-5 py-4">
          <p class="text-[10px] font-black uppercase tracking-[0.35em] text-amber-500">
            Sección 2
          </p>
          <h2 class="text-lg font-black uppercase tracking-tight text-white">
            Figura destacada
          </h2>
        </div>

        <div class="grid grid-cols-1 gap-0 lg:grid-cols-2">
          <div class="relative min-h-[320px] bg-black">
            <img
              id="feature-preview"
              src={content.feature.imageUrl}
              alt="Vista previa figura destacada"
              class="absolute inset-0 h-full w-full object-cover object-[50%_18%]"
            />
            <label class="absolute right-4 top-4 z-20 inline-flex cursor-pointer items-center border border-zinc-700 bg-black/80 px-4 py-2 text-[10px] font-black uppercase tracking-widest text-white transition-colors hover:border-amber-500 hover:text-amber-500">
              <span data-upload-label>Cambiar imagen</span>
              <input
                type="file"
                accept="image/jpeg,image/png,image/webp"
                class="home-image-upload absolute inset-0 cursor-pointer opacity-0"
                data-hidden-id="feature-imageUrl"
                data-preview-id="feature-preview"
              />
            </label>
            <input
              type="hidden"
              name="feature.imageUrl"
              id="feature-imageUrl"
              value={content.feature.imageUrl}
            />
          </div>
          <div class="space-y-5 p-6">
            <div class="space-y-2">
              <label
                for="feature.name"
                class="block text-[10px] font-black uppercase tracking-widest text-amber-500"
              >
                Nombre
              </label>
              <input
                type="text"
                id="feature.name"
                name="feature.name"
                value={content.feature.name}
                required
                class="w-full border border-zinc-800 bg-black px-4 py-3 text-white focus:border-amber-500 focus:outline-none"
              />
            </div>
            <div class="space-y-2">
              <label
                for="feature.collectionLabel"
                class="block text-[10px] font-black uppercase tracking-widest text-amber-500"
              >
                Colección (texto)
              </label>
              <input
                type="text"
                id="feature.collectionLabel"
                name="feature.collectionLabel"
                value={content.feature.collectionLabel}
                required
                class="w-full border border-zinc-800 bg-black px-4 py-3 text-white focus:border-amber-500 focus:outline-none"
              />
              <p class="text-[10px] uppercase tracking-widest text-zinc-600">
                Solo aparece como etiqueta bajo la imagen.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 3: Featured collections -->
      <section class="overflow-hidden border border-zinc-900 bg-zinc-950">
        <div class="border-b border-zinc-900 px-5 py-4">
          <p class="text-[10px] font-black uppercase tracking-[0.35em] text-amber-500">
            Sección 3
          </p>
          <h2 class="text-lg font-black uppercase tracking-tight text-white">
            Colecciones destacadas
          </h2>
          <p class="mt-1 text-xs text-zinc-500">
            Cada tarjeta enlaza al catálogo filtrado por la colección elegida.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 p-6 md:grid-cols-3">
          {
            content.featuredCollections.map((card, index) => (
              <div class="border border-zinc-900 bg-black">
                <div class="relative aspect-[3/4] overflow-hidden">
                  <img
                    id={`featured-preview-${index}`}
                    src={card.imageUrl}
                    alt={`Figura destacada ${index + 1}`}
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                  <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black/80" />
                  <div class="absolute inset-x-0 bottom-0 p-4">
                    <p
                      id={`featured-name-${index}`}
                      class="text-sm font-black uppercase tracking-tight text-white"
                    >
                      {collectionName(card.collectionSlug)}
                    </p>
                    <p class="mt-1 text-[10px] font-black uppercase tracking-widest text-amber-500">
                      /catalog?collection=...
                    </p>
                  </div>
                  <label class="absolute right-3 top-3 z-20 inline-flex cursor-pointer items-center border border-zinc-700 bg-black/80 px-3 py-2 text-[9px] font-black uppercase tracking-widest text-white transition-colors hover:border-amber-500 hover:text-amber-500">
                    <span data-upload-label>Imagen</span>
                    <input
                      type="file"
                      accept="image/jpeg,image/png,image/webp"
                      class="home-image-upload absolute inset-0 cursor-pointer opacity-0"
                      data-hidden-id={`featured-imageUrl-${index}`}
                      data-preview-id={`featured-preview-${index}`}
                    />
                  </label>
                </div>
                <div class="space-y-3 p-4">
                  <p class="text-[10px] font-black uppercase tracking-widest text-zinc-500">
                    Figura {index + 1}
                  </p>
                  <input
                    type="hidden"
                    name={`featuredCollections.${index}.imageUrl`}
                    id={`featured-imageUrl-${index}`}
                    value={card.imageUrl}
                  />
                  <div class="space-y-2">
                    <label
                      for={`featured-collectionSlug-${index}`}
                      class="block text-[10px] font-black uppercase tracking-widest text-amber-500"
                    >
                      Colección
                    </label>
                    <select
                      id={`featured-collectionSlug-${index}`}
                      name={`featuredCollections.${index}.collectionSlug`}
                      required
                      data-name-preview={`featured-name-${index}`}
                      class="w-full border border-zinc-800 bg-zinc-950 px-3 py-3 text-xs font-bold uppercase tracking-widest text-white focus:border-amber-500 focus:outline-none"
                    >
                      <option value="">Seleccionar…</option>
                      {collections.map((collection) => (
                        <option
                          value={collection.slug}
                          selected={collection.slug === card.collectionSlug}
                        >
                          {collection.name}
                        </option>
                      ))}
                    </select>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <div class="sticky bottom-4 z-10 flex justify-end">
        <button
          type="submit"
          id="home-save-button"
          class="inline-flex items-center justify-center bg-white px-10 py-4 text-[11px] font-black uppercase tracking-widest text-black transition-colors hover:bg-amber-500"
        >
          Guardar inicio
        </button>
      </div>
    </form>
  </div>
</MainLayout>

<script>
  import { compressImageFile } from "@/ui/scripts/compressImage";

  declare global {
    interface Window {
      __homeEditorUploadBound?: boolean;
    }
  }

  const bindLivePreview = () => {
    const form = document.getElementById("home-editor-form");
    if (!form || form.dataset.liveBound === "1") return;
    form.dataset.liveBound = "1";

    const collectionNames: Record<string, string> = {};
    form
      .querySelectorAll<HTMLOptionElement>("select[data-name-preview] option")
      .forEach((option) => {
        if (option.value) {
          collectionNames[option.value] = option.textContent || option.value;
        }
      });

    form
      .querySelectorAll<HTMLInputElement>("[data-live-preview]")
      .forEach((input) => {
        input.addEventListener("input", () => {
          const previewId = input.getAttribute("data-live-preview");
          const preview = previewId ? document.getElementById(previewId) : null;
          if (preview) preview.textContent = input.value;
        });
      });

    form
      .querySelectorAll<HTMLSelectElement>("select[data-name-preview]")
      .forEach((select) => {
        select.addEventListener("change", () => {
          const previewId = select.getAttribute("data-name-preview");
          const preview = previewId ? document.getElementById(previewId) : null;
          if (!preview) return;
          preview.textContent =
            collectionNames[select.value] ||
            select.options[select.selectedIndex]?.text ||
            select.value;
        });
      });
  };

  const uploadHomeImage = async (input: HTMLInputElement) => {
    const file = input.files?.[0];
    if (!file) return;

    if (file.size > 5 * 1024 * 1024) {
      alert("La imagen supera 5MB. Elige un archivo más liviano.");
      input.value = "";
      return;
    }

    const hiddenId = input.getAttribute("data-hidden-id");
    const previewId = input.getAttribute("data-preview-id");
    const hidden = hiddenId
      ? (document.getElementById(hiddenId) as HTMLInputElement | null)
      : null;
    const preview = previewId
      ? (document.getElementById(previewId) as HTMLImageElement | null)
      : null;
    const labelText = input
      .closest("label")
      ?.querySelector<HTMLElement>("[data-upload-label]");
    const previousLabel = labelText?.textContent ?? "Cambiar imagen";

    if (!hidden) {
      alert("No se encontró el campo de imagen. Recarga la página.");
      return;
    }

    input.disabled = true;
    if (labelText) labelText.textContent = "Subiendo…";

    try {
      const compressed = await compressImageFile(file, {
        maxEdge: 1920,
        quality: 0.78,
      });
      const body = new FormData();
      body.append("file", compressed);

      const response = await fetch("/api/upload-home-image", {
        method: "POST",
        body,
      });

      const payload = (await response.json().catch(() => ({}))) as {
        url?: string;
        error?: string;
      };

      if (!response.ok || !payload.url) {
        throw new Error(payload.error || "No se pudo subir la imagen");
      }

      hidden.value = payload.url;
      if (preview) {
        preview.src = payload.url;
      }
      if (labelText) labelText.textContent = "Listo";
      window.setTimeout(() => {
        if (labelText) labelText.textContent = previousLabel;
      }, 1500);
    } catch (error) {
      if (labelText) labelText.textContent = previousLabel;
      alert(error instanceof Error ? error.message : "Error al subir imagen");
    } finally {
      input.disabled = false;
      input.value = "";
    }
  };

  const bindHomeEditorUploads = () => {
    bindLivePreview();

    if (window.__homeEditorUploadBound) return;
    window.__homeEditorUploadBound = true;

    document.addEventListener("change", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      if (!target.classList.contains("home-image-upload")) return;
      void uploadHomeImage(target);
    });
  };

  bindHomeEditorUploads();
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("home-editor-form");
    if (form) form.dataset.liveBound = "";
    bindHomeEditorUploads();
  });
</script>
