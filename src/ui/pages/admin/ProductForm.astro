---
import MainLayout from "@/ui/layouts/MainLayout.astro";
import ProductImageManager from "@/ui/components/admin/ProductImageManager.astro";

interface Props {
  product?: any;
  categories: any[];
  collections: any[];
  isEditing?: boolean;
  returnTo?: string;
}

const {
  product,
  categories,
  collections,
  isEditing = false,
  returnTo = "/admin/products",
} = Astro.props;
const defaultStatus = returnTo.startsWith("/admin/preorders")
  ? "PRE_ORDER"
  : "DRAFT";
const mediaProductId = product?.id || crypto.randomUUID();
const formError = Astro.url.searchParams.get("error");

const statusOptions = [
  { value: "DRAFT", label: "Borrador" },
  { value: "PUBLISHED", label: "Publicado" },
  { value: "PRE_ORDER", label: "Preventa" },
  { value: "OUT_OF_STOCK", label: "Sin stock" },
  { value: "ARCHIVED", label: "Archivado" },
];
---

<MainLayout
  title={isEditing ? `Editar - ${product.name}` : "Admin - Nueva Figura"}
>
  <div class="max-w-[800px] mx-auto px-6 py-12">
    <!-- Back Button -->
    <a
      href="/admin/products"
      data-astro-prefetch="hover"
      class="inline-flex items-center text-zinc-500 hover:text-white transition-colors text-[10px] font-black uppercase tracking-widest mb-8"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="square"
        stroke-linejoin="round"
        class="mr-2"
        ><path d="m15 18-6-6 6-6"></path>
      </svg>
      Volver al Listado
    </a>

    <!-- Header -->
    <div class="space-y-2 mb-12">
      <p
        class="text-amber-500 text-[10px] font-black uppercase tracking-[0.4em]"
      >
        {isEditing ? "Edición de Archivo" : "Nueva Entrada"}
      </p>
      <h1 class="text-4xl font-black text-white uppercase tracking-tighter">
        {isEditing ? product.name : "Inscribir Figura"}
      </h1>
      <div class="w-12 h-1 bg-amber-500"></div>
    </div>

    {formError === "product-image-migration-pending" && (
      <div class="mb-6 border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-xs leading-5 text-amber-100" role="alert">
        La imagen no se guardó porque esta base aún no tiene la migración de galería. Aplica las migraciones y vuelve a cargarla.
      </div>
    )}
    {formError && formError !== "product-image-migration-pending" && (
      <div class="mb-6 border border-red-500/30 bg-red-500/5 px-4 py-3 text-xs font-bold uppercase tracking-widest text-red-400" role="alert">
        {formError}
      </div>
    )}

    <!-- Form Section -->
    <form
      action="/api/admin/products/actions"
      method="POST"
      onsubmit="this.querySelector('button[type=submit]').disabled = true;"
      class="space-y-8 bg-zinc-950 p-8 border border-zinc-900 shadow-2xl"
    >
      <input
        type="hidden"
        name="_action"
        value={isEditing ? "update" : "create"}
      />
      {isEditing && <input type="hidden" name="id" value={product.id} />}
      <input type="hidden" name="returnTo" value={returnTo} />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Name -->
        <div class="space-y-2">
          <label
            for="name"
            class="block text-[10px] font-black text-amber-500 uppercase tracking-widest"
            >Nombre de la Figura</label
          >
          <input
            type="text"
            id="name"
            name="name"
            value={product?.name || ""}
            required
            placeholder="Ej: Seiya de Pegaso V3"
            class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors"
          />
          <p class="text-[10px] uppercase tracking-widest text-zinc-600">
            La URL se genera sola desde el nombre (si ya existe, se añade un
            número).
          </p>
        </div>

        <!-- Price -->
        <div class="space-y-2">
          <label
            for="price"
            class="block text-[10px] font-black text-amber-500 uppercase tracking-widest"
            >Precio (Bolivianos)</label
          >
          <input
            type="number"
            id="price"
            name="price"
            value={product?.price?.toString() || ""}
            step="0.01"
            required
            placeholder="99.99"
            class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors"
          />
        </div>

        <!-- Height -->
        <div class="space-y-2">
          <label
            for="height"
            class="block text-[10px] font-black text-amber-500 uppercase tracking-widest"
            >Altura (cm)</label
          >
          <input
            type="number"
            id="height"
            name="height"
            value={product?.height?.toString() || ""}
            step="0.1"
            required
            placeholder="18.0"
            class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors"
          />
        </div>

        <!-- Stock -->
        <div class="space-y-2">
          <label
            for="stock"
            class="block text-[10px] font-black text-amber-500 uppercase tracking-widest"
            >Cantidad disponible</label
          >
          <input
            type="number"
            id="stock"
            name="stock"
            value={(product?.stock ?? 0).toString()}
            min="0"
            step="1"
            required
            placeholder="0"
            class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors"
          />
          <p class="text-[10px] text-zinc-600">
            Si está en 0, el catálogo mostrará el producto como agotado.
          </p>
        </div>

        <div class="space-y-2">
          <div class="flex justify-between items-center">
            <label
              for="categoryId"
              class="block text-[10px] font-black text-amber-500 uppercase tracking-widest"
              >Saga de la Historia</label
            >
            <button
              type="button"
              id="open-category-modal"
              class="text-[8px] font-black text-zinc-500 hover:text-amber-500 uppercase tracking-widest transition-colors cursor-pointer"
              >+ Crear nueva saga</button
            >
          </div>
          <select
            id="categoryId"
            name="categoryId"
            required
            class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors appearance-none cursor-pointer"
          >
            <option value="" disabled={!isEditing} selected={!isEditing}
              >Seleccionar saga...</option
            >
            {
              categories.map((cat) => (
                <option
                  value={cat.id}
                  selected={cat.id === product?.categoryId}
                >
                  {cat.name}
                </option>
              ))
            }
          </select>
        </div>

        <div class="space-y-2">
          <div class="flex justify-between items-center">
            <label
              for="collectionId"
              class="block text-[10px] font-black text-amber-500 uppercase tracking-widest"
              >Línea de Producto</label
            >
            <button
              type="button"
              id="open-collection-modal"
              class="text-[8px] font-black text-zinc-500 hover:text-amber-500 uppercase tracking-widest transition-colors cursor-pointer"
              >+ Crear nueva línea</button
            >
          </div>
          <select
            id="collectionId"
            name="collectionId"
            required
            class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors appearance-none cursor-pointer"
          >
            <option value="" disabled={!isEditing} selected={!isEditing}
              >Seleccionar línea...</option
            >
            {
              collections.map((coll) => (
                <option
                  value={coll.id}
                  selected={coll.id === product?.collectionId}
                >
                  {coll.name}
                </option>
              ))
            }
          </select>
        </div>

        <!-- Status -->
        <div class="space-y-2">
          <label
            for="status"
            class="block text-[10px] font-black text-amber-500 uppercase tracking-widest"
            >Estado del Archivo</label
          >
          <select
            id="status"
            name="status"
            required
            class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors appearance-none cursor-pointer"
          >
            {
              statusOptions.map((opt) => (
                <option
                  value={opt.value}
                  selected={opt.value === (product?.status ?? defaultStatus)}
                >
                  {opt.label}
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <ProductImageManager
        productId={mediaProductId}
        productName={product?.name || "Figura"}
        images={
          product?.images?.length
            ? product.images
            : product?.imageUrl
              ? [{
                  id: crypto.randomUUID(),
                  url: product.imageUrl,
                  storageKey: product.imageUrl,
                  altText: product.name || "Figura",
                  sortOrder: 0,
                }]
              : []
        }
      />

      <!-- Description -->
      <div class="space-y-2">
        <label
          for="description"
          class="block text-[10px] font-black text-amber-500 uppercase tracking-widest"
          >Crónicas de la Armadura (Descripción)</label
        >
        <textarea
          id="description"
          name="description"
          rows="5"
          required
          placeholder="Describe la figura, materiales, accesorios y contexto histórico..."
          data-autoresize
          class="min-h-36 w-full overflow-y-hidden bg-black border border-zinc-800 px-4 py-3 text-white text-sm leading-6 focus:border-amber-500 focus:outline-none transition-colors resize-none"
          >{product?.description || ""}</textarea
        >
      </div>

      <!-- Submit Button -->
      <div class="pt-6">
        <button
          type="submit"
          class="w-full bg-white text-black text-[11px] font-black uppercase tracking-[0.2em] py-5 hover:bg-amber-500 transition-all duration-300"
        >
          {
            isEditing
              ? "Guardar Cambios en el Archivo"
              : "Consagrar Figura en el Santuario"
          }
        </button>
      </div>
    </form>

    {
      isEditing && (
        <section class="mt-8 space-y-4 border border-red-500/20 bg-zinc-950 p-8">
          <div class="space-y-2">
            <p class="text-[10px] font-black uppercase tracking-[0.35em] text-red-500">
              Zona de riesgo
            </p>
            <h2 class="text-xl font-black uppercase tracking-tighter text-white">
              Eliminar figura
            </h2>
            <p class="max-w-xl text-xs leading-5 text-zinc-500">
              Borra el producto, su galería y los archivos en Cloudflare R2.
              Si tiene pedidos o reservas de preventa, la eliminación se
              bloqueará para conservar el historial.
            </p>
          </div>
          <form
            action="/api/admin/products/actions"
            method="POST"
            onsubmit="if (!confirm('¿Eliminar definitivamente esta figura? Se borrarán sus datos y las imágenes en Cloudflare. Esta acción no se puede deshacer.')) return false; this.querySelector('button[type=submit]').disabled = true;"
          >
            <input type="hidden" name="id" value={product.id} />
            <input type="hidden" name="_action" value="delete" />
            <button
              type="submit"
              class="inline-flex items-center justify-center border border-red-500/40 px-6 py-3 text-[11px] font-black uppercase tracking-widest text-red-500 transition-colors hover:bg-red-500/10"
            >
              Eliminar figura
            </button>
          </form>
        </section>
      )
    }
  </div>

  <!-- Create category (saga) modal -->
  <div
    id="category-modal-overlay"
    class="fixed inset-0 z-[80] hidden bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300"
    aria-hidden="true"
  >
  </div>
  <section
    id="category-modal"
    class="fixed left-1/2 top-[8vh] z-[90] hidden w-[calc(100%-1.5rem)] max-w-xl -translate-x-1/2 border border-zinc-800 bg-black shadow-[0_28px_90px_rgba(0,0,0,0.8)] opacity-0 transition-all duration-300 md:top-[12vh]"
    role="dialog"
    aria-modal="true"
    aria-labelledby="category-modal-title"
    aria-hidden="true"
    inert
  >
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-500/70 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div class="border-b border-zinc-900 px-6 py-5">
      <div class="flex items-start justify-between gap-6">
        <div class="space-y-2">
          <p class="text-[10px] font-black uppercase tracking-[0.35em] text-amber-500">
            Santuario · Catálogo
          </p>
          <h2
            id="category-modal-title"
            class="text-xl font-black uppercase tracking-[0.08em] text-white"
          >
            Nueva saga
          </h2>
          <p class="max-w-sm text-xs leading-5 text-zinc-500">
            Crea una saga sin salir del formulario. Quedará seleccionada
            automáticamente.
          </p>
        </div>
        <button
          type="button"
          id="category-modal-close"
          class="p-2 text-zinc-500 transition-colors hover:text-amber-500"
          aria-label="Cerrar modal"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="square"
            stroke-linejoin="round"
            ><line x1="18" y1="6" x2="6" y2="18"></line><line
              x1="6"
              y1="6"
              x2="18"
              y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <form id="category-modal-form" class="space-y-5 px-6 py-6">
      <div
        id="category-modal-error"
        class="hidden border border-red-500/40 bg-red-500/10 px-4 py-3 text-[10px] font-black uppercase tracking-widest text-red-400"
        role="alert"
      >
      </div>

      <div class="space-y-2">
        <label
          for="modal-category-name"
          class="block text-[10px] font-black uppercase tracking-widest text-amber-500"
        >
          Nombre de la saga
        </label>
        <input
          type="text"
          id="modal-category-name"
          name="name"
          required
          maxlength="120"
          placeholder="Ej: Saint Seiya Classic"
          class="w-full border border-zinc-800 bg-zinc-950 px-4 py-3 text-sm text-white outline-none transition-colors focus:border-amber-500"
        />
        <p class="text-[10px] uppercase tracking-widest text-zinc-600">
          El slug se genera solo. Si el nombre ya existe, se añade un número.
        </p>
      </div>

      <div class="space-y-4">
        <label
          class="block text-[10px] font-black uppercase tracking-widest text-amber-500"
        >
          Imagen de cabecera (Hero Image)
        </label>

        <div class="flex flex-col gap-4">
          <div class="relative group">
            <input
              type="file"
              id="modal-category-image-upload"
              accept="image/jpeg,image/png,image/webp"
              class="absolute inset-0 z-10 h-full w-full cursor-pointer opacity-0"
            />
            <div
              class="w-full border border-dashed border-zinc-800 bg-zinc-950 px-4 py-8 text-center transition-colors group-hover:border-amber-500"
            >
              <span
                id="modal-category-upload-status"
                class="flex items-center justify-center gap-2 text-[10px] font-black uppercase tracking-widest text-zinc-500"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="square"
                  stroke-linejoin="round"
                  ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
                  ></path><polyline points="17 8 12 3 7 8"></polyline><line
                    x1="12"
                    x2="12"
                    y1="3"
                    y2="15"></line>
                </svg>
                Seleccionar Banner (Max 5MB)
              </span>
            </div>
          </div>

          <input type="hidden" id="modal-category-imageUrl" name="imageUrl" value="" />

          <div id="modal-category-image-preview-container" class="hidden space-y-2">
            <p class="text-[9px] font-bold uppercase tracking-widest text-zinc-500">
              Previsualización de Capítulo:
            </p>
            <div
              class="flex items-center gap-3 border border-zinc-800 bg-zinc-900/50 p-3"
            >
              <div
                class="h-16 w-24 flex-shrink-0 overflow-hidden border border-zinc-700 bg-black"
              >
                <img
                  id="modal-category-image-preview"
                  src=""
                  alt=""
                  class="h-full w-full object-cover"
                />
              </div>
              <div class="flex min-w-0 flex-col">
                <span
                  id="modal-category-image-url-text"
                  class="truncate font-mono text-[10px] text-zinc-400"
                >
                </span>
                <span class="text-[8px] font-black uppercase text-amber-500/50">
                  Activo en el Archivo Sacro
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <label class="flex items-center gap-3 cursor-pointer">
        <input
          type="checkbox"
          id="modal-category-active"
          name="isActive"
          value="true"
          checked
          class="sr-only peer"
        />
        <span
          class="relative h-6 w-11 rounded-full bg-zinc-800 after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-zinc-400 after:transition-all peer-checked:bg-amber-500 peer-checked:after:translate-x-full peer-checked:after:bg-white"
          aria-hidden="true"
        ></span>
        <span class="text-[10px] font-black uppercase tracking-widest text-amber-500">
          Estado activo
        </span>
      </label>

      <div class="flex flex-col gap-3 border-t border-zinc-900 pt-5 sm:flex-row sm:justify-end">
        <button
          type="button"
          id="category-modal-cancel"
          class="border border-zinc-800 px-5 py-3 text-[10px] font-black uppercase tracking-widest text-zinc-400 transition-colors hover:border-zinc-600 hover:text-white"
        >
          Cancelar
        </button>
        <button
          type="submit"
          id="category-modal-submit"
          class="bg-amber-500 px-6 py-3 text-[10px] font-black uppercase tracking-widest text-black transition-colors hover:bg-white disabled:cursor-not-allowed disabled:bg-zinc-800 disabled:text-zinc-500"
        >
          Crear saga
        </button>
      </div>
    </form>
  </section>

  <!-- Create collection modal -->
  <div
    id="collection-modal-overlay"
    class="fixed inset-0 z-[80] hidden bg-black/80 opacity-0 backdrop-blur-sm transition-opacity duration-300"
    aria-hidden="true"
  >
  </div>
  <section
    id="collection-modal"
    class="fixed left-1/2 top-[8vh] z-[90] hidden w-[calc(100%-1.5rem)] max-w-lg -translate-x-1/2 border border-zinc-800 bg-black shadow-[0_28px_90px_rgba(0,0,0,0.8)] opacity-0 transition-all duration-300 md:top-[12vh]"
    role="dialog"
    aria-modal="true"
    aria-labelledby="collection-modal-title"
    aria-hidden="true"
    inert
  >
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-amber-500/70 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div class="border-b border-zinc-900 px-6 py-5">
      <div class="flex items-start justify-between gap-6">
        <div class="space-y-2">
          <p class="text-[10px] font-black uppercase tracking-[0.35em] text-amber-500">
            Santuario · Catálogo
          </p>
          <h2
            id="collection-modal-title"
            class="text-xl font-black uppercase tracking-[0.08em] text-white"
          >
            Nueva línea
          </h2>
          <p class="max-w-sm text-xs leading-5 text-zinc-500">
            Crea una línea de producto sin salir del formulario. Quedará
            seleccionada automáticamente.
          </p>
        </div>
        <button
          type="button"
          id="collection-modal-close"
          class="p-2 text-zinc-500 transition-colors hover:text-amber-500"
          aria-label="Cerrar modal"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="square"
            stroke-linejoin="round"
            ><line x1="18" y1="6" x2="6" y2="18"></line><line
              x1="6"
              y1="6"
              x2="18"
              y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <form id="collection-modal-form" class="space-y-5 px-6 py-6">
      <div
        id="collection-modal-error"
        class="hidden border border-red-500/40 bg-red-500/10 px-4 py-3 text-[10px] font-black uppercase tracking-widest text-red-400"
        role="alert"
      >
      </div>

      <div class="space-y-2">
        <label
          for="modal-collection-name"
          class="block text-[10px] font-black uppercase tracking-widest text-amber-500"
        >
          Nombre de la línea
        </label>
        <input
          type="text"
          id="modal-collection-name"
          name="name"
          required
          maxlength="120"
          placeholder="Ej: Myth Cloth EX"
          class="w-full border border-zinc-800 bg-zinc-950 px-4 py-3 text-sm text-white outline-none transition-colors focus:border-amber-500"
        />
        <p class="text-[10px] uppercase tracking-widest text-zinc-600">
          El slug se genera solo. Si el nombre ya existe, se añade un número.
        </p>
      </div>

      <label class="flex items-center gap-3 cursor-pointer">
        <input
          type="checkbox"
          id="modal-collection-active"
          name="isActive"
          value="true"
          checked
          class="sr-only peer"
        />
        <span
          class="relative h-6 w-11 rounded-full bg-zinc-800 after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-zinc-400 after:transition-all peer-checked:bg-amber-500 peer-checked:after:translate-x-full peer-checked:after:bg-white"
          aria-hidden="true"
        ></span>
        <span class="text-[10px] font-black uppercase tracking-widest text-amber-500">
          Estado activo
        </span>
      </label>

      <div class="flex flex-col gap-3 border-t border-zinc-900 pt-5 sm:flex-row sm:justify-end">
        <button
          type="button"
          id="collection-modal-cancel"
          class="border border-zinc-800 px-5 py-3 text-[10px] font-black uppercase tracking-widest text-zinc-400 transition-colors hover:border-zinc-600 hover:text-white"
        >
          Cancelar
        </button>
        <button
          type="submit"
          id="collection-modal-submit"
          class="bg-amber-500 px-6 py-3 text-[10px] font-black uppercase tracking-widest text-black transition-colors hover:bg-white disabled:cursor-not-allowed disabled:bg-zinc-800 disabled:text-zinc-500"
        >
          Crear línea
        </button>
      </div>
    </form>
  </section>
</MainLayout>

<script>
  import { compressImageFile } from "@/ui/scripts/compressImage";

  // Shared helpers for create modals (saga + línea)
  const selectCreatedOption = (
    selectId: string,
    created: { id: string; name: string },
  ) => {
    const select = document.getElementById(selectId) as HTMLSelectElement | null;
    if (!select) return;
    const existing = [...select.options].find(
      (option) => option.value === created.id,
    );
    if (existing) {
      existing.selected = true;
      existing.textContent = created.name;
    } else {
      const option = document.createElement("option");
      option.value = created.id;
      option.textContent = created.name;
      option.selected = true;
      select.appendChild(option);
    }
    select.dispatchEvent(new Event("change", { bubbles: true }));
  };

  type CreateModalConfig = {
    kind: "category" | "collection";
    overlayId: string;
    modalId: string;
    openBtnId: string;
    closeBtnId: string;
    cancelBtnId: string;
    formId: string;
    nameInputId: string;
    activeInputId: string;
    errorId: string;
    submitBtnId: string;
    selectId: string;
    endpoint: string;
    submitLabel: string;
    creatingLabel: string;
    buildBody: (name: string) => FormData;
  };

  const bindCreateModal = (config: CreateModalConfig) => {
    const overlay = document.getElementById(config.overlayId);
    const modal = document.getElementById(config.modalId);
    const openBtn = document.getElementById(config.openBtnId);
    const closeBtn = document.getElementById(config.closeBtnId);
    const cancelBtn = document.getElementById(config.cancelBtnId);
    const form = document.getElementById(
      config.formId,
    ) as HTMLFormElement | null;
    const nameInput = document.getElementById(
      config.nameInputId,
    ) as HTMLInputElement | null;
    const errorEl = document.getElementById(config.errorId);
    const submitBtn = document.getElementById(
      config.submitBtnId,
    ) as HTMLButtonElement | null;

    if (!openBtn || openBtn.dataset.bound === "1") return;
    openBtn.dataset.bound = "1";

    let lastFocused: HTMLElement | null = null;

    const setModalError = (message: string | null) => {
      if (!errorEl) return;
      if (!message) {
        errorEl.classList.add("hidden");
        errorEl.textContent = "";
        return;
      }
      errorEl.textContent = message;
      errorEl.classList.remove("hidden");
    };

    const openModal = () => {
      if (!overlay || !modal || !form) return;
      lastFocused = document.activeElement as HTMLElement | null;
      form.reset();
      setModalError(null);
      const active = document.getElementById(
        config.activeInputId,
      ) as HTMLInputElement | null;
      if (active) active.checked = true;

      if (config.kind === "category") {
        const imageUrl = document.getElementById(
          "modal-category-imageUrl",
        ) as HTMLInputElement | null;
        const previewContainer = document.getElementById(
          "modal-category-image-preview-container",
        );
        const previewImg = document.getElementById(
          "modal-category-image-preview",
        ) as HTMLImageElement | null;
        const urlText = document.getElementById(
          "modal-category-image-url-text",
        );
        const statusText = document.getElementById(
          "modal-category-upload-status",
        );
        const fileInput = document.getElementById(
          "modal-category-image-upload",
        ) as HTMLInputElement | null;

        if (imageUrl) imageUrl.value = "";
        if (fileInput) fileInput.value = "";
        if (previewContainer) previewContainer.classList.add("hidden");
        if (previewImg) {
          previewImg.removeAttribute("src");
          previewImg.alt = "";
        }
        if (urlText) urlText.textContent = "";
        if (statusText) {
          statusText.classList.remove("text-red-500");
          statusText.innerHTML = `
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="square"
                  stroke-linejoin="round"
                  ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
                  ></path><polyline points="17 8 12 3 7 8"></polyline><line
                    x1="12"
                    x2="12"
                    y1="3"
                    y2="15"></line>
                </svg>
                Seleccionar Banner (Max 5MB)
              `;
        }
      }

      overlay.classList.remove("hidden");
      modal.classList.remove("hidden");
      modal.removeAttribute("inert");
      modal.setAttribute("aria-hidden", "false");
      overlay.setAttribute("aria-hidden", "false");
      document.body.classList.add("overflow-hidden");

      requestAnimationFrame(() => {
        overlay.classList.remove("opacity-0");
        modal.classList.remove("opacity-0");
        nameInput?.focus();
      });
    };

    const closeModal = () => {
      if (!overlay || !modal) return;
      overlay.classList.add("opacity-0");
      modal.classList.add("opacity-0");
      modal.setAttribute("aria-hidden", "true");
      overlay.setAttribute("aria-hidden", "true");
      modal.setAttribute("inert", "");
      document.body.classList.remove("overflow-hidden");

      window.setTimeout(() => {
        overlay.classList.add("hidden");
        modal.classList.add("hidden");
        lastFocused?.focus?.();
      }, 280);
    };

    openBtn.addEventListener("click", openModal);
    closeBtn?.addEventListener("click", closeModal);
    cancelBtn?.addEventListener("click", closeModal);
    overlay?.addEventListener("click", closeModal);

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (!modal || modal.classList.contains("hidden")) return;
      if (!document.body.contains(modal)) return;
      closeModal();
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form || !nameInput) return;

      const name = nameInput.value.trim();
      if (!name) {
        setModalError("El nombre es obligatorio.");
        return;
      }

      setModalError(null);
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = config.creatingLabel;
      }

      try {
        const body = config.buildBody(name);
        const response = await fetch(config.endpoint, {
          method: "POST",
          headers: { Accept: "application/json" },
          body,
          credentials: "same-origin",
        });

        const payload = (await response.json().catch(() => null)) as {
          data?: { id: string; name: string };
          error?: string;
        } | null;

        if (!response.ok) {
          throw new Error(
            payload?.error ||
              `No se pudo crear la ${config.kind === "category" ? "saga" : "línea"}`,
          );
        }

        const created = payload?.data;
        if (!created?.id || !created?.name) {
          throw new Error("Respuesta inválida del servidor");
        }

        selectCreatedOption(config.selectId, created);
        closeModal();
      } catch (error) {
        setModalError(
          error instanceof Error
            ? error.message
            : `Error al crear la ${config.kind === "category" ? "saga" : "línea"}`,
        );
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = config.submitLabel;
        }
      }
    });
  };

  const bindImageUpload = () => {
    const fileInput = document.getElementById(
      "image-upload",
    ) as HTMLInputElement | null;
    if (!fileInput || fileInput.dataset.bound === "1") return;
    fileInput.dataset.bound = "1";

    const statusText = document.getElementById("upload-status");
    const imageUrlInput = document.getElementById(
      "imageUrl",
    ) as HTMLInputElement | null;
    const previewContainer = document.getElementById("image-preview-container");
    const previewImg = document.getElementById(
      "image-preview",
    ) as HTMLImageElement | null;
    const urlText = document.getElementById("image-url-text");

    fileInput.addEventListener("change", async () => {
      const file = fileInput.files?.[0];
      if (!file) return;

      if (file.size > 5 * 1024 * 1024) {
        if (statusText) {
          statusText.textContent = "LA IMAGEN SUPERA 5MB";
          statusText.classList.add("text-red-500");
        }
        fileInput.value = "";
        return;
      }

      const originalStatus = statusText?.innerHTML;
      if (statusText)
        statusText.textContent = "OPTIMIZANDO Y CONSIGNANDO AL SANTUARIO...";
      fileInput.disabled = true;

      try {
        const compressed = await compressImageFile(file, {
          maxEdge: 1600,
          quality: 0.78,
        });
        const formData = new FormData();
        formData.append("file", compressed);

        const response = await fetch("/api/upload-product-image", {
          method: "POST",
          body: formData,
        });

        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.error || "Error en la subida");
        }

        const data = await response.json();

        if (imageUrlInput) {
          imageUrlInput.value = data.url;
        }

        if (previewImg) previewImg.src = data.url;
        if (urlText) urlText.textContent = data.url;
        if (previewContainer) previewContainer.classList.remove("hidden");
        if (statusText)
          statusText.textContent = "¡ARMADURA REGISTRADA CON ÉXITO!";

        setTimeout(() => {
          if (statusText && originalStatus) statusText.innerHTML = originalStatus;
        }, 3000);
      } catch (error: unknown) {
        console.error("Upload error:", error);
        if (statusText) {
          const message =
            error instanceof Error ? error.message : "Error en la subida";
          statusText.textContent = "ERROR EN EL REGISTRO: " + message;
          statusText.classList.add("text-red-500");
        }
      } finally {
        fileInput.disabled = false;
      }
    });
  };

  const bindCategoryModalImageUpload = () => {
    const fileInput = document.getElementById(
      "modal-category-image-upload",
    ) as HTMLInputElement | null;
    if (!fileInput || fileInput.dataset.bound === "1") return;
    fileInput.dataset.bound = "1";

    fileInput.addEventListener("change", async () => {
      const statusText = document.getElementById(
        "modal-category-upload-status",
      );
      const imageUrlInput = document.getElementById(
        "modal-category-imageUrl",
      ) as HTMLInputElement | null;
      const previewContainer = document.getElementById(
        "modal-category-image-preview-container",
      );
      const previewImg = document.getElementById(
        "modal-category-image-preview",
      ) as HTMLImageElement | null;
      const urlText = document.getElementById(
        "modal-category-image-url-text",
      );
      const file = fileInput.files?.[0];

      if (!file) return;

      if (file.size > 5 * 1024 * 1024) {
        if (statusText) {
          statusText.textContent = "LA IMAGEN SUPERA 5MB";
          statusText.classList.add("text-red-500");
        }
        fileInput.value = "";
        return;
      }

      const originalStatus = statusText?.innerHTML;
      if (statusText) {
        statusText.textContent = "OPTIMIZANDO Y COPIANDO AL ARCHIVO...";
        statusText.classList.remove("text-red-500");
      }
      fileInput.disabled = true;

      try {
        const compressed = await compressImageFile(file, {
          maxEdge: 1920,
          quality: 0.78,
        });
        const formData = new FormData();
        formData.append("file", compressed);

        const response = await fetch("/api/upload-category-image", {
          method: "POST",
          body: formData,
        });

        if (!response.ok) {
          const responseText = await response.text();
          let message = responseText || "Error en la subida";
          try {
            const error = JSON.parse(responseText) as { error?: string };
            message = error.error || message;
          } catch {
            // The server can return plain text before our JSON endpoint runs.
          }
          throw new Error(message);
        }

        const data = (await response.json()) as { url: string };

        if (imageUrlInput) imageUrlInput.value = data.url;
        if (previewImg) {
          previewImg.src = data.url;
          previewImg.alt = "Vista previa del banner de la saga";
        }
        if (urlText) urlText.textContent = data.url;
        if (previewContainer) previewContainer.classList.remove("hidden");
        if (statusText) statusText.textContent = "¡BANNER VINCULADO!";

        setTimeout(() => {
          if (statusText && originalStatus) statusText.innerHTML = originalStatus;
        }, 3000);
      } catch (error: unknown) {
        console.error("Category modal upload error:", error);
        if (statusText) {
          const message =
            error instanceof Error ? error.message : "Error en la subida";
          statusText.textContent = "ERROR: " + message;
          statusText.classList.add("text-red-500");
        }
      } finally {
        fileInput.disabled = false;
      }
    });
  };

  const bindAutoResize = () => {
    const textareas = document.querySelectorAll<HTMLTextAreaElement>(
      "textarea[data-autoresize]",
    );
    const maxHeight = 640;

    textareas.forEach((textarea) => {
      if (textarea.dataset.boundAutoResize === "1") return;
      textarea.dataset.boundAutoResize = "1";

      const resize = () => {
        textarea.style.height = "auto";
        const nextHeight = Math.min(Math.max(textarea.scrollHeight, 144), maxHeight);
        textarea.style.height = `${nextHeight}px`;
        textarea.style.overflowY = textarea.scrollHeight > maxHeight ? "auto" : "hidden";
      };

      textarea.addEventListener("input", resize);
      requestAnimationFrame(resize);
    });
  };

  const initializeProductForm = () => {
    if (!document.getElementById("open-category-modal")) return;

    bindImageUpload();
    bindCategoryModalImageUpload();
    bindAutoResize();

    bindCreateModal({
      kind: "category",
      overlayId: "category-modal-overlay",
      modalId: "category-modal",
      openBtnId: "open-category-modal",
      closeBtnId: "category-modal-close",
      cancelBtnId: "category-modal-cancel",
      formId: "category-modal-form",
      nameInputId: "modal-category-name",
      activeInputId: "modal-category-active",
      errorId: "category-modal-error",
      submitBtnId: "category-modal-submit",
      selectId: "categoryId",
      endpoint: "/api/admin/categories/actions",
      submitLabel: "Crear saga",
      creatingLabel: "Creando...",
      buildBody: (name) => {
        const body = new FormData();
        body.set("_action", "create");
        body.set("responseFormat", "json");
        body.set("name", name);
        body.set(
          "imageUrl",
          (
            document.getElementById(
              "modal-category-imageUrl",
            ) as HTMLInputElement | null
          )?.value.trim() || "",
        );
        const active = document.getElementById(
          "modal-category-active",
        ) as HTMLInputElement | null;
        if (active?.checked) body.set("isActive", "true");
        return body;
      },
    });

    bindCreateModal({
      kind: "collection",
      overlayId: "collection-modal-overlay",
      modalId: "collection-modal",
      openBtnId: "open-collection-modal",
      closeBtnId: "collection-modal-close",
      cancelBtnId: "collection-modal-cancel",
      formId: "collection-modal-form",
      nameInputId: "modal-collection-name",
      activeInputId: "modal-collection-active",
      errorId: "collection-modal-error",
      submitBtnId: "collection-modal-submit",
      selectId: "collectionId",
      endpoint: "/api/admin/collections/actions",
      submitLabel: "Crear línea",
      creatingLabel: "Creando...",
      buildBody: (name) => {
        const body = new FormData();
        body.set("_action", "create");
        body.set("responseFormat", "json");
        body.set("name", name);
        const active = document.getElementById(
          "modal-collection-active",
        ) as HTMLInputElement | null;
        if (active?.checked) body.set("isActive", "true");
        return body;
      },
    });
  };

  initializeProductForm();
  document.addEventListener("astro:page-load", initializeProductForm);
</script>
