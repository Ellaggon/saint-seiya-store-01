---
import MainLayout from "@/ui/layouts/MainLayout.astro";
import type { StoreSettingsContent } from "@/application/dto/storeSettings.dto";

interface Props {
  settings: StoreSettingsContent;
  saved?: boolean;
  error?: string | null;
}

const { settings, saved = false, error = null } = Astro.props;

const fieldClass =
  "w-full border border-zinc-800 bg-black px-4 py-3 text-sm text-white outline-none transition-colors focus:border-amber-500";
const labelClass =
  "block text-[10px] font-black uppercase tracking-widest text-amber-500";
const hintClass = "text-[10px] uppercase tracking-widest text-zinc-600";
---

<MainLayout title="Admin - Redes sociales">
  <div class="mx-auto max-w-[800px] px-6 py-12">
    <div class="mb-10 space-y-2">
      <p class="text-[10px] font-black uppercase tracking-[0.4em] text-amber-500">
        Panel de Control
      </p>
      <h1 class="text-4xl font-black uppercase tracking-tighter text-white">
        Redes sociales
      </h1>
      <p class="max-w-xl text-sm text-zinc-500">
        Gestiona los iconos del footer, WhatsApp de soporte y el QR bancario del
        checkout.
      </p>
      <div class="h-1 w-12 bg-amber-500"></div>
    </div>

    {
      saved && (
        <div class="mb-8 border border-green-500/30 bg-green-500/5 px-5 py-4 text-xs font-bold uppercase tracking-widest text-green-400">
          Configuración de redes guardada.
        </div>
      )
    }
    {
      error && (
        <div class="mb-8 border border-red-500/30 bg-red-500/5 px-5 py-4 text-xs font-bold uppercase tracking-widest text-red-400">
          {error}
        </div>
      )
    }

    <form
      action="/api/admin/social/actions"
      method="POST"
      class="space-y-8"
    >
      <section class="overflow-hidden border border-zinc-900 bg-zinc-950">
        <div class="border-b border-zinc-900 px-5 py-4">
          <p class="text-[10px] font-black uppercase tracking-[0.35em] text-amber-500">
            Footer del sitio
          </p>
          <h2 class="text-lg font-black uppercase tracking-tight text-white">
            Redes del sitio
          </h2>
          <p class="mt-1 text-xs text-zinc-500">
            Iconos visibles en el pie de página (home y resto del sitio).
          </p>
        </div>

        <div class="space-y-6 px-5 py-6">
          <div class="space-y-2">
            <label for="socialWhatsApp" class={labelClass}>
              WhatsApp (footer)
            </label>
            <input
              type="tel"
              id="socialWhatsApp"
              name="socialWhatsApp"
              value={settings.socialWhatsApp}
              placeholder="59170000000"
              inputmode="numeric"
              autocomplete="tel"
              class={fieldClass}
            />
            <p class={hintClass}>
              Solo número con código de país, sin + ni espacios. Ej: 5917…
            </p>
          </div>

          <div class="space-y-2">
            <label for="instagramUrl" class={labelClass}>Instagram</label>
            <input
              type="text"
              id="instagramUrl"
              name="instagramUrl"
              value={settings.instagramUrl}
              placeholder="https://instagram.com/tu_cuenta o @tu_cuenta"
              class={fieldClass}
            />
            <p class={hintClass}>URL completa o @usuario.</p>
          </div>

          <div class="space-y-2">
            <label for="facebookUrl" class={labelClass}>Facebook</label>
            <input
              type="text"
              id="facebookUrl"
              name="facebookUrl"
              value={settings.facebookUrl}
              placeholder="https://facebook.com/tu_pagina o tu_pagina"
              class={fieldClass}
            />
            <p class={hintClass}>URL completa o nombre de página/usuario.</p>
          </div>

          <div class="space-y-2">
            <label for="tiktokUrl" class={labelClass}>TikTok</label>
            <input
              type="text"
              id="tiktokUrl"
              name="tiktokUrl"
              value={settings.tiktokUrl}
              placeholder="https://www.tiktok.com/@tu_cuenta o @tu_cuenta"
              class={fieldClass}
            />
            <p class={hintClass}>URL completa o @usuario.</p>
          </div>
        </div>
      </section>

      <section class="overflow-hidden border border-zinc-900 bg-zinc-950">
        <div class="border-b border-zinc-900 px-5 py-4">
          <p class="text-[10px] font-black uppercase tracking-[0.35em] text-amber-500">
            Checkout
          </p>
          <h2 class="text-lg font-black uppercase tracking-tight text-white">
            WhatsApp del carrito
          </h2>
          <p class="mt-1 text-xs text-zinc-500">
            Número usado para soporte del carrito y avisos de pago QR. Si está
            vacío, esos botones permanecen desactivados (salvo fallback de
            entorno).
          </p>
        </div>

        <div class="space-y-6 px-5 py-6">
          <div class="space-y-2">
            <label for="cartWhatsApp" class={labelClass}>
              Número de WhatsApp (carrito / pagos)
            </label>
            <input
              type="tel"
              id="cartWhatsApp"
              name="cartWhatsApp"
              value={settings.cartWhatsApp}
              placeholder="59170000000"
              inputmode="numeric"
              autocomplete="tel"
              class={fieldClass}
            />
            <p class={hintClass}>
              Independiente del WhatsApp del footer.
            </p>
          </div>
        </div>
      </section>

      <section class="overflow-hidden border border-zinc-900 bg-zinc-950">
        <div class="border-b border-zinc-900 px-5 py-4">
          <p class="text-[10px] font-black uppercase tracking-[0.35em] text-amber-500">
            Pagos
          </p>
          <h2 class="text-lg font-black uppercase tracking-tight text-white">
            QR bancario
          </h2>
          <p class="mt-1 text-xs text-zinc-500">
            Imagen e instrucciones mostradas en la pantalla de pago del cliente.
          </p>
        </div>

        <div class="space-y-6 px-5 py-6">
          <div class="space-y-2">
            <label for="paymentQrImageUrl" class={labelClass}>
              URL de la imagen QR
            </label>
            <input
              type="url"
              id="paymentQrImageUrl"
              name="paymentQrImageUrl"
              value={settings.paymentQrImageUrl}
              placeholder="https://…/qr.png"
              class={fieldClass}
            />
            <p class={hintClass}>
              Sube la imagen del QR a tu storage y pega la URL pública aquí.
            </p>
            {
              settings.paymentQrImageUrl && (
                <img
                  src={settings.paymentQrImageUrl}
                  alt="Vista previa QR"
                  class="mt-3 max-h-40 w-auto border border-zinc-800 bg-white p-2"
                />
              )
            }
          </div>
          <div class="space-y-2">
            <label for="paymentQrBankName" class={labelClass}>
              Banco / titular
            </label>
            <input
              type="text"
              id="paymentQrBankName"
              name="paymentQrBankName"
              value={settings.paymentQrBankName}
              placeholder="Banco X — Sanctuary"
              class={fieldClass}
            />
          </div>
          <div class="space-y-2">
            <label for="paymentQrInstructions" class={labelClass}>
              Instrucciones al cliente
            </label>
            <textarea
              id="paymentQrInstructions"
              name="paymentQrInstructions"
              rows="3"
              class={fieldClass}
              placeholder="Paga el monto exacto e incluye la referencia del pedido en el concepto."
            >{settings.paymentQrInstructions}</textarea>
          </div>
        </div>
      </section>

      <button
        type="submit"
        class="w-full bg-white py-5 text-[11px] font-black uppercase tracking-[0.2em] text-black transition-all duration-300 hover:bg-amber-500"
      >
        Guardar configuración
      </button>
    </form>
  </div>
</MainLayout>
