---
import MainLayout from "../../layouts/MainLayout.astro";
---

<MainLayout title="Cambiar Contraseña">
  <div class="min-h-[80vh] flex items-center justify-center px-6">
    <div
      class="w-full max-w-md space-y-8 bg-zinc-950 p-8 border border-zinc-900 shadow-2xl"
    >
      <div class="text-center space-y-2">
        <div class="w-12 h-px bg-amber-500 mx-auto mb-6"></div>
        <h1 class="text-3xl font-black text-white uppercase tracking-tighter">
          Nueva Contraseña
        </h1>
        <p class="text-zinc-500 text-xs font-bold uppercase tracking-widest">
          Define una contraseña segura para tu cuenta
        </p>
      </div>

      <div
        id="error-message"
        class="hidden text-red-500 text-[11px] font-bold uppercase tracking-wider bg-red-500/10 p-3 border border-red-500/20"
      >
      </div>

      <div
        id="success-message"
        class="hidden text-amber-500 text-[11px] font-bold uppercase tracking-wider bg-amber-500/10 p-4 border border-amber-500/20"
      >
        Contraseña actualizada. Ya puedes iniciar sesión.
      </div>

      <form id="reset-password-form" class="mt-8 space-y-6 hidden">
        <div class="space-y-4">
          <div>
            <label
              for="password"
              class="block text-[10px] font-black text-amber-500 uppercase tracking-widest mb-2"
              >Nueva Contraseña</label
            >
            <input
              id="password"
              name="password"
              type="password"
              required
              minlength="8"
              class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors"
              placeholder="••••••••"
            />
          </div>
          <div>
            <label
              for="password-confirmation"
              class="block text-[10px] font-black text-amber-500 uppercase tracking-widest mb-2"
              >Confirmar Contraseña</label
            >
            <input
              id="password-confirmation"
              name="passwordConfirmation"
              type="password"
              required
              minlength="8"
              class="w-full bg-black border border-zinc-800 px-4 py-3 text-white text-sm focus:border-amber-500 focus:outline-none transition-colors"
              placeholder="••••••••"
            />
          </div>
        </div>

        <button
          type="submit"
          id="submit-button"
          class="group w-full flex justify-center items-center py-4 px-4 border border-zinc-800 text-xs font-black text-white uppercase tracking-[0.2em] hover:bg-white hover:text-black transition-all duration-300 focus:outline-none disabled:cursor-not-allowed disabled:opacity-60"
        >
          <span id="button-text">GUARDAR CONTRASEÑA</span>
          <div
            id="loading-spinner"
            class="hidden ml-2 w-4 h-4 border-2 border-zinc-500 border-t-white rounded-full animate-spin"
          >
          </div>
        </button>
      </form>

      <div
        id="loading-message"
        class="text-zinc-500 text-[11px] font-bold uppercase tracking-wider bg-black p-4 border border-zinc-900"
      >
        Validando enlace de recuperación...
      </div>

      <div class="text-center pt-4">
        <a
          href="/login"
          class="text-zinc-600 hover:text-amber-500 transition-colors text-[10px] uppercase tracking-widest font-bold border-b border-zinc-800 hover:border-amber-500 pb-0.5"
          >Volver al inicio de sesión</a
        >
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import { supabase } from "../../../lib/supabaseClient";

  const form = document.getElementById("reset-password-form") as HTMLFormElement;
  const submitButton = document.getElementById(
    "submit-button",
  ) as HTMLButtonElement;
  const buttonText = document.getElementById("button-text");
  const loadingSpinner = document.getElementById("loading-spinner");
  const errorDisplay = document.getElementById("error-message");
  const successDisplay = document.getElementById("success-message");
  const loadingMessage = document.getElementById("loading-message");

  const showError = (message: string) => {
    if (loadingMessage) loadingMessage.classList.add("hidden");
    successDisplay?.classList.add("hidden");
    if (errorDisplay) {
      errorDisplay.classList.remove("hidden");
      errorDisplay.textContent = message;
    }
  };

  const initializeRecoverySession = async () => {
    const hashParams = new URLSearchParams(window.location.hash.slice(1));
    const accessToken = hashParams.get("access_token");
    const refreshToken = hashParams.get("refresh_token");
    const type = hashParams.get("type");

    if (!accessToken || !refreshToken || type !== "recovery") {
      const {
        data: { session },
      } = await supabase.auth.getSession();

      if (session) {
        loadingMessage?.classList.add("hidden");
        form?.classList.remove("hidden");
        return;
      }

      showError(
        "Abre esta página desde el enlace de recuperación enviado a tu correo. Si el enlace expiró, solicita uno nuevo.",
      );
      return;
    }

    const { error } = await supabase.auth.setSession({
      access_token: accessToken,
      refresh_token: refreshToken,
    });

    if (error) {
      showError("No se pudo validar el enlace de recuperación.");
      return;
    }

    window.history.replaceState(null, "", window.location.pathname);
    loadingMessage?.classList.add("hidden");
    form?.classList.remove("hidden");
  };

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const formData = new FormData(form);
    const password = formData.get("password") as string;
    const passwordConfirmation = formData.get("passwordConfirmation") as string;

    errorDisplay?.classList.add("hidden");
    successDisplay?.classList.add("hidden");
    if (errorDisplay) errorDisplay.textContent = "";

    if (password !== passwordConfirmation) {
      showError("Las contraseñas no coinciden.");
      return;
    }

    submitButton.disabled = true;
    buttonText?.classList.add("opacity-50");
    loadingSpinner?.classList.remove("hidden");

    try {
      const { error } = await supabase.auth.updateUser({ password });

      if (error) throw error;

      successDisplay?.classList.remove("hidden");
      form.reset();
      window.setTimeout(() => {
        window.location.href = "/login";
      }, 1800);
    } catch (error: unknown) {
      const message = error instanceof Error ? error.message : null;
      showError(message || "No se pudo actualizar la contraseña.");
    } finally {
      submitButton.disabled = false;
      buttonText?.classList.remove("opacity-50");
      loadingSpinner?.classList.add("hidden");
    }
  });

  initializeRecoverySession();
</script>
