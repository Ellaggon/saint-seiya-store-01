---
import MainLayout from "../../layouts/MainLayout.astro";
import GlobalHeroWrapper from "../../components/layout/GlobalHeroWrapper.astro";
import Section from "../../components/layout/Section.astro";
import CatalogToolbar from "../../components/catalog/CatalogToolbar.astro";
import CatalogSidebarFilters from "../../components/catalog/CatalogSidebarFilters.astro";
import CatalogCategoryHero from "../../components/catalog/CatalogCategoryHero.astro";
import CatalogResults from "../../components/catalog/CatalogResults.astro";

import { CatalogQueryService } from "../../../application/services/CatalogQueryService";
import { GetCatalogPageDataUseCase } from "../../../application/use-cases/catalog/GetCatalogPageDataUseCase";
import { PrismaCatalogQueryRepository } from "../../../infrastructure/database/PrismaCatalogQueryRepository";
import { parseCatalogFilters } from "@/shared/listing/catalogQuery";
import { buildPageUrl } from "@/shared/listing/queryParams";
import { toCatalogProductCardProps } from "../../components/catalog/productCardViewModel";

// Instantiate Service and Use Case
const queryService = new CatalogQueryService(new PrismaCatalogQueryRepository());
const getCatalogPageData = new GetCatalogPageDataUseCase(queryService);

// Read search params for filtering
const params = Astro.url.searchParams;
const currentFilters = parseCatalogFilters(params, { page: 1, pageSize: 24 });

// Execute Use Case for consolidated data fetching and caching
const { products: catalogResult, filters: metadata } =
  await getCatalogPageData.execute(currentFilters);

const products = catalogResult.items.map(toCatalogProductCardProps);
const catalogStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Catálogo Saint Seiya Store",
  itemListElement: products.map((product, index) => ({
    "@type": "ListItem",
    position: (catalogResult.pagination.page - 1) * catalogResult.pagination.pageSize + index + 1,
    item: {
      "@type": "Product",
      name: product.name,
      image: product.image,
      url: new URL(`/product/${product.id}`, Astro.url.origin).toString(),
      offers: {
        "@type": "Offer",
        priceCurrency: "BOB",
        price: product.price,
        availability: product.displayAvailability.schemaAvailability,
      },
    },
  })),
};

// Helper to build category URL
const getCategoryUrl = (slug?: string) => {
  const url = new URL("/catalog", Astro.url.origin);
  if (slug) url.searchParams.set("category", slug);
  // Keep other filters if needed
  params.forEach((val, key) => {
    if (key !== "category") url.searchParams.set(key, val);
  });
  url.searchParams.delete("page");
  return url.pathname + url.search;
};

const getPageUrl = (page: number) =>
  buildPageUrl(Astro.url.pathname, Astro.url.origin, params, page);
---

<MainLayout
  title="Catálogo"
  description="Catálogo de figuras Saint Seiya disponibles y preventas activas en Bolivianos."
  structuredData={catalogStructuredData}
>
  <GlobalHeroWrapper
    title="Catálogo"
    subtitle="Figuras disponibles y preventas seleccionadas."
    compact={true}
  />

  <CatalogCategoryHero
    categories={metadata?.categories || []}
    currentCategory={currentFilters.category}
    getCategoryUrl={getCategoryUrl}
  />

  <Section variant="black">
    <div class="px-4" id="catalog-marketplace">
      <div
        class="flex flex-col lg:flex-row gap-10 xl:gap-14 max-w-[1480px] mx-auto pt-8 md:pt-10"
      >
        <!-- Sidebar -->
        <div class="w-full lg:w-auto">
          <CatalogSidebarFilters
            metadata={metadata}
            currentFilters={currentFilters}
          />
        </div>

        <!-- Main Content (Toolbar + Grid) -->
        <main class="flex-1 min-w-0 flex flex-col">
          <CatalogToolbar
            resultCount={catalogResult.pagination.total}
            currentSort={catalogResult.sort}
            currentQuery={currentFilters.q}
          />

          <CatalogResults
            catalogResult={catalogResult}
            products={products}
            getPageUrl={getPageUrl}
            metadata={metadata}
            currentFilters={currentFilters}
          />
        </main>
      </div>
    </div>
  </Section>

  <!-- Skeleton Template for AJAX loading (Step 8) -->
  <template id="catalog-skeleton-template">
    <div
      class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 md:gap-10"
    >
      {
        Array.from({ length: 8 }).map(() => (
          <div class="flex flex-col gap-4 animate-pulse">
            <div class="w-full aspect-square bg-zinc-950 border border-zinc-900" />
            <div class="flex flex-col gap-2">
              <div class="h-3 bg-zinc-900 w-1/3 mt-1" />
              <div class="h-4 bg-zinc-800 w-full mt-1" />
              <div class="h-4 bg-zinc-800 w-5/6" />
              <div class="flex items-center justify-between mt-3">
                <div class="h-2 bg-zinc-900 w-1/4" />
                <div class="h-4 bg-zinc-800 w-1/5" />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </template>

  <script src="../../scripts/catalogFilters.ts"></script>
</MainLayout>
