---
import MainLayout from "../../layouts/MainLayout.astro";
import GlobalHeroWrapper from "../../components/layout/GlobalHeroWrapper.astro";
import Section from "../../components/layout/Section.astro";
import CatalogSidebarFilters from "../../components/catalog/CatalogSidebarFilters.astro";
import CatalogCategoryHero from "../../components/catalog/CatalogCategoryHero.astro";
import CatalogResults from "../../components/catalog/CatalogResults.astro";

import { CatalogQueryService } from "../../../application/services/CatalogQueryService";
import { GetCatalogPageDataUseCase } from "../../../application/use-cases/catalog/GetCatalogPageDataUseCase";
import { PrismaCatalogQueryRepository } from "../../../infrastructure/database/PrismaCatalogQueryRepository";
import { parseCatalogFilters } from "@/shared/listing/catalogQuery";
import { buildPageUrl } from "@/shared/listing/queryParams";
import { siteOrigin } from "@/lib/siteUrl";
import { toCatalogProductCardProps } from "../../components/catalog/productCardViewModel";

// Instantiate Service and Use Case
const queryService = new CatalogQueryService(new PrismaCatalogQueryRepository());
const getCatalogPageData = new GetCatalogPageDataUseCase(queryService);

// Read search params for filtering
const params = Astro.url.searchParams;
const currentFilters = parseCatalogFilters(params, { page: 1, pageSize: 24 });
const isBaseCatalogPage = params.toString().length === 0;

Astro.response.headers.set(
  "Cache-Control",
  isBaseCatalogPage
    ? "public, max-age=0, s-maxage=300, stale-while-revalidate=600"
    : "public, max-age=0, s-maxage=60, stale-while-revalidate=300",
);
Astro.response.headers.set(
  "CDN-Cache-Control",
  isBaseCatalogPage
    ? "public, max-age=300, stale-while-revalidate=600"
    : "public, max-age=60, stale-while-revalidate=300",
);

// Execute Use Case for consolidated data fetching and caching
const { products: catalogResult, filters: metadata } =
  await getCatalogPageData.execute(currentFilters);

const products = catalogResult.items.map(toCatalogProductCardProps);
const activeCategory = metadata?.categories.find(
  (category) => category.slug === currentFilters.category,
);
const catalogStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Catálogo Saint Seiya Store",
  itemListElement: products.map((product, index) => ({
    "@type": "ListItem",
    position: (catalogResult.pagination.page - 1) * catalogResult.pagination.pageSize + index + 1,
    item: {
      "@type": "Product",
      name: product.name,
      image: product.image,
      url: new URL(`/product/${product.id}`, siteOrigin).toString(),
      offers: {
        "@type": "Offer",
        priceCurrency: "BOB",
        price: product.price,
        availability: product.displayAvailability.schemaAvailability,
      },
    },
  })),
};

// Helper to build category URL
const getCategoryUrl = (slug?: string) => {
  const url = new URL("/catalog", Astro.url.origin);
  if (slug) url.searchParams.set("category", slug);
  // Keep other filters if needed
  params.forEach((val, key) => {
    if (key !== "category") url.searchParams.set(key, val);
  });
  url.searchParams.delete("page");
  return url.pathname + url.search;
};

const getPageUrl = (page: number) =>
  buildPageUrl(Astro.url.pathname, Astro.url.origin, params, page);
const catalogVisualHeaderStyle = activeCategory?.imageUrl
  ? `background-image: url('${activeCategory.imageUrl}')`
  : "";
---

<MainLayout
  title="Catálogo"
  description="Catálogo de figuras Saint Seiya disponibles y preventas activas en Bolivianos."
  structuredData={catalogStructuredData}
>
  <div
    id="catalog-visual-header"
    class="relative overflow-hidden bg-black bg-cover bg-center bg-no-repeat"
    style={catalogVisualHeaderStyle}
  >
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black via-black/45 to-black/80"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black to-transparent"></div>

    <div class="relative z-10">
      <GlobalHeroWrapper
        htmlId="catalog-hero"
        defaultTitle="Catálogo"
        defaultSubtitle="Figuras disponibles."
        title={activeCategory?.name || "Catálogo"}
        subtitle={
          activeCategory
            ? "Figuras disponibles de esta saga."
            : "Figuras disponibles."
        }
        compact={true}
        inheritedBackground={true}
        hideArchitecturalLines={true}
      />

      <CatalogCategoryHero
        categories={metadata?.categories || []}
        currentCategory={currentFilters.category}
        getCategoryUrl={getCategoryUrl}
      />
    </div>
  </div>

  <Section variant="black" fullWidth={true}>
    <div
      id="catalog-marketplace"
      class="px-4 sm:px-6 md:px-8 lg:px-6 xl:px-20 2xl:px-32"
    >
      <div
        class="flex flex-col gap-6 pt-4 md:gap-8 md:pt-6 lg:flex-row lg:pt-8 xl:gap-10 2xl:gap-12 w-full"
      >
        <!-- Sidebar -->
        <div
          data-catalog-sidebar-column
          class="w-full lg:flex lg:flex-shrink-0 lg:items-start lg:gap-3 lg:overflow-visible"
        >
          <div id="catalog-sidebar" data-catalog-sidebar>
            <CatalogSidebarFilters
              metadata={metadata}
              currentFilters={currentFilters}
            />
          </div>

          <button
            id="catalog-sidebar-toggle"
            type="button"
            class="hidden lg:sticky lg:top-28 lg:flex h-36 w-10 flex-none items-center justify-center gap-2 rounded-md border border-white/10 bg-zinc-950/75 text-zinc-500 shadow-[inset_0_1px_0_rgba(255,255,255,0.05),0_18px_45px_rgba(0,0,0,0.28)] backdrop-blur transition-all duration-200 hover:border-amber-500/50 hover:bg-zinc-900 hover:text-amber-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500/50"
            aria-controls="catalog-sidebar"
            aria-expanded="true"
            aria-label="Ocultar filtros"
            title="Ocultar filtros"
          >
            <span
              data-sidebar-toggle-label
              class="text-[10px] font-black uppercase tracking-[0.24em]"
              style="writing-mode: vertical-rl;"
            >
              Filtros
            </span>
            <svg
              data-sidebar-toggle-chevron
              class="h-3.5 w-3.5 transition-transform duration-300"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="square"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>
        </div>

        <!-- Main Content -->
        <main class="flex-1 min-w-0 flex flex-col xl:px-20">
          <CatalogResults
            catalogResult={catalogResult}
            products={products}
            getPageUrl={getPageUrl}
          />
        </main>
      </div>
    </div>
  </Section>

  <!-- Skeleton Template for AJAX loading (Step 8) -->
  <template id="catalog-skeleton-template">
    <div
      class="catalog-skeleton-grid grid grid-cols-1 gap-5 md:gap-6 lg:grid-cols-2 xl:grid-cols-3 xl:gap-10 2xl:grid-cols-4"
    >
      {
        Array.from({ length: 8 }).map(() => (
          <div class="grid h-[188px] grid-cols-[112px_minmax(0,1fr)] items-stretch gap-3 animate-pulse overflow-hidden sm:h-[204px] sm:grid-cols-[150px_minmax(0,1fr)] sm:gap-4 md:h-[220px] md:grid-cols-[180px_minmax(0,1fr)] lg:flex lg:h-auto lg:flex-col lg:overflow-visible">
            <div class="h-full rounded-[14px] bg-zinc-950 border border-zinc-900 lg:aspect-[4/5] lg:h-auto lg:w-full lg:rounded-[18px]" />
            <div class="flex min-h-0 flex-col justify-between gap-2 py-0.5">
              <div class="space-y-1">
                <div class="h-4 w-1/3 rounded bg-zinc-900" />
                <div class="h-[2.75rem] w-full rounded bg-zinc-800" />
                <div class="h-4 w-2/3 rounded bg-zinc-900" />
              </div>
              <div class="flex items-center justify-between gap-4">
                <div class="h-4 w-1/4 rounded bg-zinc-800" />
                <div class="h-3 w-1/5 rounded bg-zinc-900" />
              </div>
              <div class="h-3 w-1/3 rounded bg-zinc-800" />
            </div>
          </div>
        ))
      }
    </div>
  </template>

  <script src="../../scripts/catalogFilters.ts"></script>

  <style>
    #catalog-visual-header #catalog-hero,
    #catalog-visual-header #catalog-category-strip {
      background-image: none !important;
    }

    @media (min-width: 1024px) {
      #catalog-marketplace [data-catalog-sidebar-column] {
        width: 332px;
        transition:
          width 320ms cubic-bezier(0.22, 1, 0.36, 1),
          margin 320ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      #catalog-marketplace [data-catalog-sidebar] {
        width: 280px;
        flex: 0 0 280px;
        overflow: hidden;
        transition:
          width 320ms cubic-bezier(0.22, 1, 0.36, 1),
          flex-basis 320ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 220ms ease,
          transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 0s;
        will-change: width, opacity, transform;
      }

      #catalog-marketplace [data-sidebar-toggle-chevron] {
        transform-origin: center;
        transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      #catalog-marketplace[data-sidebar-collapsed="true"] [data-catalog-sidebar-column] {
        width: 52px;
      }

      #catalog-marketplace[data-sidebar-collapsed="true"] [data-catalog-sidebar] {
        width: 0;
        flex-basis: 0;
        opacity: 0;
        pointer-events: none;
        transform: translateX(-12px);
        visibility: hidden;
        transition:
          width 320ms cubic-bezier(0.22, 1, 0.36, 1),
          flex-basis 320ms cubic-bezier(0.22, 1, 0.36, 1),
          opacity 180ms ease,
          transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 180ms;
      }

      #catalog-marketplace[data-sidebar-collapsed="true"] [data-sidebar-toggle-chevron] {
        transform: rotate(180deg);
      }

      #catalog-marketplace[data-sidebar-collapsed="true"] #catalog-sidebar-toggle {
        border-color: rgba(245, 158, 11, 0.36);
        color: rgb(245, 158, 11);
      }
    }

  </style>
</MainLayout>
