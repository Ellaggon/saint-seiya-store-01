---
import MainLayout from "../../layouts/MainLayout.astro";
import GlobalHeroWrapper from "../../components/layout/GlobalHeroWrapper.astro";
import Section from "../../components/layout/Section.astro";
import CatalogToolbar from "../../components/catalog/CatalogToolbar.astro";
import CatalogSidebarFilters from "../../components/catalog/CatalogSidebarFilters.astro";
import CatalogCategoryHero from "../../components/catalog/CatalogCategoryHero.astro";
import CatalogResults from "../../components/catalog/CatalogResults.astro";

import { CatalogQueryService } from "../../../application/services/CatalogQueryService";
import { GetCatalogPageDataUseCase } from "../../../application/use-cases/catalog/GetCatalogPageDataUseCase";
import { PrismaCatalogQueryRepository } from "../../../infrastructure/database/PrismaCatalogQueryRepository";
import { parseCatalogFilters } from "@/shared/listing/catalogQuery";
import { buildPageUrl } from "@/shared/listing/queryParams";
import { siteOrigin } from "@/lib/siteUrl";
import { toCatalogProductCardProps } from "../../components/catalog/productCardViewModel";

// Instantiate Service and Use Case
const queryService = new CatalogQueryService(new PrismaCatalogQueryRepository());
const getCatalogPageData = new GetCatalogPageDataUseCase(queryService);

// Read search params for filtering
const params = Astro.url.searchParams;
const currentFilters = parseCatalogFilters(params, { page: 1, pageSize: 24 });
const isBaseCatalogPage = params.toString().length === 0;

Astro.response.headers.set(
  "Cache-Control",
  isBaseCatalogPage
    ? "public, max-age=0, s-maxage=300, stale-while-revalidate=600"
    : "public, max-age=0, s-maxage=60, stale-while-revalidate=300",
);
Astro.response.headers.set(
  "CDN-Cache-Control",
  isBaseCatalogPage
    ? "public, max-age=300, stale-while-revalidate=600"
    : "public, max-age=60, stale-while-revalidate=300",
);

// Execute Use Case for consolidated data fetching and caching
const { products: catalogResult, filters: metadata } =
  await getCatalogPageData.execute(currentFilters);

const products = catalogResult.items.map(toCatalogProductCardProps);
const catalogStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Catálogo Saint Seiya Store",
  itemListElement: products.map((product, index) => ({
    "@type": "ListItem",
    position: (catalogResult.pagination.page - 1) * catalogResult.pagination.pageSize + index + 1,
    item: {
      "@type": "Product",
      name: product.name,
      image: product.image,
      url: new URL(`/product/${product.id}`, siteOrigin).toString(),
      offers: {
        "@type": "Offer",
        priceCurrency: "BOB",
        price: product.price,
        availability: product.displayAvailability.schemaAvailability,
      },
    },
  })),
};

// Helper to build category URL
const getCategoryUrl = (slug?: string) => {
  const url = new URL("/catalog", Astro.url.origin);
  if (slug) url.searchParams.set("category", slug);
  // Keep other filters if needed
  params.forEach((val, key) => {
    if (key !== "category") url.searchParams.set(key, val);
  });
  url.searchParams.delete("page");
  return url.pathname + url.search;
};

const getPageUrl = (page: number) =>
  buildPageUrl(Astro.url.pathname, Astro.url.origin, params, page);
---

<MainLayout
  title="Catálogo"
  description="Catálogo de figuras Saint Seiya disponibles y preventas activas en Bolivianos."
  structuredData={catalogStructuredData}
>
  <GlobalHeroWrapper
    title="Catálogo"
    subtitle="Figuras disponibles y preventas seleccionadas."
    compact={true}
  />

  <CatalogCategoryHero
    categories={metadata?.categories || []}
    currentCategory={currentFilters.category}
    getCategoryUrl={getCategoryUrl}
  />

  <Section variant="black">
    <div class="px-4" id="catalog-marketplace">
      <div
        class="flex flex-col lg:flex-row gap-10 xl:gap-14 max-w-[1480px] mx-auto pt-8 md:pt-10"
      >
        <!-- Sidebar -->
        <div
          data-catalog-sidebar-column
          class="w-full lg:w-[280px] lg:flex-shrink-0 lg:overflow-hidden"
        >
          <button
            id="catalog-sidebar-toggle"
            type="button"
            class="hidden lg:inline-flex mb-5 h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-zinc-950/80 text-zinc-400 shadow-[inset_0_1px_0_rgba(255,255,255,0.06)] backdrop-blur hover:border-white/20 hover:bg-zinc-900 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white/30 transition-[border-color,background-color,color,box-shadow,transform] duration-200 ease-out hover:-translate-y-px"
            aria-controls="catalog-sidebar"
            aria-expanded="true"
            aria-label="Ocultar filtros"
            title="Ocultar filtros"
          >
            <svg
              data-sidebar-toggle-icon
              class="h-[18px] w-[18px]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="3.5" y="4" width="17" height="16" rx="4"></rect>
              <path d="M9.25 4.5v15"></path>
              <path d="M6.25 8.25h.01"></path>
              <path d="M6.25 12h.01"></path>
              <path d="M6.25 15.75h.01"></path>
              <path
                data-sidebar-toggle-chevron
                d="m14.25 9.25 2.75 2.75-2.75 2.75"
              ></path>
            </svg>
          </button>

          <div id="catalog-sidebar" data-catalog-sidebar>
            <CatalogSidebarFilters
              metadata={metadata}
              currentFilters={currentFilters}
            />
          </div>
        </div>

        <!-- Main Content (Toolbar + Grid) -->
        <main class="flex-1 min-w-0 flex flex-col">
          <CatalogToolbar
            resultCount={catalogResult.pagination.total}
            currentSort={catalogResult.sort}
            currentQuery={currentFilters.q}
          />

          <CatalogResults
            catalogResult={catalogResult}
            products={products}
            getPageUrl={getPageUrl}
          />
        </main>
      </div>
    </div>
  </Section>

  <!-- Skeleton Template for AJAX loading (Step 8) -->
  <template id="catalog-skeleton-template">
    <div
      class="catalog-skeleton-grid grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 md:gap-10"
    >
      {
        Array.from({ length: 8 }).map(() => (
          <div class="flex flex-col gap-4 animate-pulse">
            <div class="w-full aspect-[4/5] bg-zinc-950 border border-zinc-900" />
            <div class="flex flex-col gap-2">
              <div class="h-3 bg-zinc-900 w-1/3 mt-1" />
              <div class="h-4 bg-zinc-800 w-full mt-1" />
              <div class="h-4 bg-zinc-800 w-5/6" />
              <div class="flex items-center justify-between mt-3">
                <div class="h-2 bg-zinc-900 w-1/4" />
                <div class="h-4 bg-zinc-800 w-1/5" />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </template>

  <script src="../../scripts/catalogFilters.ts"></script>

  <style>
    @media (min-width: 1024px) {
      #catalog-marketplace [data-catalog-sidebar-column] {
        transition:
          width 320ms cubic-bezier(0.22, 1, 0.36, 1),
          margin 320ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      #catalog-marketplace [data-catalog-sidebar] {
        transition:
          opacity 220ms ease,
          transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 0s;
        will-change: opacity, transform;
      }

      #catalog-marketplace [data-sidebar-toggle-chevron] {
        transform-origin: center;
        transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      #catalog-marketplace[data-sidebar-collapsed="true"] [data-catalog-sidebar-column] {
        width: 40px;
      }

      #catalog-marketplace[data-sidebar-collapsed="true"] [data-catalog-sidebar] {
        opacity: 0;
        pointer-events: none;
        transform: translateX(-10px);
        visibility: hidden;
        transition:
          opacity 180ms ease,
          transform 260ms cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0s linear 180ms;
      }

      #catalog-marketplace[data-sidebar-collapsed="true"] [data-sidebar-toggle-chevron] {
        transform: rotate(180deg);
      }
    }

    @media (min-width: 1024px) {
      :global(#catalog-marketplace[data-sidebar-collapsed="true"] .catalog-products-grid),
      :global(#catalog-marketplace[data-sidebar-collapsed="true"] .catalog-skeleton-grid) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }
  </style>
</MainLayout>
