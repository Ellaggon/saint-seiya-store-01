---
import MainLayout from "../../layouts/MainLayout.astro";
import GlobalHeroWrapper from "../../components/layout/GlobalHeroWrapper.astro";
import Section from "../../components/layout/Section.astro";
import { getHomeContent } from "@/application/services/HomeContentService";
import { prisma } from "@/infrastructure/database/prisma";

const content = await getHomeContent();
const collectionRows = await prisma.collection.findMany({
  where: {
    deletedAt: null,
    slug: {
      in: content.featuredCollections.map((card) => card.collectionSlug),
    },
  },
  select: { name: true, slug: true },
});
const collectionBySlug = new Map(
  collectionRows.map((collection) => [collection.slug, collection.name]),
);
const featuredCards = content.featuredCollections.map((card) => ({
  ...card,
  name: collectionBySlug.get(card.collectionSlug) ?? card.collectionSlug,
  href: `/catalog?collection=${encodeURIComponent(card.collectionSlug)}`,
}));

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=120, stale-while-revalidate=300",
);
Astro.response.headers.set(
  "CDN-Cache-Control",
  "public, max-age=120, stale-while-revalidate=300",
);
---

<MainLayout title="INICIO" preloadImage={content.hero.backgroundImageUrl}>
  <GlobalHeroWrapper
    title={content.hero.title}
    eyebrow={content.hero.secondaryTitle}
    subtitle={content.hero.subtitle}
    fullHeight={true}
    backgroundImage={content.hero.backgroundImageUrl}
    backgroundPosition={content.hero.backgroundPosition || "center 35%"}
    hideArchitecturalLines={true}
    ctaLabel={content.hero.ctaLabel || "Ver preventa"}
    ctaHref={content.hero.ctaHref || "/preorders"}
    prioritizeImage={true}
  />

  <Section variant="black" withBorder={false}>
    <div class="py-20 md:py-28 lg:py-32">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-16 xl:gap-20">
        <div class="flex flex-col gap-6 lg:col-span-5 lg:gap-8">
          <div class="space-y-5">
            <p class="text-[10px] font-black uppercase tracking-[0.35em] text-amber-500">
              Tamashii Nations
            </p>
            <h2 class="max-w-[12ch] text-4xl font-black uppercase leading-[0.92] tracking-tight text-white md:text-5xl lg:text-6xl">
              Precisión al estilo
              <span class="text-amber-500"> Tamashii</span>
            </h2>
            <p class="max-w-md text-sm leading-relaxed text-zinc-400 md:text-[15px] md:leading-7">
              Cada figura combina ingeniería y escultura. En Sanctuary curamos
              las líneas más exigentes para coleccionistas que buscan piezas
              dignas de vitrina.
            </p>
          </div>

          <a
            href="/catalog"
            class="group inline-flex w-fit items-center gap-3 border-b border-amber-500/70 pb-2 text-[11px] font-black uppercase tracking-[0.28em] text-white transition-colors hover:border-white hover:text-amber-400"
          >
            Ver catálogo
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="square"
              stroke-linejoin="round"
              class="text-amber-500 transition-transform group-hover:translate-x-1"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <div class="lg:col-span-7">
          <figure class="relative">
            <div
              class="relative aspect-[4/5] overflow-hidden bg-zinc-950 sm:aspect-[5/4] lg:aspect-[16/11]"
            >
              <div
                class="pointer-events-none absolute inset-0 z-[1] bg-[radial-gradient(ellipse_at_50%_30%,rgba(245,158,11,0.08),transparent_42%)]"
              >
              </div>
              <div
                class="pointer-events-none absolute inset-x-0 bottom-0 z-[1] h-1/3 bg-gradient-to-t from-black via-black/40 to-transparent"
              >
              </div>
              <div
                class="pointer-events-none absolute inset-y-0 left-0 z-[1] w-16 bg-gradient-to-r from-black/50 to-transparent md:w-24"
              >
              </div>
              <img
                src={content.feature.imageUrl}
                alt={`${content.feature.collectionLabel} ${content.feature.name}`}
                class="h-full w-full object-cover object-[50%_18%] opacity-95 transition-opacity duration-500 hover:opacity-100"
                loading="lazy"
              />
            </div>
            <figcaption class="mt-4 flex items-center justify-between gap-4">
              <span class="text-[10px] font-black uppercase tracking-[0.28em] text-zinc-500">
                {content.feature.collectionLabel}
              </span>
              <span class="text-[10px] font-medium uppercase tracking-[0.2em] text-zinc-600">
                {content.feature.name}
              </span>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </Section>

  <Section variant="black" withBorder={false}>
    <div class="text-center my-16 mb-16">
      <h3
        class="text-amber-500 text-[10px] font-black uppercase tracking-[0.4em] mb-4"
      >
        CATEGORÍAS SACRAS
      </h3>
      <h2 class="text-white text-4xl font-black uppercase tracking-tighter">
        COLECCIONES DESTACADAS
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        featuredCards.map((cat) => (
          <a
            href={cat.href}
            class="group relative aspect-[3/4] bg-zinc-950 border border-zinc-900 overflow-hidden hover:border-amber-500 transition-all duration-300"
          >
            <div class="absolute inset-0 bg-gradient-to-b from-transparent to-black/80 z-10 transition-opacity group-hover:opacity-60" />
            <img
              src={cat.imageUrl}
              alt={cat.name}
              class="absolute inset-0 z-0 h-full w-full object-cover object-center"
              loading="lazy"
            />

            <div class="absolute inset-0 flex flex-col items-center justify-end p-8 z-20 translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
              <h4 class="text-white text-xl font-black uppercase tracking-tight mb-2">
                {cat.name}
              </h4>
              <span class="text-amber-500 text-[10px] font-black uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity">
                EXPLORAR →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </Section>
</MainLayout>
