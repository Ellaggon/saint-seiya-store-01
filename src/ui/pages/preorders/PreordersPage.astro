---
import MainLayout from "../../layouts/MainLayout.astro";
import GlobalHeroWrapper from "../../components/layout/GlobalHeroWrapper.astro";
import Section from "../../components/layout/Section.astro";
import CatalogResults from "../../components/catalog/CatalogResults.astro";
import PreorderFilters from "../../components/preorders/PreorderFilters.astro";
import type { PreorderListItemDTO } from "@/application/dto/preorder.dto";
import { getCachedPreorderList } from "@/application/services/PreorderQueryCache";
import { PreorderCampaignStatus } from "@/domain/entities/PreorderCampaign";
import { createListPreordersUseCase } from "@/infrastructure/preorders/PreorderUseCaseFactory";
import { parsePageParams } from "@/shared/listing/pagination";
import { buildPageUrl } from "@/shared/listing/queryParams";
import { resolveSort } from "@/shared/listing/sorting";
import { toPreorderProductCardProps } from "../../components/catalog/productCardViewModel";

const params = Astro.url.searchParams;
const isBasePreordersPage = params.toString().length === 0;

Astro.response.headers.set(
  "Cache-Control",
  isBasePreordersPage
    ? "public, max-age=0, s-maxage=120, stale-while-revalidate=300"
    : "public, max-age=0, s-maxage=60, stale-while-revalidate=180",
);
Astro.response.headers.set(
  "CDN-Cache-Control",
  isBasePreordersPage
    ? "public, max-age=120, stale-while-revalidate=300"
    : "public, max-age=60, stale-while-revalidate=180",
);

const toOptionalNumber = (value: string | null): number | undefined => {
  if (!value) return undefined;
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : undefined;
};

const preorderSorts = ["created-desc", "eta-asc", "price-asc", "price-desc"] as const;
const pageParams = parsePageParams(params, { page: 1, pageSize: 24 });
const currentSort = resolveSort(params.get("sort"), preorderSorts, "created-desc");
const currentFilters = {
  q: params.get("q")?.trim() || undefined,
  collection: params.get("collection") || undefined,
  character: params.get("character") || undefined,
  availability: params.get("availability") || undefined,
  sort: currentSort,
  page: pageParams.page,
  pageSize: pageParams.pageSize,
};

const listPreorders = createListPreordersUseCase();
const preorderInput = {
  status:
    currentFilters.availability === "SOLD_OUT"
      ? PreorderCampaignStatus.SOLD_OUT
      : PreorderCampaignStatus.ACTIVE,
  q: currentFilters.q,
  collection: currentFilters.collection,
  character: currentFilters.character,
  availability:
    currentFilters.availability === "SOLD_OUT" ||
    currentFilters.availability === "AVAILABLE"
      ? currentFilters.availability
      : undefined,
  sort: currentSort,
  page: currentFilters.page,
  pageSize: currentFilters.pageSize,
  minPrice: toOptionalNumber(params.get("minPrice")),
  maxPrice: toOptionalNumber(params.get("maxPrice")),
};
const preorderResult = await getCachedPreorderList(preorderInput, () =>
  listPreorders.execute(preorderInput),
);

const products = preorderResult.items.map(toPreorderProductCardProps);

const countBySlug = (
  items: PreorderListItemDTO[],
  selector: (item: PreorderListItemDTO) => { name: string; slug: string } | null | undefined,
) => {
  const map = new Map<string, { name: string; slug: string; count: number }>();
  items.forEach((item) => {
    const value = selector(item);
    if (!value) return;
    const existing = map.get(value.slug);
    map.set(value.slug, {
      ...value,
      count: (existing?.count ?? 0) + 1,
    });
  });
  return Array.from(map.values()).sort((a, b) => a.name.localeCompare(b.name));
};

const collections = countBySlug(preorderResult.items, (item) => item.product.collection);
const characters = countBySlug(
  preorderResult.items,
  (item) => item.product.characters?.[0],
);

const catalogResult = {
  items: [],
  pagination: {
    page: preorderResult.page,
    pageSize: preorderResult.pageSize,
    total: preorderResult.total,
    totalPages: preorderResult.totalPages,
  },
  sort: currentFilters.sort,
};

const getPageUrl = (page: number) =>
  buildPageUrl(Astro.url.pathname, Astro.url.origin, params, page);

const clearQueryHref = (() => {
  const url = new URL(Astro.url.href);
  url.searchParams.delete("q");
  url.searchParams.delete("page");
  const search = url.searchParams.toString();
  return `${url.pathname}${search ? `?${search}` : ""}`;
})();
---

<MainLayout
  title="Preventas"
  description="Preventas Saint Seiya con cupos reservados y abonos disponibles."
>
  <div class="relative overflow-hidden bg-black">
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black via-black/45 to-black/80"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black to-transparent"></div>

    <div class="relative z-10">
      <GlobalHeroWrapper
        htmlId="preorders-hero"
        title="Preventas"
        subtitle="Figuras en campaña con cupos y abonos."
        compact={true}
        inheritedBackground={true}
        hideArchitecturalLines={true}
      />
    </div>
  </div>

  <Section variant="black" fullWidth={true}>
    <div
      id="preorder-marketplace"
      class="px-4 sm:px-6 md:px-8 lg:px-6 xl:px-20 2xl:px-32"
    >
      <div
        class="flex w-full flex-col gap-6 pt-4 md:gap-8 md:pt-6 lg:flex-row lg:pt-8 xl:gap-10 2xl:gap-12"
      >
        <div class="w-full lg:w-[280px] lg:flex-shrink-0">
          <PreorderFilters
            currentFilters={currentFilters}
            collections={collections}
            characters={characters}
          />
        </div>

        <main class="flex min-w-0 flex-1 flex-col xl:px-20">
          {
            currentFilters.q && (
              <div class="mb-5 flex flex-wrap items-center gap-3 md:mb-6">
                <p class="text-sm text-zinc-400">
                  Resultados para{" "}
                  <span class="font-semibold text-white">“{currentFilters.q}”</span>
                </p>
                <a
                  href={clearQueryHref}
                  data-preorder-filter-link
                  class="text-xs font-semibold text-zinc-500 transition-colors hover:text-white"
                >
                  Limpiar búsqueda
                </a>
              </div>
            )
          }

          <CatalogResults
            catalogResult={catalogResult}
            products={products}
            getPageUrl={getPageUrl}
            emptyTitle="No encontramos preventas"
            emptyDescription="Prueba con otra búsqueda o limpia los filtros activos."
            resetHref="/preorders"
          />
        </main>
      </div>
    </div>
  </Section>

  <script src="../../scripts/preorderFilters.ts"></script>
</MainLayout>
