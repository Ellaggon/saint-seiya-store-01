---
import MainLayout from "../../layouts/MainLayout.astro";
import type { PreorderDetailDTO } from "@/application/dto/preorder.dto";
import PreorderAvailabilityMeter from "../../components/preorders/PreorderAvailabilityMeter.astro";
import PreorderBadge from "../../components/preorders/PreorderBadge.astro";
import PreorderCTA from "../../components/preorders/PreorderCTA.astro";
import PreorderEta from "../../components/preorders/PreorderEta.astro";
import PreorderPriceSummary from "../../components/preorders/PreorderPriceSummary.astro";
import ProductPurchaseCTA from "../../components/product/ProductPurchaseCTA.astro";
import { formatPrice } from "@/lib/utils";
import { resolveDisplayAvailability } from "@/shared/catalog/displayAvailability";
import { siteOrigin } from "@/lib/siteUrl";

interface Props {
  product: {
    id: string;
    name: string;
    description: string;
    price: number;
    categoryId: string;
    collectionId: string;
    height: number;
    material: string;
    imageUrl: string;
    stock: number;
    status: string;
    line?: string;
    character?: string;
    category?: string;
    characters?: string[];
  } | null;
  preorder?: PreorderDetailDTO | null;
}

const { product, preorder = null } = Astro.props;
const preorderIsSoldOut = preorder
  ? preorder.availability.availableUnits <= 0 || preorder.availability.isSoldOut
  : false;
const preorderIsOpen = preorder ? preorder.campaign.isOpen : false;
const displayAvailability = product
  ? resolveDisplayAvailability({
      status: product.status,
      stock: product.stock,
      preorder: preorder
        ? {
            isOpen: preorderIsOpen,
            availableUnits: preorder.availability.availableUnits,
          }
        : null,
    })
  : null;
const canonicalUrl = product ? new URL(`/product/${product.id}`, siteOrigin) : null;
const productDescription = product
  ? `${product.name} - ${displayAvailability?.label ?? "Producto"} en Saint Seiya Store. Precio ${formatPrice(product.price)}.`
  : "Producto no encontrado en Saint Seiya Store.";
const productStructuredData =
  product && displayAvailability && canonicalUrl
    ? {
        "@context": "https://schema.org",
        "@type": "Product",
        name: product.name,
        description: product.description,
        image: product.imageUrl ? [product.imageUrl] : undefined,
        sku: product.id,
        brand: {
          "@type": "Brand",
          name: "Saint Seiya Store",
        },
        category: product.category,
        offers: {
          "@type": "Offer",
          url: canonicalUrl.toString(),
          priceCurrency: "BOB",
          price: product.price,
          availability: displayAvailability.schemaAvailability,
          itemCondition: "https://schema.org/NewCondition",
          availabilityStarts:
            preorder?.campaign.opensAt ||
            preorder?.eta.releaseDate ||
            preorder?.eta.etaStart ||
            undefined,
        },
      }
    : undefined;
const availabilityBadgeClass = displayAvailability?.canPurchase
  ? "bg-emerald-400/10 text-emerald-300"
  : "bg-zinc-900/80 text-zinc-400";
const availabilityDotClass = displayAvailability?.canPurchase
  ? "bg-emerald-400 shadow-[0_0_14px_rgba(52,211,153,0.8)]"
  : "bg-zinc-500";
const charactersLabel =
  product && product.characters && product.characters.length > 0
    ? product.characters.join(", ")
    : product?.character || "N/A";
---

<MainLayout
  title={product ? `${product.name} | Detalle de producto` : "Producto | Detalle"}
  description={productDescription}
  structuredData={productStructuredData}
>
  <main class="min-h-screen bg-black">
    {
      product ? (
        <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-12 px-4 pb-20 pt-24 md:px-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(420px,0.7fr)] lg:gap-16 lg:pt-28 2xl:px-10">
          <div class="lg:sticky lg:top-28 lg:self-start">
            <div class="relative overflow-hidden rounded-md bg-zinc-950/70">
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_12%,rgba(245,158,11,0.12),transparent_34%)]">
              </div>
              <img
                src={product.imageUrl}
                alt={product.name}
                class="relative z-10 h-full min-h-[420px] w-full object-cover md:min-h-[620px]"
                loading="eager"
              />
              <div class="absolute inset-x-0 bottom-0 z-20 h-28 bg-gradient-to-t from-black/70 to-transparent">
              </div>
            </div>
          </div>

          <div class="flex flex-col gap-9 lg:py-6">
            <section class="space-y-7">
              <div class="flex flex-wrap items-center gap-3">
                <span
                  class={`inline-flex items-center gap-2 rounded-md px-3 py-2 text-[10px] font-black uppercase tracking-[0.18em] ${availabilityBadgeClass}`}
                >
                  <span
                    class={`h-1.5 w-1.5 rounded-full ${availabilityDotClass}`}
                    aria-hidden="true"
                  >
                  </span>
                  {displayAvailability?.label}
                </span>
                {product.category && (
                  <span class="rounded-md bg-zinc-950 px-3 py-2 text-[10px] font-black uppercase tracking-[0.18em] text-zinc-500">
                    {product.category}
                  </span>
                )}
              </div>

              <div class="space-y-5">
                <p class="text-[10px] font-black uppercase tracking-[0.32em] text-amber-500">
                  Sanctuary Archive
                </p>
                <h1 class="text-4xl font-black uppercase leading-[0.95] tracking-tight text-white md:text-6xl">
                {product.name}
                </h1>
              </div>

              <p class="max-w-2xl text-base leading-8 text-zinc-400">
                {product.description}
              </p>

            </section>

            <section class="rounded-2xl bg-zinc-950/60 p-5 md:p-6">
              <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
                <div class="space-y-1">
                  <p class="text-[10px] font-black uppercase tracking-[0.24em] text-zinc-600">
                    Precio
                  </p>
                  <p class="text-4xl font-black tracking-tight text-white">
                    {formatPrice(product.price)}
                  </p>
                </div>
                <span class="inline-flex w-fit items-center rounded-md bg-amber-500 px-5 py-3 text-[11px] font-black uppercase tracking-[0.16em] text-black">
                  {displayAvailability?.canPurchase ? "Disponible" : displayAvailability?.label}
                </span>
              </div>

              <dl class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-2">
                {[
                  ["Colección", product.line ?? "No especificada"],
                  ["Personajes", charactersLabel === "N/A" ? "No especificado" : charactersLabel],
                  ["Altura", `${product.height} cm`],
                  ["Material", product.material || "No especificado"],
                ].map(([label, value]) => (
                  <div class="rounded-xl bg-black/35 px-4 py-4">
                    <dt class="text-[9px] font-black uppercase tracking-[0.22em] text-zinc-600">
                      {label}
                    </dt>
                    <dd class="mt-2 text-sm font-semibold leading-6 text-zinc-100">
                      {value}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>

            <ProductPurchaseCTA
              productId={product.id}
              productName={product.name}
              price={product.price}
              imageUrl={product.imageUrl}
              stock={product.stock}
              canPurchase={Boolean(displayAvailability?.canPurchase)}
              availabilityLabel={displayAvailability?.label ?? "No disponible"}
            />

            {
              preorder && (
                <section class="space-y-5 rounded-md bg-zinc-950/70 px-5 py-5">
                  <div class="flex items-center justify-between gap-4">
                    <div class="flex flex-col gap-2">
                      <span class="text-zinc-500 text-[9px] font-black uppercase tracking-[0.3em]">
                        Campaña de preventa
                      </span>
                      <h2 class="text-white text-sm font-black uppercase tracking-widest">
                        Reserva disponible
                      </h2>
                    </div>
                    <PreorderBadge
                      isOpen={preorderIsOpen}
                      isSoldOut={preorderIsSoldOut}
                    />
                  </div>

                  <PreorderEta etaLabel={preorder.eta.etaLabel || preorder.eta.etaStart} />

                  <PreorderAvailabilityMeter
                    availableUnits={preorder.availability.availableUnits}
                    totalUnits={preorder.availability.totalSlots}
                  />

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div class="rounded-md bg-black/70 px-4 py-4">
                      <PreorderPriceSummary
                        depositAmount={preorder.pricing.depositRequired}
                      />
                    </div>
                    <div class="rounded-md bg-black/70 px-4 py-4">
                      <div class="flex items-center justify-between gap-3">
                        <span class="text-zinc-500 text-[9px] font-black uppercase tracking-[0.2em]">
                          Precio total
                        </span>
                        <span class="text-amber-500 text-xs font-black uppercase tracking-widest">
                          {formatPrice(preorder.pricing.totalAmount)}
                        </span>
                      </div>
                    </div>
                  </div>

                  {
                    preorder.terms && (
                      <p class="text-zinc-500 text-[10px] uppercase tracking-widest leading-relaxed">
                        {preorder.terms}
                      </p>
                    )
                  }

                  <PreorderCTA
                    isOpen={preorderIsOpen}
                    isSoldOut={preorderIsSoldOut}
                    productId={product.id}
                    campaignId={preorder.campaign.id}
                  />

                  <div
                    id="preorder-reserve-panel"
                    class="hidden space-y-3 border border-zinc-900 bg-black px-4 py-4"
                    data-campaign-id={preorder.campaign.id}
                    data-allow-full={preorder.campaign.allowFullPayment ? "true" : "false"}
                  >
                    <p class="text-[10px] font-black uppercase tracking-widest text-amber-500">
                      Confirmar reserva
                    </p>
                    <label class="block space-y-2">
                      <span class="text-[10px] uppercase tracking-widest text-zinc-600">
                        Cantidad
                      </span>
                      <input
                        id="preorder-qty"
                        type="number"
                        min="1"
                        value="1"
                        class="w-full border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-white"
                      />
                    </label>
                    <label class="block space-y-2">
                      <span class="text-[10px] uppercase tracking-widest text-zinc-600">
                        Modo de pago
                      </span>
                      <select
                        id="preorder-mode"
                        class="w-full border border-zinc-800 bg-zinc-950 px-3 py-2 text-sm text-white"
                      >
                        <option value="DEPOSIT">Abono / depósito</option>
                        {preorder.campaign.allowFullPayment && (
                          <option value="FULL">Pago total</option>
                        )}
                      </select>
                    </label>
                    <p
                      id="preorder-reserve-error"
                      class="hidden text-[10px] font-black uppercase tracking-widest text-red-400"
                    ></p>
                    <button
                      type="button"
                      id="preorder-reserve-submit"
                      class="w-full bg-amber-500 py-3 text-[10px] font-black uppercase tracking-widest text-black hover:bg-white"
                    >
                      Reservar y pagar con QR
                    </button>
                  </div>

                  <p class="text-zinc-600 text-[9px] uppercase tracking-[0.2em]">
                    Debes iniciar sesión para reservar. Luego pagas con QR bancario y subes el comprobante.
                  </p>
                </section>
              )
            }
          </div>
        </div>
      ) : (
        <div class="max-w-[1280px] mx-auto px-4 py-20">
          <div class="rounded-md bg-zinc-950 px-8 py-12">
            <h1 class="text-white text-xl font-black uppercase tracking-widest">
              Producto no encontrado
            </h1>
            <p class="text-zinc-500 text-xs uppercase tracking-widest mt-4">
              El producto solicitado no existe o no está disponible.
            </p>
          </div>
        </div>
      )
    }
  </main>
</MainLayout>

{
  product && preorder && preorderIsOpen && !preorderIsSoldOut && (
    <script>
      const openBtn = document.getElementById("preorder-cta-open");
      const panel = document.getElementById("preorder-reserve-panel");
      const submitBtn = document.getElementById("preorder-reserve-submit");
      const errorEl = document.getElementById("preorder-reserve-error");

      openBtn?.addEventListener("click", () => {
        panel?.classList.remove("hidden");
        openBtn.classList.add("hidden");
      });

      submitBtn?.addEventListener("click", async () => {
        if (!panel || !submitBtn) return;
        const campaignId = panel.dataset.campaignId;
        if (!campaignId) return;

        const qtyInput = document.getElementById(
          "preorder-qty",
        ) as HTMLInputElement | null;
        const modeSelect = document.getElementById(
          "preorder-mode",
        ) as HTMLSelectElement | null;
        const quantity = Math.max(1, Number(qtyInput?.value || 1));
        const paymentMode = modeSelect?.value === "FULL" ? "FULL" : "DEPOSIT";

        submitBtn.disabled = true;
        submitBtn.textContent = "Reservando…";
        errorEl?.classList.add("hidden");

        try {
          const res = await fetch(`/api/preorders/${campaignId}/reserve`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            credentials: "same-origin",
            body: JSON.stringify({ quantity, paymentMode }),
          });
          const json = (await res.json().catch(() => null)) as {
            data?: { reservation?: { id: string } };
            error?: { message?: string; code?: string };
          } | null;

          if (res.status === 401) {
            window.location.href = `/login?returnTo=${encodeURIComponent(window.location.pathname)}`;
            return;
          }

          if (!res.ok || !json?.data?.reservation?.id) {
            throw new Error(
              json?.error?.message || "No se pudo crear la reserva",
            );
          }

          window.location.href = `/preorders/reservations/${json.data.reservation.id}/pay`;
        } catch (error) {
          if (errorEl) {
            errorEl.textContent =
              error instanceof Error ? error.message : "Error al reservar";
            errorEl.classList.remove("hidden");
          }
          submitBtn.disabled = false;
          submitBtn.textContent = "Reservar y pagar con QR";
        }
      });
    </script>
  )
}
