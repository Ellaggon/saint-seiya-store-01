{
  "version": 2,
  "buildCommand": "npm run db:migrate:status && npm run build",
  "installCommand": "npm install",
  "framework": "astro",
  "regions": ["gru1"],
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/internal/preorders/expire-pending",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/internal/cache/warm-catalog",
      "schedule": "0 5 * * *"
    }
  ]
}
